    instruction: "Implement themed styling rules in HomeView components to support dark, mint, and light modes dynamically"
    replacement_infos {
      original_chunk {
        target_content: "      {/* 2. Notice Board rolling marquee */}\n      <div className=\"mt-3 bg-[#13141f] border border-white/5 rounded-xl px-3.5 py-2.5 flex items-center justify-between\" id=\"notice-board\">\n        <div className=\"flex items-center space-x-2.5 flex-1 min-w-0\">\n          <Volume2 className=\"w-4 h-4 text-rose-500 shrink-0\" />\n          <div className=\"overflow-hidden h-4.5 relative flex-1\">\n            <AnimatePresence mode=\"wait\">\n              <motion.span\n                key={noticeIndex}\n                initial={{ y: 15, opacity: 0 }}\n                animate={{ y: 0, opacity: 1 }}\n                exit={{ y: -15, opacity: 0 }}\n                className=\"text-xs text-zinc-200 font-bold block truncate leading-relaxed font-sans pr-4\"\n              >\n                {MOCK_NOTICES[noticeIndex]}\n              </motion.span>\n            </AnimatePresence>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Class Quick Action Navigator Grid */}\n      <div className=\"grid grid-cols-3 gap-3 mt-4\" id=\"home-shortcuts\">\n        <button\n          onClick={() => onSuggestTab(\'schedule\')}\n          className=\"bg-[#13141f] hover:bg-[#1a1b2a] p-3.5 rounded-2xl border border-white/5 text-center transition-all flex flex-col items-center justify-center cursor-pointer group hover:-translate-y-0.5 active:translate-y-0\"\n        >\n          <div className=\"w-10 h-10 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center mb-2 group-hover:scale-105 transition-transform\">\n            <Award className=\"w-5 h-5 text-rose-400\" />\n          </div>\n          <span className=\"text-xs font-black text-zinc-100\">\351\242\204\347\272\246\346\216\222\350\257\276</span>\n          <span className=\"text-[8px] text-zinc-500 font-extrabold mt-1\">\346\257\217\346\227\245\347\262\276\345\223\201\345\244\247\350\257\276</span>\n        </button>\n\n        <button\n          onClick={() => onSuggestTab(\'store\')}\n          className=\"bg-[#13141f] hover:bg-[#1a1b2a] p-3.5 rounded-2xl border border-white/5 text-center transition-all flex flex-col items-center justify-center cursor-pointer group hover:-translate-y-0.5 active:translate-y-0\"\n        >\n          <div className=\"w-10 h-10 rounded-xl bg-violet-500/10 text-violet-400 flex items-center justify-center mb-2 group-hover:scale-105 transition-transform\">\n            <Flame className=\"w-5 h-5 text-violet-400\" />\n          </div>\n          <span className=\"text-xs font-black text-zinc-100\">\347\211\271\346\203\240\345\225\206\345\237\216</span>\n          <span className=\"text-[8px] text-zinc-500 font-extrabold mt-1\">\350\266\205\345\200\274\346\254\241\345\215\241\351\200\232\345\215\241</span>\n        </button>\n\n        <button\n          onClick={() => onSuggestTab(\'profile\')}\n          className=\"bg-[#13141f] hover:bg-[#1a1b2a] p-3.5 rounded-2xl border border-white/5 text-center transition-all flex flex-col items-center justify-center cursor-pointer group hover:-translate-y-0.5 active:translate-y-0\"\n        >\n          <div className=\"w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center mb-2 group-hover:scale-105 transition-transform\">\n            <Play className=\"w-5 h-5 text-amber-450\" />\n          </div>\n          <span className=\"text-xs font-black text-zinc-100\">\346\210\221\347\232\204\350\257\276\350\241\250</span>\n          <span className=\"text-[8px] text-zinc-500 font-extrabold mt-1\">\345\211\251\344\275\231\350\257\276\347\202\271\350\277\233\345\272\246</span>\n        </button>\n      </div>\n\n      {/* 4. Popular Instructors Section */}\n      <div className=\"mt-5\" id=\"home-teachers-list\">\n        <div className=\"flex items-center justify-between mb-2 px-1\">\n          <h3 className=\"text-xs font-extrabold text-zinc-400 uppercase tracking-widest flex items-center\">\n            <Star className=\"w-3.5 h-3.5 text-rose-500 mr-1.5 fill-rose-500\" />\n            \346\230\216\346\230\237\350\210\236\350\200\205\345\257\274\345\270\210 / TEAM\n          </h3>\n          <span className=\"text-[9px] text-[#8e9bb0] font-black\">\345\244\264\345\203\217\346\237\245\347\234\213\347\256\200\344\273\213</span>\n        </div>\n\n        {/* Horizontal rolling instructors avatars */}\n        <div className=\"flex space-x-3 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-none\">\n          {TEACHERS.map((teacher) => (\n            <button\n              key={teacher.id}\n              onClick={() => setSelectedTeacher(teacher)}\n              className=\"flex flex-col items-center shrink-0 w-16 group cursor-pointer\"\n            >\n              <div className=\"relative\">\n                <img\n                  src={teacher.avatar}\n                  alt={teacher.name}\n                  className=\"w-12 h-12 rounded-full object-cover border-2 border-[#13141f] ring-2 ring-white/10 group-hover:ring-rose-500 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <span className=\"absolute bottom-0 right-0 bg-rose-500 text-white rounded-full p-0.5 text-[7px] leading-none text-center font-black\">\n                  \342\234\223\n                </span>\n              </div>\n              <span className=\"text-[11px] font-black text-zinc-100 mt-1.5 pb-0.5 truncate max-w-full\">\n                {teacher.name}\n              </span>\n              <span className=\"text-[8px] text-zinc-500 font-bold leading-none truncate max-w-full\">\n                {teacher.tags[0].split(\' \')[0]}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* About PLANA branding message block with Sleek Street aesthetic */}\n      <div className=\"mt-5 p-5 rounded-[24px] bg-gradient-to-br from-[#1b192e] to-[#12111d] border border-white/5 text-white relative overflow-hidden shadow-lg\">\n        {/* Dynamic ambient orb overlay inside */}\n        <div className=\"absolute top-0 right-0 translate-x-1/3 -translate-y-1/3 w-36 h-36 bg-pink-500/10 rounded-full blur-[40px] pointer-events-none\"></div>\n        \n        <div className=\"relative z-10\">\n          <span className=\"bg-rose-500/10 border border-rose-500/30 text-rose-400 px-2.5 py-0.5 rounded-full text-[8px] font-black tracking-widest uppercase mb-2 inline-block\">\n            FEATURED ACADEMY\n          </span>\n          <h4 className=\"font-extrabold text-sm tracking-tight text-white mb-1.5\">\344\270\272\344\273\200\344\271\210\351\200\211\346\213\251 PLANA \350\241\227\350\210\236\345\255\246\351\231\242\357\274\237</h4>\n          <p className=\"text-[10px] text-zinc-400 leading-relaxed font-sans max-w-[92%]\">\n            \344\275\234\344\270\272\351\253\230\347\253\257\350\277\236\351\224\201\350\241\227\350\210\236\346\216\222\350\257\276\346\216\222\345\244\264\346\275\256\347\211\214\357\274\214PLANA \346\261\207\350\201\232\345\205\250\345\233\275\351\241\266\345\260\226\346\210\230\351\230\237\346\240\270\345\277\203\350\210\236\350\200\205\343\200\202\350\246\206\347\233\226 JAZZ (\347\210\265\345\243\253)\343\200\201HIPHOP (\350\241\227\350\210\236)\343\200\201URBAN (\351\203\275\345\270\202\347\274\226\350\210\236)\347\255\211\347\203\255\351\227\250\351\227\250\347\261\273\343\200\202\350\277\231\351\207\214\344\270\215\344\273\205\346\230\257\346\261\227\346\260\264\346\214\245\346\264\222\345\234\260\357\274\214\346\233\264\346\230\257\346\227\266\345\260\232\350\241\227\350\210\236\346\226\207\345\214\226\347\244\276\345\214\272\343\200\202\n          </p>\n          <button\n            onClick={() => {\n              onSuggestTab(\'schedule\');\n              addToast(\'\347\216\260\345\234\250\351\242\204\350\256\242\347\254\254\344\270\200\345\240\202\345\205\215\350\264\271\344\275\223\351\252\214\350\257\276\345\220\247\357\274\201\', \'success\');\n            }}\n            className=\"mt-3.5 px-4_5 py-2 bg-gradient-to-r from-pink-500 to-rose-600 hover:from-pink-600 hover:to-rose-700 text-white rounded-full text-[10px] font-black tracking-wide transition shadow-lg shadow-rose-500/20 cursor-pointer\"\n          >\n            \345\274\200\345\220\257\344\275\223\351\252\214\350\257\276 &rarr;\n          </button>\n        </div>\n      </div>\n\n      {/* 5. Featured wraps feedback videos */}\n      <div className=\"mt-5 pb-4\" id=\"home-featured-videos\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-xs font-extrabold text-zinc-400 uppercase tracking-widest flex items-center\">\n            <Film className=\"w-3.5 h-3.5 text-rose-500 mr-1.5\" />\n            \345\211\215\346\262\277\350\257\276\345\240\202\347\265\220\350\252\262\345\217\215\351\246\210 / Video Showcase\n          </h3>\n          <span className=\"text-[9px] text-zinc-500 font-bold\">\350\247\206\351\242\221\346\225\231\345\255\246</span>\n        </div>\n\n        {/* Video grids cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {MOCK_VIDEOS.map((video) => (\n            <div\n              key={video.id}\n              onClick={() => {\n                setActiveVideoId(video.id);\n                addToast(`\346\255\243\345\234\250\346\213\211\345\217\226\350\257\276\345\240\202\345\217\215\351\246\210\347\237\255\347\211\207: ${video.title}`, \'info\');\n              }}\n              className=\"bg-[#13141f] border border-white/5 rounded-2xl overflow-hidden cursor-pointer group hover:border-[#ed4d8c]/30 transition duration-300\"\n            >\n              {/* Cover cover ratio */}\n              <div className=\"relative h-24 bg-slate-900 overflow-hidden\">\n                <img\n                  src={video.cover}\n                  alt={video.title}\n                  className=\"w-full h-full object-cover opacity-85 group-hover:scale-105 transition-all duration-300\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                  <span className=\"w-8 h-8 rounded-full bg-rose-500/90 flex items-center justify-center text-white scale-95 group-hover:scale-105 transition shadow-lg\">\n                    <Play className=\"w-4 h-4 fill-white ml-0.5\" />\n                  </span>\n                </div>\n                <span className=\"absolute bottom-1 right-1.5 bg-[#0c0d14]/90 text-white text-[8px] px-1.5 py-0.5 rounded-md font-mono font-black\">\n                  {video.duration}\n                </span>\n              </div>\n\n              {/* Title description bar */}\n              <div className=\"p-2 leading-tight\">\n                <p className=\"text-[11px] font-black text-zinc-100 line-clamp-2 h-8 leading-snug\">\n                  {video.title}\n                </p>\n                <div className=\"flex items-center justify-between text-[8px] text-zinc-500 font-black mt-2\">\n                  <span>{video.plays} \346\222\255\346\224\276</span>\n                  <span className=\"flex items-center text-rose-500\">\n                    <Heart className=\"w-2.5 h-2.5 text-rose-500 fill-rose-500 mr-0.5\" />\n                    {video.likes}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ==================== DIALOG POPUP 1: VIDEO SIMULATION MODAL ==================== */}\n      <AnimatePresence>\n        {activeVideoId && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-xs\">\n            <div className=\"bg-[#13141f] rounded-3xl w-full max-w-sm overflow-hidden text-center relative p-6 border border-white/10 shadow-2xl text-white\">\n              <button\n                onClick={() => setActiveVideoId(null)}\n                className=\"absolute top-4_5 right-4_5 text-zinc-400 hover:text-white font-black cursor-pointer text-sm\"\n              >\n                \342\234\225\n              </button>\n\n              <p className=\"text-[9px] text-rose-500 font-extrabold uppercase tracking-widest font-sans\">\n                PLANA CLASS VIDEO PLAYER\n              </p>\n              <h4 className=\"text-xs font-black text-white mt-1.5 mb-4 leading-snug px-3\">\n                {MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.title}\n              </h4>\n\n              {/* Dynamic video simulated display with progress bar */}\n              <div className=\"relative h-44 bg-black rounded-2xl overflow-hidden flex items-center justify-center mb-4 border border-white/5\">\n                <img\n                  src={MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.cover}\n                  alt=\"feedback\"\n                  className=\"w-full h-full object-cover opacity-60 animate-pulse\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex flex-col justify-center items-center\">\n                  <Play className=\"w-12 h-12 text-rose-500 fill-rose-500 animate-ping opacity-75\" />\n                  <span className=\"text-white text-[9px] mt-3 bg-rose-600 px-3 py-1 rounded-full font-black uppercase tracking-widest\">\n                    [ \346\255\243\345\234\250\346\222\255\346\224\276 4K \347\273\223\350\257\276\350\210\236\346\274\224\347\237\255\347\211\207 ]\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"text-[11px] text-zinc-300 text-left bg-white/5 p-3.5 rounded-2xl border border-white/5 space-y-1.5 font-sans\">\n                <div>\342\200\242 \346\227\245\346\234\237: 2026-05-25 \346\225\231\345\255\246\346\262\211\346\267\200\347\247\200</div>\n                <div>\342\200\242 \351\205\215\344\271\220: High tempo bass music remix</div>\n                <div>\342\200\242 \347\274\226\346\216\222: \345\257\274\345\270\210\347\216\260\345\234\272\346\240\271\346\215\256\351\233\266\345\237\272\347\241\200\345\255\246\345\221\230\350\277\233\345\272\246\347\262\276\347\256\200\351\207\215\346\236\204</div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setActiveVideoId(null);\n                  onSuggestTab(\'schedule\');\n                  addToast(\'\345\267\262\345\274\225\345\257\274\350\277\233\345\205\245\351\200\211\350\257\276\350\241\250\357\274\201\', \'success\');\n                }}\n                className=\"mt-4 w-full py-2.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-black rounded-full shadow-lg hover:scale-102 transition duration-200 cursor-pointer\"\n              >\n                \347\253\213\345\215\263\351\242\204\345\256\232\346\234\254\350\211\262\345\257\274\345\270\210\345\244\247\350\257\276\n              </button>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== DIALOG POPUP 2: TEACHER BIO MODAL ==================== */}\n      <AnimatePresence>\n        {selectedTeacher && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide click shut */}\n            <div\n              onClick={() => setSelectedTeacher(null)}\n              className=\"absolute inset-0 bg-black/85 backdrop-blur-xs\"\n            ></div>\n\n            {/* Slider bottom bio info */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className=\"relative bg-[#13141f] rounded-t-[36px] w-[375px] max-h-[85vh] overflow-y-auto p-6 border-t border-white/10 z-10 shadow-2xl text-white\"\n            >\n              <div className=\"w-12 h-1 bg-white/15 rounded-full mx-auto mb-4\"></div>\n\n              {/* Top main profile specs */}\n              <div className=\"flex items-start space-x-4\">\n                <img\n                  src={selectedTeacher.avatar}\n                  alt={selectedTeacher.name}\n                  className=\"w-16 h-16 rounded-full object-cover border-2 border-rose-500\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div>\n                  <h3 className=\"text-sm font-black text-white\">{selectedTeacher.name}</h3>\n                  <div className=\"flex items-center space-x-1.5 text-xs text-zinc-400 mt-1 font-bold\">\n                    <span className=\"text-rose-500 flex items-center font-black\">\n                      \342\230\205 {selectedTeacher.rating.toFixed(1)}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-rose-400 font-extrabold text-[9px] bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 rounded-md\">\351\246\226\346\216\250\345\220\215\345\270\210\345\257\274\345\270\210</span>\n                  </div>\n\n                  {/* Badges tags row */}\n                  <div className=\"flex flex-wrap gap-1 mt-2\">\n                    {selectedTeacher.tags.map((tag, idx) => (\n                      <span\n                        key={idx}\n                        className=\"bg-white/5 text-zinc-300 text-[8px] font-bold px-1.5 py-0.5 rounded-sm border border-white/5\"\n                      >\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Bio summary description paragraphs */}\n              <div className=\"mt-5 space-y-3\">\n                <div>\n                  <h4 className=\"text-[9px] font-black text-zinc-500 uppercase tracking-widest leading-none\">\344\270\252\344\272\272\347\256\200\344\273\213 / Biography</h4>\n                  <p className=\"text-xs text-zinc-300 mt-1.5 leading-relaxed font-medium\">\n                    {selectedTeacher.description}\n                  </p>\n                </div>\n\n                <div>\n                  <h4 className=\"text-[9px] font-black text-zinc-500 uppercase tracking-widest leading-none mt-3\">\344\270\273\346\224\273\351\243\216\346\240\274 / Core Genres</h4>\n                  <p className=\"text-xs text-zinc-300 mt-1.5 font-medium leading-relaxed\">\n                    Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250), Jazz Funk, Commercial Choreo (\351\253\230\347\207\203\345\225\206\344\270\232\347\210\265\345\243\253), Lyrical isolations.\n                  </p>\n                </div>\n\n                <div className=\"bg-white/5 rounded-2xl p-4 border border-white/5 mt-3 space-y-2 font-medium text-xs\">\n                  <div className=\"text-zinc-300 flex justify-between\">\n                    <span>\350\257\276\345\240\202\346\260\233\345\233\264\350\257\204\345\210\206:</span>\n                    <span className=\"font-black text-rose-400\">9.9/10 SUPER FUN</span>\n                  </div>\n                  <div className=\"text-zinc-300 flex justify-between col-span-2\">\n                    <span>\346\234\200\345\217\227\345\226\234\347\210\261\351\243\216\346\240\274:</span>\n                    <span className=\"font-bold text-white\">\345\237\272\347\241\200\347\210\206\345\217\221\351\232\224\347\246\273/Groove</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CTA call action booking */}\n              <div className=\"mt-5 space-y-2.5\">\n                <button\n                  onClick={() => {\n                    setSelectedTeacher(null);\n                    onSuggestTab(\'schedule\');\n                    addToast(`\345\267\262\344\270\272\346\202\250\347\255\233\351\200\211\345\257\274\345\270\210 ${selectedTeacher.name} \347\232\204\350\257\276\347\250\213`, \'info\');\n                  }}\n                  className=\"w-full py-3 bg-gradient-to-r from-pink-500 to-rose-600 hover:from-pink-600 hover:to-rose-700 text-white text-xs font-black rounded-full transition shadow-lg shadow-rose-500/10 flex items-center justify-center space-x-1 cursor-pointer\"\n                >\n                  <span>\344\270\200\351\224\256\346\237\245\350\257\242\350\257\245\345\257\274\345\270\210\346\216\222\350\257\276\350\241\250</span>\n                </button>\n                <button\n                  onClick={() => setSelectedTeacher(null)}\n                  className=\"w-full py-2.5 bg-white/5 hover:bg-white/10 text-zinc-300 text-xs font-black rounded-full transition cursor-pointer border border-white/5\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );"
        replacement_content: "      {/* 2. Notice Board rolling marquee */}\n      <div className={`mt-3 ${noticeBg} rounded-xl px-3.5 py-2.5 flex items-center justify-between transition-colors`} id=\"notice-board\">\n        <div className=\"flex items-center space-x-2.5 flex-1 min-w-0\">\n          <Volume2 className={`w-4 h-4 ${iconColor} shrink-0`} />\n          <div className=\"overflow-hidden h-4.5 relative flex-1\">\n            <AnimatePresence mode=\"wait\">\n              <motion.span\n                key={noticeIndex}\n                initial={{ y: 15, opacity: 0 }}\n                animate={{ y: 0, opacity: 1 }}\n                exit={{ y: -15, opacity: 0 }}\n                className={`text-xs font-bold block truncate leading-relaxed font-sans pr-4 ${noticeTextClass}`}\n              >\n                {MOCK_NOTICES[noticeIndex]}\n              </motion.span>\n            </AnimatePresence>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Class Quick Action Navigator Grid */}\n      <div className=\"grid grid-cols-3 gap-3 mt-4\" id=\"home-shortcuts\">\n        <button\n          onClick={() => onSuggestTab(\'schedule\')}\n          className={`${cardBgClass} hover:-translate-y-0.5 active:translate-y-0 p-3.5 rounded-2xl text-center transition-all flex flex-col items-center justify-center cursor-pointer group`}\n        >\n          <div className={`w-10 h-10 rounded-xl ${isMint ? \'bg-teal-500/10 text-teal-600\' : \'bg-rose-500/10 text-rose-500\'} flex items-center justify-center mb-2 group-hover:scale-105 transition-transform`}>\n            <Award className=\"w-5 h-5\" />\n          </div>\n          <span className={`text-xs font-black ${textWhite}`}>\351\242\204\347\272\246\346\216\222\350\257\276</span>\n          <span className={`text-[8px] font-extrabold mt-1 ${textSecondary}`}>\346\257\217\346\227\245\347\262\276\345\223\201\345\244\247\350\257\276</span>\n        </button>\n\n        <button\n          onClick={() => onSuggestTab(\'store\')}\n          className={`${cardBgClass} hover:-translate-y-0.5 active:translate-y-0 p-3.5 rounded-2xl text-center transition-all flex flex-col items-center justify-center cursor-pointer group`}\n        >\n          <div className={`w-10 h-10 rounded-xl ${isMint ? \'bg-emerald-500/10 text-emerald-600\' : \'bg-violet-500/10 text-violet-500\'} flex items-center justify-center mb-2 group-hover:scale-105 transition-transform`}>\n            <Flame className=\"w-5 h-5\" />\n          </div>\n          <span className={`text-xs font-black ${textWhite}`}>\347\211\271\346\203\240\345\225\206\345\237\216</span>\n          <span className={`text-[8px] font-extrabold mt-1 ${textSecondary}`}>\350\266\205\345\200\274\346\254\241\345\215\241\351\200\232\345\215\241</span>\n        </button>\n\n        <button\n          onClick={() => onSuggestTab(\'profile\')}\n          className={`${cardBgClass} hover:-translate-y-0.5 active:translate-y-0 p-3.5 rounded-2xl text-center transition-all flex flex-col items-center justify-center cursor-pointer group`}\n        >\n          <div className={`w-10 h-10 rounded-xl ${isMint ? \'bg-teal-500/10 text-teal-600\' : \'bg-amber-500/10 text-amber-500\'} flex items-center justify-center mb-2 group-hover:scale-105 transition-transform`}>\n            <Play className=\"w-5 h-5\" />\n          </div>\n          <span className={`text-xs font-black ${textWhite}`}>\346\210\221\347\232\204\350\257\276\350\241\250</span>\n          <span className={`text-[8px] font-extrabold mt-1 ${textSecondary}`}>\345\211\251\344\275\231\350\257\276\347\202\271\350\277\233\345\272\246</span>\n        </button>\n      </div>\n\n      {/* 4. Popular Instructors Section */}\n      <div className=\"mt-5\" id=\"home-teachers-list\">\n        <div className=\"flex items-center justify-between mb-2 px-1\">\n          <h3 className={`text-xs font-extrabold uppercase tracking-widest flex items-center ${isDark ? \'text-zinc-400\' : \'text-slate-700\'}`}>\n            <Star className={`w-3.5 h-3.5 mr-1.5 fill-current ${iconColor}`} />\n            \346\230\216\346\230\237\350\210\236\350\200\205\345\257\274\345\270\210 / TEAM\n          </h3>\n          <span className={`text-[9px] font-black ${textSecondary}`}>\345\244\264\345\203\217\346\237\245\347\234\213\347\256\200\344\273\213</span>\n        </div>\n\n        {/* Horizontal rolling instructors avatars */}\n        <div className=\"flex space-x-3 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-none\">\n          {TEACHERS.map((teacher) => (\n            <button\n              key={teacher.id}\n              onClick={() => setSelectedTeacher(teacher)}\n              className=\"flex flex-col items-center shrink-0 w-16 group cursor-pointer\"\n            >\n              <div className=\"relative\">\n                <img\n                  src={teacher.avatar}\n                  alt={teacher.name}\n                  className={`w-12 h-12 rounded-full object-cover border-2 ${isDark ? \'border-[#13141f]\' : \'border-white\'} ring-2 ring-black/5 group-hover:ring-rose-500 transition-all duration-200`}\n                  referrerPolicy=\"no-referrer\"\n                />\n                <span className={`absolute bottom-0 right-0 ${isMint ? \'bg-teal-600\' : \'bg-rose-500\'} text-white rounded-full p-0.5 text-[7px] leading-none text-center font-black`}>\n                  \342\234\223\n                </span>\n              </div>\n              <span className={`text-[11px] font-black mt-1.5 pb-0.5 truncate max-w-full ${textWhite}`}>\n                {teacher.name}\n              </span>\n              <span className=\"text-[8px] text-zinc-500 font-bold leading-none truncate max-w-full\">\n                {teacher.tags[0].split(\' \')[0]}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* About PLANA branding message block with Sleek Street aesthetic */}\n      <div className={`mt-5 p-5 rounded-[24px] bg-gradient-to-br ${billboardBg} border relative overflow-hidden`}>\n        {/* Dynamic ambient orb overlay inside */}\n        <div className=\"absolute top-0 right-0 translate-x-1/3 -translate-y-1/3 w-36 h-36 bg-pink-500/10 rounded-full blur-[40px] pointer-events-none\"></div>\n        \n        <div className=\"relative z-10\">\n          <span className={`px-2.5 py-0.5 rounded-full text-[8px] font-black tracking-widest uppercase mb-2 inline-block ${\n            isDark ? \'bg-rose-550/10 bg-rose-500/10 border border-rose-500/20 text-rose-455\' : isMint ? \'bg-teal-100 text-teal-800\' : \'bg-rose-100 text-rose-800\'\n          }`}>\n            FEATURED ACADEMY\n          </span>\n          <h4 className={`font-extrabold text-sm tracking-tight mb-1.5 ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\344\270\272\344\273\200\344\271\210\351\200\211\346\213\251 PLANA \350\241\227\350\210\236\345\255\246\351\231\242\357\274\237</h4>\n          <p className={`text-[10px] leading-relaxed font-sans max-w-[92%] ${isDark ? \'text-zinc-400\' : \'text-slate-600\'}`}>\n            \344\275\234\344\270\272\351\253\230\347\253\257\350\277\236\351\224\201\350\241\227\350\210\236\346\216\222\350\257\276\346\216\222\345\244\264\346\275\256\347\211\214\357\274\214PLANA \346\261\207\350\201\232\345\205\250\345\233\275\351\241\266\345\260\226\346\210\230\351\230\237\346\240\270\345\277\203\350\210\236\350\200\205\343\200\202\350\246\206\347\233\226 JAZZ (\347\210\265\345\243\253)\343\200\201HIPHOP (\350\241\227\350\210\236)\343\200\201URBAN (\351\203\275\345\270\202\347\274\226\350\210\236)\347\255\211\347\203\255\351\227\250\351\227\250\347\261\273\343\200\202\350\277\231\351\207\214\344\270\215\344\273\205\346\230\257\346\261\227\346\260\264\346\214\245\346\264\222\345\234\260\357\274\214\346\233\264\346\230\257\346\227\266\345\260\232\350\241\227\350\210\236\346\226\207\345\214\226\347\244\276\345\214\272\343\200\202\n          </p>\n          <button\n            onClick={() => {\n              onSuggestTab(\'schedule\');\n              addToast(\'\347\216\260\345\234\250\351\242\204\350\256\242\347\254\254\344\270\200\345\240\202\345\205\215\350\264\271\344\275\223\351\252\214\350\257\276\345\220\247\357\274\201\', \'success\');\n            }}\n            className={`mt-3.5 px-4_5 py-2 ${billboardBtn} rounded-full text-[10px] font-black tracking-wide transition shadow-md cursor-pointer`}\n          >\n            \345\274\200\345\220\257\344\275\223\351\252\214\350\257\276 &rarr;\n          </button>\n        </div>\n      </div>\n\n      {/* 5. Featured wraps feedback videos */}\n      <div className=\"mt-5 pb-4\" id=\"home-featured-videos\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className={`text-xs font-extrabold uppercase tracking-widest flex items-center ${isDark ? \'text-zinc-400\' : \'text-slate-700\'}`}>\n            <Film className={`w-3.5 h-3.5 mr-1.5 ${iconColor}`} />\n            \345\211\215\346\262\277\350\257\276\345\240\202\347\265\220\350\252\262\345\217\215\351\246\210 / Video Showcase\n          </h3>\n          <span className={`text-[9px] font-bold ${textSecondary}`}>\350\247\206\351\242\221\346\225\231\345\255\246</span>\n        </div>\n\n        {/* Video grids cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {MOCK_VIDEOS.map((video) => (\n            <div\n              key={video.id}\n              onClick={() => {\n                setActiveVideoId(video.id);\n                addToast(`\346\255\243\345\234\250\346\213\211\345\217\226\350\257\276\345\240\202\345\217\215\351\246\210\347\237\255\347\211\207: ${video.title}`, \'info\');\n              }}\n              className={`border rounded-2xl overflow-hidden cursor-pointer group hover:border-[#ed4d8c]/30 transition duration-300 ${cardBgClass}`}\n            >\n              {/* Cover cover ratio */}\n              <div className=\"relative h-24 bg-slate-900 overflow-hidden\">\n                <img\n                  src={video.cover}\n                  alt={video.title}\n                  className=\"w-full h-full object-cover opacity-85 group-hover:scale-105 transition-all duration-300\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                  <span className={`w-8 h-8 rounded-full ${isMint ? \'bg-teal-600\' : \'bg-rose-500\'} flex items-center justify-center text-white scale-95 group-hover:scale-105 transition shadow-lg`}>\n                    <Play className=\"w-4 h-4 fill-white ml-0.5\" />\n                  </span>\n                </div>\n                <span className=\"absolute bottom-1 right-1.5 bg-[#0c0d14]/90 text-white text-[8px] px-1.5 py-0.5 rounded-md font-mono font-black\">\n                  {video.duration}\n                </span>\n              </div>\n\n              {/* Title description bar */}\n              <div className=\"p-2 leading-tight\">\n                <p className={`text-[11px] font-black line-clamp-2 h-8 leading-snug ${textWhite}`}>\n                  {video.title}\n                </p>\n                <div className=\"flex items-center justify-between text-[8px] font-black mt-2\">\n                  <span className={textSecondary}>{video.plays} \346\222\255\346\224\276</span>\n                  <span className={`flex items-center ${highlightText}`}>\n                    <Heart className=\"w-2.5 h-2.5 fill-current mr-0.5\" />\n                    {video.likes}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ==================== DIALOG POPUP 1: VIDEO SIMULATION MODAL ==================== */}\n      <AnimatePresence>\n        {activeVideoId && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-xs\">\n            <div className={`rounded-3xl w-full max-w-sm overflow-hidden text-center relative p-6 border shadow-2xl text-white ${isDark ? \'bg-[#13141f] border-white/10\' : \'bg-white border-black/10\'}`}>\n              <button\n                onClick={() => setActiveVideoId(null)}\n                className={`absolute top-4_5 right-4_5 font-black cursor-pointer text-sm ${isDark ? \'text-zinc-400 hover:text-white\' : \'text-slate-500 hover:text-slate-900\'}`}\n              >\n                \342\234\225\n              </button>\n\n              <p className={`text-[9px] font-extrabold uppercase tracking-widest font-sans ${highlightText}`}>\n                PLANA CLASS VIDEO PLAYER\n              </p>\n              <h4 className={`text-xs font-black mt-1.5 mb-4 leading-snug px-3 ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n                {MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.title}\n              </h4>\n\n              {/* Dynamic video simulated display with progress bar */}\n              <div className=\"relative h-44 bg-black rounded-2xl overflow-hidden flex items-center justify-center mb-4 border border-white/5\">\n                <img\n                  src={MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.cover}\n                  alt=\"feedback\"\n                  className=\"w-full h-full object-cover opacity-60 animate-pulse\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex flex-col justify-center items-center\">\n                  <Play className={`w-12 h-12 fill-current animate-ping opacity-75 ${highlightText}`} />\n                  <span className={`text-white text-[9px] mt-3 px-3 py-1 rounded-full font-black uppercase tracking-widest ${ctaBtnColor}`}>\n                    [ \346\255\243\345\234\250\346\222\255\346\224\276 4K \347\273\223\350\257\276\350\210\236\346\274\224\347\237\255\347\211\207 ]\n                  </span>\n                </div>\n              </div>\n\n              <div className={`text-[11px] text-left p-3.5 rounded-2xl border space-y-1.5 font-sans ${\n                isDark ? \'bg-white/5 border-white/5 text-zinc-300\' : \'bg-slate-50 border-slate-200 text-slate-700\'\n              }`}>\n                <div>\342\200\242 \346\227\245\346\234\237: 2026-05-25 \346\225\231\345\255\246\346\262\211\346\267\200\347\247\200</div>\n                <div>\342\200\242 \351\205\215\344\271\220: High tempo bass music remix</div>\n                <div>\342\200\242 \347\274\226\346\216\222: \345\257\274\345\270\210\347\216\260\345\234\272\346\240\271\346\215\256\351\233\266\345\237\272\347\241\200\345\255\246\345\221\230\350\277\233\345\272\246\347\262\276\347\256\200\351\207\215\346\236\204</div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setActiveVideoId(null);\n                  onSuggestTab(\'schedule\');\n                  addToast(\'\345\267\262\345\274\225\345\257\274\350\277\233\345\205\245\351\200\211\350\257\276\350\241\250\357\274\201\', \'success\');\n                }}\n                className={`mt-4 w-full py-2.5 text-white text-xs font-black rounded-full shadow-lg hover:scale-102 transition duration-200 cursor-pointer ${ctaBtnColor}`}\n              >\n                \347\253\213\345\215\263\351\242\204\345\256\232\346\234\254\350\211\262\345\257\274\345\270\210\345\244\247\350\257\276\n              </button>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== DIALOG POPUP 2: TEACHER BIO MODAL ==================== */}\n      <AnimatePresence>\n        {selectedTeacher && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide click shut */}\n            <div\n              onClick={() => setSelectedTeacher(null)}\n              className=\"absolute inset-0 bg-black/85 backdrop-blur-xs\"\n            ></div>\n\n            {/* Slider bottom bio info */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className={`relative rounded-t-[36px] w-[375px] max-h-[85vh] overflow-y-auto p-6 border-t z-10 shadow-2xl ${\n                isDark ? \'bg-[#13141f] border-white/10 text-white\' : \'bg-white border-slate-200 text-slate-800\'\n              }`}\n            >\n              <div className={`w-12 h-1 rounded-full mx-auto mb-4 ${isDark ? \'bg-white/15\' : \'bg-slate-350\'}`}></div>\n\n              {/* Top main profile specs */}\n              <div className=\"flex items-start space-x-4\">\n                <img\n                  src={selectedTeacher.avatar}\n                  alt={selectedTeacher.name}\n                  className={`w-16 h-16 rounded-full object-cover border-2 ${isMint ? \'border-teal-500\' : \'border-rose-500\'}`}\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div>\n                  <h3 className={`text-sm font-black ${isDark ? \'text-white\' : \'text-slate-900\'}`}>{selectedTeacher.name}</h3>\n                  <div className=\"flex items-center space-x-1.5 text-xs mt-1 font-bold\">\n                    <span className={`flex items-center font-black ${highlightText}`}>\n                      \342\230\205 {selectedTeacher.rating.toFixed(1)}\n                    </span>\n                    <span className={isDark ? \'text-zinc-500\' : \'text-slate-400\'}>\342\200\242</span>\n                    <span className={`font-extrabold text-[9px] px-2 py-0.5 rounded-md ${badgeClass}`}>\351\246\226\346\216\250\345\220\215\345\270\210\345\257\274\345\270\210</span>\n                  </div>\n\n                  {/* Badges tags row */}\n                  <div className=\"flex flex-wrap gap-1 mt-2\">\n                    {selectedTeacher.tags.map((tag, idx) => (\n                      <span\n                        key={idx}\n                        className={`text-[8px] font-bold px-1.5 py-0.5 rounded-sm border ${\n                          isDark ? \'bg-white/5 text-zinc-300 border-white/5\' : \'bg-slate-150 bg-slate-50 text-slate-600 border-slate-200\'\n                        }`}\n                      >\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Bio summary description paragraphs */}\n              <div className=\"mt-5 space-y-3\">\n                <div>\n                  <h4 className=\"text-[9px] font-black uppercase tracking-widest leading-none text-zinc-400\">\344\270\252\344\272\272\347\256\200\344\273\213 / Biography</h4>\n                  <p className={`text-xs mt-1.5 leading-relaxed font-semibold ${isDark ? \'text-zinc-305\' : \'text-slate-700\'}`}>\n                    {selectedTeacher.description}\n                  </p>\n                </div>\n\n                <div>\n                  <h4 className=\"text-[9px] font-black uppercase tracking-widest leading-none mt-3 text-zinc-400\">\344\270\273\346\224\273\351\243\216\346\240\274 / Core Genres</h4>\n                  <p className={`text-xs mt-1.5 font-semibold leading-relaxed ${isDark ? \'text-zinc-305\' : \'text-slate-700\'}`}>\n                    Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250), Jazz Funk, Commercial Choreo (\351\253\230\347\207\203\345\225\206\344\270\232\347\210\265\345\243\253), Lyrical isolations.\n                  </p>\n                </div>\n\n                <div className={`rounded-2xl p-4 border mt-3 space-y-2 font-semibold text-xs ${\n                  isDark ? \'bg-white/5 border-white/5 text-zinc-300\' : \'bg-slate-50 border-slate-200 text-slate-800\'\n                }`}>\n                  <div className=\"flex justify-between\">\n                    <span>\350\257\276\345\240\202\346\260\233\345\233\264\350\257\204\345\210\206:</span>\n                    <span className={`font-black ${highlightText}`}>9.9/10 SUPER FUN</span>\n                  </div>\n                  <div className=\"flex justify-between col-span-2\">\n                    <span>\346\234\200\345\217\227\345\226\234\347\210\261\351\243\216\346\240\274:</span>\n                    <span className={`font-bold ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\345\237\272\347\241\200\347\210\206\345\217\221\351\232\224\347\246\273/Groove</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CTA call action booking */}\n              <div className=\"mt-5 space-y-2.5\">\n                <button\n                  onClick={() => {\n                    setSelectedTeacher(null);\n                    onSuggestTab(\'schedule\');\n                    addToast(`\345\267\262\344\270\272\346\202\250\347\255\233\351\200\211\345\257\274\345\270\210 ${selectedTeacher.name} \347\232\204\350\257\276\347\250\213`, \'info\');\n                  }}\n                  className={`w-full py-3 text-white text-xs font-black rounded-full transition shadow-md flex items-center justify-center space-x-1 cursor-pointer ${billboardBtn}`}\n                >\n                  <span>\344\270\200\351\224\256\346\237\245\350\257\242\350\257\245\345\257\274\345\270\210\346\216\222\350\257\276\350\241\250</span>\n                </button>\n                <button\n                  onClick={() => setSelectedTeacher(null)}\n                  className={`w-full py-2.5 text-xs font-black rounded-full transition cursor-pointer border ${\n                    isDark ? \'bg-white/5 hover:bg-white/10 text-zinc-300 border-white/5\' : \'bg-slate-100 hover:bg-slate-200 text-slate-700 border-slate-200\'\n                  }`}\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
