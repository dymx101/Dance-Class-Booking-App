  file_change {
    absolute_path_uri: "file:///src/components/StoreView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PAYMENT_CARDS } from \'../data\';\nimport { PaymentCard, PurchaseRecord } from \'../types\';\nimport { Sparkles, ShieldCheck, Ticket } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface StoreViewProps {\n  userPasses: number;\n  setUserPasses: React.Dispatch<React.SetStateAction<number>>;\n  purchaseHistory: PurchaseRecord[];\n  setPurchaseHistory: React.Dispatch<React.SetStateAction<PurchaseRecord[]>>;\n  addToast: (msg: string, type: \'success\' | \'info\' | \'error\') => void;\n}\n\nexport default function StoreView({\n  userPasses,\n  setUserPasses,\n  purchaseHistory,\n  setPurchaseHistory,\n  addToast\n}: StoreViewProps) {\n  // Selected Card for the checkout modal popup sheet\n  const [selectedCard, setSelectedCard] = useState<PaymentCard | null>(null);\n\n  // Simulated Coupon Discount State\n  const [selectedCouponCode, setSelectedCouponCode] = useState<\'NEW\' | \'FEST\' | \'NONE\'>(\'NEW\');\n\n  // Selected Pay Method: \'wechat\' | \'alipay\' | \'visa\'\n  const [payMethod, setPayMethod] = useState<\'wechat\' | \'alipay\' | \'visa\'>(\'wechat\');\n\n  // Loading simulation state\n  const [isProcessing, setIsProcessing] = useState<boolean>(false);\n\n  // Return formatted price subtracting coupon discount\n  const getDiscountedPriceAndLabel = (card: PaymentCard) => {\n    let discountVal = 0;\n    let label = \'\346\227\240\344\274\230\346\203\240\';\n\n    if (selectedCouponCode === \'NEW\' && card.price > 40) {\n      discountVal = 15;\n      label = \'\346\226\260\344\272\272\344\270\223\345\261\236\344\274\230\346\203\240 \302\24515 OFF\';\n    } else if (selectedCouponCode === \'FEST\' && card.price > 200) {\n      discountVal = 50;\n      label = \'PLANA\345\272\227\345\272\206\351\200\232\345\215\241\345\210\270 \302\24550 OFF\';\n    }\n\n    const finalPrice = Math.max(1, card.price - discountVal);\n    return { finalPrice, discountVal, label };\n  };\n\n  // Complete Simulated Purchase Flow\n  const handlePaymentConfirm = (card: PaymentCard) => {\n    setIsProcessing(true);\n\n    // Simulate network delay 1.5s\n    setTimeout(() => {\n      const { finalPrice } = getDiscountedPriceAndLabel(card);\n\n      // Create new purchase item\n      const newRecord: PurchaseRecord = {\n        id: `rec_${Date.now()}`,\n        cardId: card.id,\n        cardName: card.title,\n        price: finalPrice,\n        passesAdded: card.passes,\n        date: new Date().toISOString().split(\'T\')[0]\n      };\n\n      // Apply upgrades\n      if (card.passes === -1) {\n        // Unlimited count, let\'s treat this as adding 50 generic passes for mock simulation display\n        setUserPasses((prev) => prev + 50);\n        addToast(`\343\200\220\346\227\240\351\231\220\345\260\212\344\272\253\345\215\241\343\200\221\346\224\257\344\273\230\346\210\220\345\212\237\357\274\201\345\267\262\344\270\272\346\202\250\345\205\221\346\215\24250\346\254\241\351\200\232\345\215\241\345\205\205\345\200\274\347\202\271\357\274\214\345\217\257\345\234\250\346\227\240\351\231\220\346\234\237\345\206\205\344\273\273\346\204\217\351\242\204\347\272\246\344\270\212\350\257\276\343\200\202`, \'success\');\n      } else {\n        setUserPasses((prev) => prev + card.passes);\n        addToast(`\343\200\220${card.title}\343\200\221\345\205\205\345\200\274\346\210\220\345\212\237\357\274\201\345\267\262\345\255\230\345\205\245\346\202\250\347\232\204\350\264\246\346\210\267\343\200\202\345\242\236\345\212\240 ${card.passes} \350\257\276\347\202\271\343\200\202`, \'success\');\n      }\n\n      setPurchaseHistory((prev) => [newRecord, ...prev]);\n      setIsProcessing(false);\n      setSelectedCard(null); // Close Modal\n    }, 1500);\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto px-4 pb-20 pt-4 bg-[#0c0d14]\" id=\"store-view-container\">\n      {/* Studio Banner section */}\n      <div className=\"flex items-center justify-between pb-3 border-b border-white/5 mb-3\">\n        <div>\n          <h2 className=\"text-sm font-black text-white uppercase tracking-wider\">\345\205\205\345\200\274\350\264\255\345\215\241</h2>\n          <p className=\"text-[8px] text-zinc-500 font-bold tracking-widest mt-1\">PLANA DANCE PASSES CENTER</p>\n        </div>\n        <div className=\"text-right flex flex-col items-end\">\n          <span className=\"text-[9px] text-[#8e9bb0] font-black\">\345\217\257\347\224\250\350\257\276\345\205\205\347\202\271</span>\n          <span className=\"text-xs font-mono font-black text-rose-455 text-rose-400 bg-rose-500/10 px-2.5 py-1 rounded-lg leading-none border border-rose-500/20 mt-1 shadow-sm\">\n            {userPasses} \346\254\241\n          </span>\n        </div>\n      </div>\n\n      {/* Promotional Notice box */}\n      <div className=\"mt-3 bg-gradient-to-r from-pink-500/5 to-rose-500/10 border border-rose-500/20 p-4 rounded-2xl flex items-start space-x-2.5 shadow-md\">\n        <Sparkles className=\"w-5 h-5 text-rose-400 shrink-0 mt-0.5\" />\n        <div className=\"text-[11px] text-zinc-300 leading-relaxed font-sans\">\n          <p className=\"font-extrabold text-xs text-white\">\346\226\260\344\274\232\345\221\230\347\211\271\346\203\240\347\246\217\345\210\251\345\244\247\346\224\276\351\200\201 \360\237\216\201</p>\n          <p className=\"text-zinc-400 mt-1 font-medium text-xs leading-relaxed\">\n            \351\246\226\346\254\241\346\263\250\345\206\214\345\215\263\345\217\257\345\234\250\347\273\223\350\264\246\351\241\265\344\272\253\345\217\227\351\246\226\345\215\225 <strong className=\"text-rose-400\">\302\24515 OFF</strong> \347\216\260\351\207\221\347\253\213\345\207\217\346\211\243\345\207\217\343\200\202\345\215\241\345\210\270\345\217\257\344\270\216\345\205\266\344\273\226\344\274\230\346\203\240\347\264\257\345\212\240\357\274\214\346\234\252\347\224\250\345\256\214\345\214\205\346\215\242\345\214\205\351\200\200\357\274\214\346\224\257\346\214\201\351\232\217\346\227\266\345\206\273\347\273\223\343\200\202\n          </p>\n        </div>\n      </div>\n\n      {/* Main cards lists Grid */}\n      <div className=\"mt-5 space-y-4\" id=\"passes-catalog\">\n        <h3 className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest pl-2 border-l-2 border-rose-500\">\n          \350\207\252\344\277\256\345\233\242\350\257\276\346\254\241\345\215\241/\344\274\232\345\221\230\351\200\232\345\215\241 / Memberships Package\n        </h3>\n\n        {PAYMENT_CARDS.map((card) => {\n          const discountLabel = card.originalPrice\n            ? `\347\234\201 \302\245${card.originalPrice - card.price}`\n            : null;\n\n          return (\n            <div\n              key={card.id}\n              className=\"bg-[#13141f] rounded-[24px] border border-white/5 p-4.5 relative overflow-hidden flex flex-col justify-between shadow-lg transition-all duration-300 hover:border-white/10\"\n            >\n              {/* Badge upper-right */}\n              {card.badge && (\n                <span className=\"absolute top-0 right-0 bg-rose-500 text-white font-black text-[8px] px-3.5 py-1 rounded-bl-xl tracking-wider uppercase border-l border-b border-white/5\">\n                  {card.badge}\n                </span>\n              )}\n\n              {/* Card specs top row */}\n              <div>\n                <h4 className=\"font-extrabold text-white text-sm pr-14 leading-tight\">\n                  {card.title}\n                </h4>\n                <p className=\"text-[9px] text-[#8e9bb0] font-mono font-bold mt-1 tracking-tight\">\n                  \346\234\211\346\225\210\346\234\237: {card.validDays} \345\244\251 \342\200\242 {\' \'}\n                  {card.passes === -1 ? \'\344\270\215\351\231\220\346\234\237/\344\270\212\350\257\276\346\254\241\346\225\260\351\231\220\345\210\266\' : `\345\244\247\350\257\276\345\205\261 ${card.passes} \350\257\276\346\227\266`}\n                </p>\n                <p className=\"text-[11px] text-zinc-400 mt-2 leading-relaxed font-sans font-medium\">\n                  {card.description}\n                </p>\n              </div>\n\n              {/* Price elements & Purchase trigger controls */}\n              <div className=\"mt-4 pt-3.5 border-t border-dashed border-white/5 flex items-center justify-between\">\n                <div className=\"flex items-baseline space-x-1 font-mono\">\n                  <span className=\"text-[10px] font-black text-zinc-500\">\302\245</span>\n                  <span className=\"text-xl font-black text-white leading-none\">\n                    {card.price}\n                  </span>\n\n                  {card.originalPrice && (\n                    <span className=\"text-xs text-zinc-600 font-bold line-through ml-1.5\">\n                      \302\245{card.originalPrice}\n                    </span>\n                  )}\n\n                  {discountLabel && (\n                    <span className=\"bg-rose-500/10 border border-rose-500/20 text-rose-400 text-[8px] font-black px-1.5 py-0.5 rounded ml-2.5 leading-none\">\n                      {discountLabel}\n                    </span>\n                  )}\n                </div>\n\n                <button\n                  onClick={() => setSelectedCard(card)}\n                  className=\"bg-white hover:bg-zinc-100 text-[#0c0d14] font-black text-xs px-5 py-2.5 rounded-full cursor-pointer hover:scale-103 active:scale-95 transition-all shadow-lg\"\n                >\n                  \345\216\273\345\205\205\345\200\274\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Safety notes details */}\n      <div className=\"mt-6 p-4 rounded-[24px] bg-[#181926] text-[#cbd5e1] border border-white/5 flex items-start space-x-3.5 shadow-lg\" id=\"store-faq\">\n        <ShieldCheck className=\"w-5 h-5 text-rose-455 text-rose-400 shrink-0 mt-0.5\" />\n        <div className=\"text-[10px] leading-relaxed space-y-1\">\n          <p className=\"font-extrabold text-xs text-white\">PLANA \350\264\255\350\257\276\345\256\211\345\205\250\344\277\235\351\232\234\347\273\206\345\210\231</p>\n          <p className=\"text-zinc-400 font-medium\">\342\200\242 7\345\244\251\351\200\200\345\214\205\344\277\235\351\232\234: \346\226\260\345\215\241\350\207\252\350\264\255\345\214\205\350\265\2677\345\244\251\345\206\205\357\274\214\350\213\245\346\234\252\350\277\233\350\241\214\344\273\273\344\275\225\345\244\247\350\257\276\351\242\204\350\256\242\346\266\210\350\257\276\357\274\214\345\235\207\345\217\257\346\227\240\345\201\277\345\220\221\345\256\242\346\234\215\347\224\263\350\257\267\347\247\222\347\272\247\351\200\200\346\254\276\346\254\276\351\241\271\343\200\202</p>\n          <p className=\"text-zinc-400 font-medium\">\342\200\242 \350\207\252\345\212\250\345\206\273\347\273\223\345\273\266\346\234\237: \347\224\250\346\210\267\350\213\245\351\201\207\347\252\201\345\217\221\347\224\237\347\227\205\343\200\201\345\207\272\345\267\256\357\274\214\345\217\257\345\234\250\344\270\212\350\257\276\345\211\215\345\257\271\345\215\241\345\214\205\347\224\263\350\257\267\344\270\272\346\234\23714\345\244\251\347\232\204\344\270\264\346\227\266\345\206\273\347\273\223\357\274\214\344\277\235\350\257\201\350\257\276\346\254\241\345\244\251\346\225\260\345\273\266\346\234\237\344\270\215\350\242\253\346\211\243\350\200\227\343\200\202</p>\n        </div>\n      </div>\n\n      {/* ==================== SCREEN DIALOG 3: CHECKOUT MODAL ==================== */}\n      <AnimatePresence>\n        {selectedCard && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide hide */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setSelectedCard(null)}\n              className=\"absolute inset-0 bg-black/85 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Content Drawer Box */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className=\"relative bg-[#13141f] rounded-t-[36px] w-[375px] mx-auto overflow-hidden p-6 border-t border-white/10 z-10 shadow-2xl text-white\"\n            >\n              <div className=\"w-12 h-1 bg-white/10 rounded-full mx-auto mb-4\"></div>\n\n              {/* Checkout header specs */}\n              <div className=\"text-center pb-3 border-b border-white/5\">\n                <span className=\"text-[8px] text-rose-500 font-extrabold tracking-widest font-mono\">PLANA SECURE CHECKOUT</span>\n                <h4 className=\"font-black text-white text-sm mt-1\">\347\241\256\350\256\244\350\264\255\345\215\241\351\241\271\347\233\256</h4>\n                <p className=\"text-[8px] text-zinc-500 font-mono mt-1 font-bold\">\350\256\242\345\215\225ID: CHK_0260525_{selectedCard.id}</p>\n              </div>\n\n              {/* Card descriptions listing details */}\n              <div className=\"mt-4 bg-[#181926] rounded-2xl p-4.5 space-y-3.5 border border-white/5\">\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <span className=\"font-extrabold text-white text-xs block\">{selectedCard.title}</span>\n                    <span className=\"text-[9px] text-[#8e9bb0] mt-1.5 block font-bold font-mono\">\n                      \350\257\276\347\202\271\345\242\236\345\212\240: {selectedCard.passes === -1 ? \'\346\227\240\351\231\220\346\254\241\351\200\232\345\215\241\' : `${selectedCard.passes} \346\254\241`} \342\200\242 \346\225\210\346\234\237 {selectedCard.validDays} \345\244\251\n                    </span>\n                  </div>\n                  <span className=\"font-mono text-white font-black text-base\">\302\245{selectedCard.price}</span>\n                </div>\n\n                {/* Simulated Coupon Picker list */}\n                <div className=\"pt-3.5 border-t border-dashed border-white/5\">\n                  <label className=\"text-[10px] font-black text-zinc-400 flex items-center mb-2.5 uppercase tracking-wider\">\n                    <Ticket className=\"w-3 h-3 text-rose-500 mr-1.5\" />\n                    \345\234\250\347\272\277\345\217\257\347\224\250\345\215\241\345\210\270\351\200\211\346\213\251 (Coupons)\n                  </label>\n\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <button\n                      onClick={() => setSelectedCouponCode(\'NEW\')}\n                      className={`p-2 rounded-xl border text-[10px] font-bold flex flex-col items-center justify-center transition-all cursor-pointer ${\n                        selectedCouponCode === \'NEW\'\n                          ? \'border-rose-500 bg-rose-500/10 text-rose-400 scale-102 font-black\'\n                          : \'border-white/5 bg-white/5 text-zinc-400 hover:bg-white/10\'\n                      }`}\n                    >\n                      <span>\346\226\260\344\272\272\345\210\270 \302\24515</span>\n                      <span className=\"text-[7px] text-zinc-500 mt-0.5\">(\351\246\226\347\275\256\345\277\205\346\212\242)</span>\n                    </button>\n                    <button\n                      disabled={selectedCard.price < 200}\n                      onClick={() => setSelectedCouponCode(\'FEST\')}\n                      className={`p-2 rounded-xl border text-[10px] font-bold flex flex-col items-center justify-center transition-all cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed ${\n                        selectedCouponCode === \'FEST\'\n                          ? \'border-rose-500 bg-rose-500/10 text-rose-400 scale-102 font-black\'\n                          : \'border-white/5 bg-white/5 text-zinc-400 hover:bg-white/10\'\n                      }`}\n                    >\n                      <span>\345\272\227\345\272\206\345\210\270 \302\24550</span>\n                      <span className=\"text-[7px] text-zinc-500 mt-0.5\">(\346\273\241200\345\217\257\347\224\250)</span>\n                    </button>\n                    <button\n                      onClick={() => setSelectedCouponCode(\'NONE\')}\n                      className={`p-2 rounded-xl border text-[10px] font-bold flex flex-col items-center justify-center transition-all cursor-pointer ${\n                        selectedCouponCode === \'NONE\'\n                          ? \'border-rose-500 bg-rose-500/10 text-rose-400 scale-102 font-black\'\n                          : \'border-white/5 bg-white/5 text-zinc-300 hover:bg-white/10\'\n                      }`}\n                    >\n                      <span>\344\270\215\347\224\250\345\210\270</span>\n                      <span className=\"text-[7px] text-zinc-500 mt-0.5\">(\345\216\237\344\273\267\347\273\223\347\256\227)</span>\n                    </button>\n                  </div>\n\n                  {/* Pricing breakdown summary */}\n                  <div className=\"mt-4 pt-3.5 border-t border-dashed border-white/5 leading-normal font-sans text-xs text-zinc-400 space-y-1.5\">\n                    <div className=\"flex justify-between\">\n                      <span>\345\215\225\345\223\201\344\273\267\346\240\274:</span>\n                      <span className=\"font-mono text-zinc-200\">\302\245{selectedCard.price}</span>\n                    </div>\n\n                    {getDiscountedPriceAndLabel(selectedCard).discountVal > 0 && (\n                      <div className=\"flex justify-between text-rose-400 font-extrabold\">\n                        <span>\345\215\241\345\210\270\347\253\213\345\207\217:</span>\n                        <span className=\"font-mono\">-\302\245{getDiscountedPriceAndLabel(selectedCard).discountVal}</span>\n                      </div>\n                    )}\n\n                    <div className=\"flex justify-between font-extrabold text-[#f1f5f9] text-xs pt-2 mt-2 border-t border-dashed border-white/5\">\n                      <span>\346\200\273\350\256\241\345\272\224\344\273\230 (Final price):</span>\n                      <span className=\"font-mono text-rose-400 text-sm\">\n                        \302\245{getDiscountedPriceAndLabel(selectedCard).finalPrice}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Pay Protocol Selection */}\n              <div className=\"mt-4\">\n                <span className=\"text-[9px] font-black text-zinc-500 block mb-2 uppercase tracking-widest\">\345\234\250\347\272\277\346\224\257\344\273\230\351\200\232\351\201\223\351\200\211\346\213\251 (Payments)</span>\n                <div className=\"grid grid-cols-3 gap-2 font-bold text-white\">\n                  <button\n                    onClick={() => setPayMethod(\'wechat\')}\n                    className={`p-2 rounded-xl border flex flex-col items-center justify-center text-[10px] cursor-pointer transition ${\n                      payMethod === \'wechat\' ? \'border-rose-500 bg-rose-500/10 text-rose-400 font-black\' : \'border-white/5 bg-white/5 text-zinc-400 hover:text-white\'\n                    }`}\n                  >\n                    <span className=\"text-emerald-450 text-emerald-400 font-extrabold mb-0.5\">\345\276\256\344\277\241</span>\n                    <span className=\"text-[7px] text-zinc-500 font-mono\">WeChat Pay</span>\n                  </button>\n                  <button\n                    onClick={() => setPayMethod(\'alipay\')}\n                    className={`p-2 rounded-xl border flex flex-col items-center justify-center text-[10px] cursor-pointer transition ${\n                      payMethod === \'alipay\' ? \'border-rose-500 bg-rose-500/10 text-rose-400 font-black\' : \'border-white/5 bg-white/5 text-zinc-400 hover:text-white\'\n                    }`}\n                  >\n                    <span className=\"text-blue-400 font-extrabold mb-0.5\">\346\224\257\344\273\230\345\256\235</span>\n                    <span className=\"text-[7px] text-zinc-500 font-mono\">Alipay</span>\n                  </button>\n                  <button\n                    onClick={() => setPayMethod(\'visa\')}\n                    className={`p-2 rounded-xl border flex flex-col items-center justify-center text-[10px] cursor-pointer transition ${\n                      payMethod === \'visa\' ? \'border-rose-500 bg-rose-500/10 text-rose-400 font-black\' : \'border-white/5 bg-white/5 text-zinc-400 hover:text-white\'\n                    }`}\n                  >\n                    <span className=\"text-rose-400 font-extrabold mb-0.5\">\345\277\253\346\215\267\346\224\257\344\273\230</span>\n                    <span className=\"text-[7px] text-zinc-500 font-mono\">Card Pay</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Confirm submit buttons */}\n              <div className=\"mt-5 space-y-2\">\n                <button\n                  onClick={() => handlePaymentConfirm(selectedCard)}\n                  disabled={isProcessing}\n                  className=\"w-full py-3.5 bg-rose-500 hover:bg-rose-600 disabled:bg-zinc-800 text-white font-black text-xs rounded-full shadow-lg transition duration-200 flex items-center justify-center space-x-1 cursor-pointer\"\n                >\n                  {isProcessing ? (\n                    <>\n                      <div className=\"w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin mr-1.5 animate-pulse\"></div>\n                      <span>\345\256\211\345\205\250\347\275\221\345\205\263\347\273\223\347\256\227\344\270\255...</span>\n                    </>\n                  ) : (\n                    <span>\347\241\256\350\256\244\346\224\257\344\273\230 \302\245{getDiscountedPriceAndLabel(selectedCard).finalPrice}</span>\n                  )}\n                </button>\n                <button\n                  disabled={isProcessing}\n                  onClick={() => setSelectedCard(null)}\n                  className=\"w-full py-2.5 bg-white/5 hover:bg-white/10 text-zinc-300 hover:text-white text-xs font-bold rounded-full transition border border-white/5 cursor-pointer\"\n                >\n                  \350\277\224\345\233\236\351\200\211\345\215\241\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
    }
