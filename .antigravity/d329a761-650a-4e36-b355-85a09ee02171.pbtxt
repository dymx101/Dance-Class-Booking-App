                 <rect x=\"65\" y=\"75\" width=\"4\" height=\"4\" />\n                  {/* Row 9 */}\n                  <rect x=\"30\" y=\"85\" width=\"4\" height=\"4\" />\n                  <rect x=\"40\" y=\"85\" width=\"4\" height=\"4\" />\n                  <rect x=\"50\" y=\"85\" width=\"4\" height=\"4\" />\n                  <rect x=\"60\" y=\"85\" width=\"4\" height=\"4\" className=\"text-emerald-400 fill-emerald-400\" />\n                  <rect x=\"70\" y=\"85\" width=\"4\" height=\"4\" />\n\n                  {/* Standard small alignment pattern */}\n                  <path d=\"M 70 70 L 80 70 L 80 80 L 70 80 Z\" />\n                  <path d=\"M 73 73 L 77 73 L 77 77 L 73 77 Z\" className=\"text-white fill-white\" />\n                  <rect x=\"74\" y=\"74\" width=\"2\" height=\"2\" />\n\n                  {/* Center Brand Logo Indicator inside QR Code */}\n                  <circle cx=\"50\" cy=\"50\" r=\"13\" className=\"text-white fill-white\" />\n                  <circle cx=\"50\" cy=\"50\" r=\"10\" className=\"text-emerald-600 fill-emerald-600\" />\n                  {/* Inner text PA */}\n                  <text x=\"50\" y=\"53.5\" fontSize=\"10\" fontWeight=\"bold\" textAnchor=\"middle\" fill=\"white\" className=\"font-sans font-black\">PA</text>\n                </svg>\n\n                <div className=\"text-[7.5px] font-black text-rose-500 mt-1 uppercase tracking-tighter\">\345\276\256\344\277\241\346\211\253\344\270\200\346\211\253</div>\n              </div>\n\n              <div className=\"flex-1 text-left min-w-0\">\n                <span className=\"text-[10px] font-black uppercase text-zinc-400 tracking-wider block mb-0.5\">\345\276\256\344\277\241\344\270\223\345\261\236\345\256\242\346\234\215 / WECHAT CONTACT</span>\n                <p className={`font-bold ${isDark ? \'text-zinc-300\' : \'text-slate-800\'}`}>\n                  \344\270\223\345\261\236\345\256\242\346\234\215\345\256\242\346\234\215\357\274\232<button onClick={() => {\n                    navigator.clipboard.writeText(\'PLAN_A_STUDIO_514\');\n                    addToast(\'\345\276\256\344\277\241\345\217\267\345\267\262\346\213\267\350\264\235\345\210\260\345\211\252\350\264\264\346\235\277\357\274\214\345\277\253\345\216\273\346\267\273\345\212\240\345\220\247\357\274\201\', \'success\');\n                  }} className={`${highlightText} font-mono font-black border-b border-dashed border-rose-500/40 hover:opacity-85 text-xs focus:outline-none cursor-pointer`}>PLAN_A_STUDIO_514</button>\n                </p>\n                <div className={`text-[10px] leading-relaxed mt-1.5 font-medium space-y-1 ${isDark ? \'text-zinc-400\' : \'text-slate-500\'}`}>\n                  <p>\342\200\242 \351\225\277\346\214\211\343\200\201\346\211\253\346\217\217\346\210\226\347\202\271\345\207\273\345\276\256\344\277\241\345\217\267\345\244\215\345\210\266\357\274\214\345\234\250\345\276\256\344\277\241\345\206\205\346\220\234\347\264\242\346\267\273\345\212\240\346\236\201\351\200\237\347\255\224\347\226\221</p>\n                  <p>\342\200\242 \344\272\253\345\217\227\350\200\203\347\272\247\350\200\203\350\257\201\345\222\250\350\257\242\343\200\201\346\234\200\346\226\260\345\233\242\345\273\272\350\257\276\347\250\213\344\273\267\350\241\250\343\200\201\345\215\241\345\210\270\351\200\200\346\224\271\350\241\245\345\215\241\347\255\211\347\211\271\346\235\203</p>\n                </div>\n              </div>\n            </div>\n\n          </div>\n        </div>\n        \n        {/* Humble copyright footnote */}\n        <div className=\"text-center mt-4 pb-2\">\n          <p className=\"text-[9px] font-bold text-zinc-400 uppercase tracking-widest leading-none\">\n            \302\251 2026 PLAN A DANCE STUDIO. ALL RIGHTS RESERVED.\n          </p>\n          <span className=\"text-[7.5px] font-bold text-zinc-300 mt-1 block\">\347\224\261 \350\217\262\347\211\271\344\272\221 \346\217\220\344\276\233\346\216\222\350\257\276\345\222\21