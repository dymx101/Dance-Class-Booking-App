  file_change {
    absolute_path_uri: "file:///src/components/StoreView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PAYMENT_CARDS } from \'../data\';\nimport { PaymentCard, PurchaseRecord } from \'../types\';\nimport { CreditCard, Sparkles, Check, HelpCircle, ShieldCheck, Ticket, AlertCircle } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface StoreViewProps {\n  userPasses: number;\n  setUserPasses: React.Dispatch<React.SetStateAction<number>>;\n  purchaseHistory: PurchaseRecord[];\n  setPurchaseHistory: React.Dispatch<React.SetStateAction<PurchaseRecord[]>>;\n  addToast: (msg: string, type: \'success\' | \'info\' | \'error\') => void;\n}\n\nexport default function StoreView({\n  userPasses,\n  setUserPasses,\n  purchaseHistory,\n  setPurchaseHistory,\n  addToast\n}: StoreViewProps) {\n  // Selected Card for the checkout modal popup sheet\n  const [selectedCard, setSelectedCard] = useState<PaymentCard | null>(null);\n\n  // Simulated Coupon Discount State\n  const [selectedCouponCode, setSelectedCouponCode] = useState<\'NEW\' | \'FEST\' | \'NONE\'>(\'NEW\');\n\n  // Selected Pay Method: \'wechat\' | \'alipay\' | \'visa\'\n  const [payMethod, setPayMethod] = useState<\'wechat\' | \'alipay\' | \'visa\'>(\'wechat\');\n\n  // Loading simulation state\n  const [isProcessing, setIsProcessing] = useState<boolean>(false);\n\n  // Return formatted price subtracting coupon discount\n  const getDiscountedPriceAndLabel = (card: PaymentCard) => {\n    let discountVal = 0;\n    let label = \'\346\227\240\344\274\230\346\203\240\';\n\n    if (selectedCouponCode === \'NEW\' && card.price > 40) {\n      discountVal = 15;\n      label = \'\346\226\260\344\272\272\344\270\223\345\261\236\344\274\230\346\203\240 \302\24515 OFF\';\n    } else if (selectedCouponCode === \'FEST\' && card.price > 200) {\n      discountVal = 50;\n      label = \'PLANA\345\272\227\345\272\206\351\200\232\345\215\241\345\210\270 \302\24550 OFF\';\n    }\n\n    const finalPrice = Math.max(1, card.price - discountVal);\n    return { finalPrice, discountVal, label };\n  };\n\n  // Complete Simulated Purchase Flow\n  const handlePaymentConfirm = (card: PaymentCard) => {\n    setIsProcessing(true);\n\n    // Simulate network delay 1.5s\n    setTimeout(() => {\n      const { finalPrice } = getDiscountedPriceAndLabel(card);\n\n      // Create new purchase item\n      const newRecord: PurchaseRecord = {\n        id: `rec_${Date.now()}`,\n        cardId: card.id,\n        cardName: card.title,\n        price: finalPrice,\n        passesAdded: card.passes,\n        date: new Date().toISOString().split(\'T\')[0]\n      };\n\n      // Apply upgrades\n      if (card.passes === -1) {\n        // Unlimited count, let\'s treat this as adding 50 generic passes for mock simulation display\n        setUserPasses((prev) => prev + 50);\n        addToast(`\343\200\220\346\227\240\351\231\220\345\260\212\344\272\253\345\215\241\343\200\221\346\224\257\344\273\230\346\210\220\345\212\237\357\274\201\345\267\262\344\270\272\346\202\250\345\205\221\346\215\24250\346\254\241\351\200\232\345\215\241\345\205\205\345\200\274\347\202\271\357\274\214\345\217\257\345\234\250\346\227\240\351\231\220\346\234\237\345\206\205\344\273\273\346\204\217\351\242\204\347\272\246\344\270\212\350\257\276\343\200\202`, \'success\');\n      } else {\n        setUserPasses((prev) => prev + card.passes);\n        addToast(`\343\200\220${card.title}\343\200\221\345\205\205\345\200\274\346\210\220\345\212\237\357\274\201\345\267\262\345\255\230\345\205\245\346\202\250\347\232\204\350\264\246\346\210\267\343\200\202\345\242\236\345\212\240 ${card.passes} \350\257\276\347\202\271\343\200\202`, \'success\');\n      }\n\n      setPurchaseHistory((prev) => [newRecord, ...prev]);\n      setIsProcessing(false);\n      setSelectedCard(null); // Close Modal\n    }, 1500);\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto px-4 pb-20 pt-2 bg-slate-50\" id=\"store-view-container\">\n      {/* Studio Banner section */}\n      <div className=\"flex items-center justify-between py-1 border-b border-slate-100\">\n        <div>\n          <h2 className=\"text-xl font-extrabold text-slate-800 tracking-tight\">\345\205\205\345\200\274\350\264\255\345\215\241</h2>\n          <p className=\"text-[10px] text-slate-400 font-mono\">PLANA PASSES CENTER</p>\n        </div>\n        <div className=\"text-right flex flex-col items-end\">\n          <span className=\"text-[10px] text-slate-400 font-bold\">\346\210\221\347\232\204\345\217\257\347\224\250\350\257\276\347\202\271:</span>\n          <span className=\"text-xs font-mono font-extrabold text-teal-600 bg-teal-50 px-2 py-0.5 rounded-md leading-none border border-teal-100 mt-0.5\">\n            {userPasses} \346\254\241\n          </span>\n        </div>\n      </div>\n\n      {/* Promotional Notice box */}\n      <div className=\"mt-3 bg-teal-50 border border-teal-100 p-3 rounded-2xl flex items-start space-x-2.5\">\n        <Sparkles className=\"w-4.5 h-4.5 text-teal-600 shrink-0 mt-0.5\" />\n        <div className=\"text-[11px] text-teal-800 leading-normal\">\n          <p className=\"font-bold\">\346\226\260\344\274\232\345\221\230\347\246\217\345\210\251\345\244\247\346\224\276\351\200\201 \360\237\216\201</p>\n          <p className=\"font-sans text-teal-700 mt-0.5\">\n            \345\220\215\346\263\250\345\206\214\350\264\246\345\217\267\345\215\263\351\200\201\351\246\226\345\215\225 <strong>\302\24515 OFF</strong> \347\216\260\351\207\221\345\210\270\343\200\202\350\264\255\345\215\241\345\220\216\344\273\273\346\204\217\351\200\232\350\257\276\351\200\232\347\224\250\357\274\214\346\234\252\346\266\210\350\264\271\345\217\257\345\256\236\347\216\260\344\270\200\351\224\256\345\277\253\351\200\237\351\200\200\350\256\242\346\210\226\346\215\242\350\257\276\357\274\201\n          </p>\n        </div>\n      </div>\n\n      {/* Main cards lists Grid */}\n      <div className=\"mt-4 space-y-4\" id=\"passes-catalog\">\n        <h3 className=\"text-xs font-extrabold text-slate-400 uppercase tracking-wider\">\n          \350\207\252\344\277\256\345\233\242\350\257\276\346\254\241\345\215\241/\351\200\232\345\215\241 / Memberships Package\n        </h3>\n\n        {PAYMENT_CARDS.map((card) => {\n          const discountLabel = card.originalPrice\n            ? `\347\234\201 \302\245${card.originalPrice - card.price}`\n            : null;\n\n          return (\n            <div\n              key={card.id}\n              className=\"bg-white rounded-2xl border border-slate-100 p-4 relative overflow-hidden flex flex-col justify-between transition-all duration-300 hover:border-slate-300 hover:shadow-sm\"\n            >\n              {/* Badge upper-right */}\n              {card.badge && (\n                <span className=\"absolute top-0 right-0 bg-teal-500 text-white font-bold text-[9px] px-2.5 py-1 rounded-bl-xl tracking-wider uppercase\">\n                  {card.badge}\n                </span>\n              )}\n\n              {/* Card specs top row */}\n              <div>\n                <h4 className=\"font-extrabold text-slate-800 text-base leading-tight pr-14\">\n                  {card.title}\n                </h4>\n                <p className=\"text-[11px] text-slate-400 font-mono mt-1\">\n                  \346\234\211\346\225\210\346\234\237: {card.validDays} \345\244\251 \342\200\242 {\' \'}\n                  {card.passes === -1 ? \'\344\270\215\351\231\220\344\270\212\350\257\276\346\254\241\346\225\260\' : `\345\214\205\345\220\253\345\244\247\350\257\276\345\205\261 ${card.passes} \350\257\276\346\227\266`}\n                </p>\n                <p className=\"text-xs text-slate-600 mt-2.5 font-sans leading-relaxed\">\n                  {card.description}\n                </p>\n              </div>\n\n              {/* Price elements & Purchase trigger controls */}\n              <div className=\"mt-4 pt-3 border-t border-slate-50 flex items-center justify-between\">\n                <div className=\"flex items-baseline space-x-1.5 font-mono\">\n                  <span className=\"text-[10px] font-bold text-slate-400\">\302\245</span>\n                  <span className=\"text-xl font-extrabold text-teal-600 leading-none\">\n                    {card.price}\n                  </span>\n\n                  {card.originalPrice && (\n                    <span className=\"text-xs text-slate-300 line-through\">\n                      \302\245{card.originalPrice}\n                    </span>\n                  )}\n\n                  {discountLabel && (\n                    <span className=\"bg-rose-50 text-rose-500 font-extrabold text-[9px] px-1.5 py-0.5 rounded-sm ml-1 text-center scale-95 leading-none\">\n                      {discountLabel}\n                    </span>\n                  )}\n                </div>\n\n                <button\n                  onClick={() => setSelectedCard(card)}\n                  className=\"bg-teal-500 hover:bg-teal-600 text-white font-extrabold text-xs px-4 py-2 rounded-xl shadow-xs transition active:scale-95 cursor-pointer\"\n                >\n                  \345\216\273\345\205\205\345\200\274\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Safety notes details */}\n      <div className=\"mt-6 p-4 rounded-2xl bg-white border border-slate-100 flex items-start space-x-3 text-slate-500\" id=\"store-faq\">\n        <ShieldCheck className=\"w-5 h-5 text-teal-500 shrink-0\" />\n        <div className=\"text-[10px] leading-normal space-y-1\">\n          <p className=\"font-bold text-slate-700\">PLANA \350\264\255\350\257\276\345\256\211\345\205\250\344\277\235\351\232\234\347\273\206\345\210\231</p>\n          <p>\342\200\242 7\345\244\251\351\200\200\345\214\205\344\277\235\351\232\234: \346\226\260\345\215\241\350\207\252\350\264\255\345\214\205\350\265\2677\345\244\251\345\206\205\357\274\214\350\213\245\346\234\252\350\277\233\350\241\214\344\273\273\344\275\225\345\244\247\350\257\276\351\242\204\350\256\242\346\266\210\350\257\276\357\274\214\345\235\207\345\217\257\346\227\240\345\201\277\345\220\221\345\256\242\346\234\215\347\224\263\350\257\267\347\247\222\347\272\247\351\200\200\345\233\236\345\216\237\346\234\254\346\254\276\351\241\271\343\200\202</p>\n          <p>\342\200\242 \350\207\252\345\212\250\345\273\266\346\234\237: \347\224\250\346\210\267\350\213\245\351\201\207\347\252\201\345\217\221\347\224\237\347\227\205\343\200\201\345\207\272\345\267\256\357\274\214\345\217\257\345\234\250\343\200\220\346\210\221\347\232\204\343\200\221\344\270\252\344\272\272\344\270\255\345\277\203\345\257\271\345\215\241\347\211\207\347\224\263\350\257\267\344\270\272\346\234\23714\345\244\251\347\232\204\344\270\264\346\227\266\345\206\273\347\273\223\357\274\214\344\277\235\350\257\201\350\257\276\346\254\241\347\246\217\345\210\251\344\270\215\346\265\201\345\244\261\343\200\202</p>\n        </div>\n      </div>\n\n      {/* ==================== SCREEN DIALOG 3: CHECKOUT MODAL ==================== */}\n      <AnimatePresence>\n        {selectedCard && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide hide */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setSelectedCard(null)}\n              className=\"absolute inset-0 bg-black/60 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Content Drawer Box */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className=\"relative bg-white rounded-t-3xl w-full max-w-sm overflow-hidden p-5 border-t border-slate-100 z-10 shadow-2xl\"\n            >\n              <div className=\"w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-4\"></div>\n\n              {/* Checkout header specs */}\n              <div className=\"text-center pb-2 border-b border-slate-100\">\n                <span className=\"text-[10px] text-teal-600 font-extrabold tracking-wider font-mono\">PLANA CASH BAR</span>\n                <h4 className=\"font-extrabold text-slate-800 text-base mt-0.5\">\347\241\256\350\256\244\350\256\242\345\215\225\346\254\276\351\241\271</h4>\n                <p className=\"text-xs text-slate-400 font-mono mt-1\">\350\256\242\345\215\225ID: CHK_0260525_{selectedCard.id}</p>\n              </div>\n\n              {/* Card descriptions listing details */}\n              <div className=\"mt-4 bg-slate-50 rounded-2xl p-4.5 space-y-3 border border-slate-100/50\">\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <span className=\"font-bold text-slate-800 text-sm block\">{selectedCard.title}</span>\n                    <span className=\"text-[10px] text-slate-400 mt-0.5 block font-mono\">\n                      \350\257\276\347\202\271\345\242\236\345\212\240: {selectedCard.passes === -1 ? \'50+\346\254\241\351\200\232\345\215\241\357\274\210\344\274\260\357\274\211\' : `${selectedCard.passes} \346\254\241`} \342\200\242 \346\225\210\346\234\237 {selectedCard.validDays} \345\244\251\n                    </span>\n                  </div>\n                  <span className=\"font-mono text-slate-700 font-bold text-sm\">\302\245{selectedCard.price}</span>\n                </div>\n\n                {/* Simulated Coupon Picker list */}\n                <div className=\"pt-3 border-t border-slate-200/60\">\n                  <label className=\"text-[11px] font-bold text-slate-400 flex items-center mb-1.5\">\n                    <Ticket className=\"w-3.5 h-3.5 text-teal-500 mr-1\" />\n                    \345\217\257\347\224\250\347\211\271\346\203\240\345\210\270\351\200\211\346\213\251 (Coupons)\n                  </label>\n\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <button\n                      onClick={() => setSelectedCouponCode(\'NEW\')}\n                      className={`px-1 py-1.5 rounded-lg border text-[10px] font-extrabold flex flex-col items-center justify-center transition-all ${\n                        selectedCouponCode === \'NEW\'\n                          ? \'border-teal-500 bg-teal-50 text-teal-600\'\n                          : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>\346\226\260\344\272\272\345\210\270 \302\24515</span>\n                      <span className=\"text-[8px] opacity-80 scale-95 mt-0.5\">(\351\246\226\347\275\256\344\270\223\344\272\253)</span>\n                    </button>\n                    <button\n                      disabled={selectedCard.price < 200}\n                      onClick={() => setSelectedCouponCode(\'FEST\')}\n                      className={`px-1 py-1.5 rounded-lg border text-[10px] font-extrabold flex flex-col items-center justify-center transition-all disabled:opacity-30 disabled:cursor-not-allowed ${\n                        selectedCouponCode === \'FEST\'\n                          ? \'border-teal-500 bg-teal-50 text-teal-600\'\n                          : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>\345\272\227\345\272\206\345\210\270 \302\24550</span>\n                      <span className=\"text-[8px] opacity-80 scale-95 mt-0.5\">(\346\273\241200\345\217\257\347\224\250)</span>\n                    </button>\n                    <button\n                      onClick={() => setSelectedCouponCode(\'NONE\')}\n                      className={`px-1 py-1.5 rounded-lg border text-[10px] font-extrabold flex flex-col items-center justify-center transition-all ${\n                        selectedCouponCode === \'NONE\'\n                          ? \'border-teal-500 bg-teal-50 text-teal-600\'\n                          : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>\344\270\215\347\224\250\345\210\270</span>\n                      <span className=\"text-[8px] opacity-80 scale-95 mt-0.5\">(\345\216\237\344\273\267\347\273\223\344\273\230)</span>\n                    </button>\n                  </div>\n\n                  {/* Pricing breakdown summary */}\n                  <div className=\"mt-3.5 pt-3 border-t border-slate-200/60 leading-normal font-sans text-xs text-slate-500 space-y-1.5\">\n                    <div className=\"flex justify-between\">\n                      <span>\345\215\225\345\223\201\344\273\267\346\240\274:</span>\n                      <span className=\"font-mono text-slate-600\">\302\245{selectedCard.price}</span>\n                    </div>\n\n                    {getDiscountedPriceAndLabel(selectedCard).discountVal > 0 && (\n                      <div className=\"flex justify-between text-teal-600 font-medium\">\n                        <span>\345\215\241\345\210\270\345\207\217\345\205\215:</span>\n                        <span className=\"font-mono\">-\302\245{getDiscountedPriceAndLabel(selectedCard).discountVal}</span>\n                      </div>\n                    )}\n\n                    <div className=\"flex justify-between font-bold text-slate-800 text-sm pt-1 border-t border-dashed border-slate-100\">\n                      <span>\345\272\224\344\273\230\351\207\221\351\242\235:</span>\n                      <span className=\"font-mono text-teal-600 text-base\">\n                        \302\245{getDiscountedPriceAndLabel(selectedCard).finalPrice}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Pay Protocol Selection */}\n              <div className=\"mt-4\">\n                <span className=\"text-[11px] font-bold text-slate-400 block mb-2\">\345\234\250\347\272\277\346\224\257\344\273\230\346\270\240\351\201\223\351\200\211\346\213\251</span>\n                <div className=\"grid grid-cols-3 gap-2\">\n                  <button\n                    onClick={() => setPayMethod(\'wechat\')}\n                    className={`p-2.5 rounded-xl border flex flex-col items-center justify-center text-xs font-semibold cursor-pointer ${\n                      payMethod === \'wechat\' ? \'border-teal-500 bg-teal-50/20 text-teal-600\' : \'border-slate-200 hover:bg-slate-50\'\n                    }`}\n                  >\n                    <span className=\"text-emerald-500 text-sm font-bold mb-0.5\">\345\276\256\344\277\241\346\224\257\344\273\230</span>\n                    <span className=\"text-[9px] text-slate-400\">WeChat Pay</span>\n                  </button>\n                  <button\n                    onClick={() => setPayMethod(\'alipay\')}\n                    className={`p-2.5 rounded-xl border flex flex-col items-center justify-center text-xs font-semibold cursor-pointer ${\n                      payMethod === \'alipay\' ? \'border-teal-500 bg-teal-50/20 text-teal-600\' : \'border-slate-200 hover:bg-slate-50\'\n                    }`}\n                  >\n                    <span className=\"text-blue-500 text-sm font-bold mb-0.5\">\346\224\257\344\273\230\345\256\235</span>\n                    <span className=\"text-[9px] text-slate-400\">Alipay</span>\n                  </button>\n                  <button\n                    onClick={() => setPayMethod(\'visa\')}\n                    className={`p-2.5 rounded-xl border flex flex-col items-center justify-center text-xs font-semibold cursor-pointer ${\n                      payMethod === \'visa\' ? \'border-teal-500 bg-teal-50/20 text-teal-600\' : \'border-slate-200 hover:bg-slate-50\'\n                    }`}\n                  >\n                    <span className=\"text-slate-700 text-sm font-bold mb-0.5\">\345\277\253\346\215\267\346\224\257\344\273\230</span>\n                    <span className=\"text-[9px] text-slate-400\">Card Pay</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Confirm submit buttons */}\n              <div className=\"mt-5 space-y-2\">\n                <button\n                  onClick={() => handlePaymentConfirm(selectedCard)}\n                  disabled={isProcessing}\n                  className=\"w-full py-3 bg-teal-500 hover:bg-teal-600 disabled:bg-slate-300 text-white font-extrabold text-xs rounded-xl shadow-md shadow-teal-400/35 transition flex items-center justify-center space-x-1\"\n                >\n                  {isProcessing ? (\n                    <>\n                      <div className=\"w-4.5 h-4.5 rounded-full border-2 border-white border-t-transparent animate-spin mr-1.5\"></div>\n                      <span>\346\255\243\345\234\250\350\260\203\347\224\250\345\256\211\345\205\250\347\275\221\345\205\263\347\273\223\347\256\227\344\270\255...</span>\n                    </>\n                  ) : (\n                    <span>\347\241\256\350\256\244\346\224\257\344\273\230 \302\245{getDiscountedPriceAndLabel(selectedCard).finalPrice}</span>\n                  )}\n                </button>\n                <button\n                  disabled={isProcessing}\n                  onClick={() => setSelectedCard(null)}\n                  className=\"w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold rounded-xl transition\"\n                >\n                  \350\277\224\345\233\236\351\200\211\345\215\241\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
    }
