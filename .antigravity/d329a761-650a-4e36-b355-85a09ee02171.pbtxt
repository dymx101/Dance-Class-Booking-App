 bookedCount: 1,\n    maxCount: 1, // Booked out\n    type: \'private\'\n  }\n];\n\n// Let\'s generate a full list of classes from 2026-05-24 to 2026-06-02\nexport const generateClasses = (): DanceClass[] => {\n  const result: DanceClass[] = [];\n  const dates = [\n    \'2026-05-24\', // Sat\n    \'2026-05-25\', // Sun (today)\n    \'2026-05-26\', // Mon\n    \'2026-05-27\', // Tue\n    \'2026-05-28\', // Wed\n    \'2026-05-29\', // Thu\n    \'2026-05-30\', // Fri\n    \'2026-05-31\', // Sat\n    \'2026-06-01\', // Mon\n    \'2026-06-02\'  // Tue\n  ];\n\n  dates.forEach((dateStr) => {\n    CLASSES_TEMPLATE.forEach((tmpl, i) => {\n      // Modify bookedCount slightly for variety across days\n      let bookedCount = tmpl.bookedCount;\n      if (dateStr > \'2026-05-25\') {\n        bookedCount = Math.floor(Math.random() * (tmpl.maxCount - 1));\n      }\n\n      // Future bookings on May 26/27 onwards might display opening time rules in the screenshots, e.g., \"05\346\234\21024\346\227\245 00:00\345\217\257\347\272\246\"\n      let openBookingTime: string | undefined = undefined;\n      if (dateStr > \'2026-05-27\') {\n        openBookingTime = \'05\346\234\21026\346\227\245 00:00\345\217\257\347\272\246\';\n      }\n\n      result.push({\n        ...tmpl,\n        id: `${tmpl.id}_${dateStr}`,\n        bookedCount,\n        openBookingTime,\n        date: dateStr\n      });\n    });\n  });\n\n  return result;\n};\n\nexport const PAYMENT_CARDS: PaymentCard[] = [\n  {\n    id: \'c1\',\n    title: \'\344\275\223\351\252\214\350\257\276\345\215\225\346\254\241\345\215\241 (Single Pass)\',\n    price: 39,\n    originalPrice: 120,\n    passes: 1,\n    validDays: 15,\n    description: \'\351\231\220\351\246\226\346\254\241\345\210\260\345\272\227\346\226\260\345\255\246\345\221\230\344\275\223\351\252\214\343\200\202\344\273\273\346\204\217\345\233\242\350\257\276\345\205\250\345\234\272\345\217\257\347\224\250\357\274\214\345\274\200\345\220\257\344\275\240\347\232\204\350\2