    replacement_infos {
      original_chunk {
        target_content: "        <div className=\"mt-4 pt-3.5 border-t border-white/5 flex items-center justify-between text-[9px] text-zinc-500 tracking-wide font-bold\" id=\"streak-meter\">\n          <span className=\"flex items-center\">\n            <Flame className=\"w-3.5 h-3.5 text-rose-455 text-rose-400 mr-1 animate-pulse\" />\n            \350\277\236\347\273\255\346\211\247\347\205\247\346\211\223\345\215\241: <strong className=\"text-rose-400 ml-1 font-black\">5 \345\244\251</strong>\n          </span>\n          <span>\350\277\221\346\234\237\345\213\213\347\253\240\347\273\217\351\252\214\347\202\271: 450 / 1000 EXP</span>\n        </div>\n      </div>\n\n      {/* 3. Class Booking Monitor segments tabbed block */}\n      <div className=\"mt-5\" id=\"booking-monitor\">\n        {/* Navigation row selectors */}\n        <div className=\"flex border-b border-white/5 font-black text-xs\">\n          <button\n            onClick={() => setActiveSegment(\'active\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'active\' ? \'text-rose-400 font-black\' : \'text-zinc-500 hover:text-white\'\n            }`}\n          >\n            <span>\345\267\262\351\200\211\350\257\276\347\250\213 ({userBookedClasses.length})</span>\n            {activeSegment === \'active\' && (\n              <span className=\"absolute bottom-[-1px] left-0 right-0 h-[2px] bg-rose-500 rounded-full\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'waiting\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'waiting\' ? \'text-rose-400 font-black\' : \'text-zinc-500 hover:text-white\'\n            }`}\n          >\n            <span>\346\216\222\351\230\237\345\200\231\350\241\245 ({userWaitlistedClasses.length})</span>\n            {activeSegment === \'waiting\' && (\n              <span className=\"absolute bottom-[-1px] left-0 right-0 h-[2px] bg-rose-500 rounded-full\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'purchases\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'purchases\' ? \'text-rose-400 font-black\' : \'text-zinc-500 hover:text-white\'\n            }`}\n          >\n            <span>\344\272\244\346\230\223\346\265\201\346\260\264 ({purchaseHistory.length})</span>\n            {activeSegment === \'purchases\' && (\n              <span className=\"absolute bottom-[-1px] left-0 right-0 h-[2px] bg-rose-500 rounded-full\"></span>\n            )}\n          </button>\n        </div>\n\n        {/* Display contents */}\n        <div className=\"mt-3.5 space-y-3\">\n          {activeSegment === \'active\' && (\n            userBookedClasses.length === 0 ? (\n              <div className=\"text-center bg-[#13141f] p-8 rounded-[24px] border border-white/5 flex flex-col items-center shadow-lg\">\n                <Ticket className=\"w-8 h-8 text-zinc-650 text-zinc-600 mb-2\" />\n                <p className=\"text-xs text-zinc-500 font-bold leading-normal\">\n                  \346\202\250\345\275\223\345\211\215\346\232\202\346\227\240\345\267\262\347\231\273\350\256\260\347\232\204\345\244\247\350\257\276\346\264\273\345\212\250\343\200\202\350\265\266\347\264\247\345\211\215\345\276\200\351\246\226\351\241\265\346\210\226\350\257\276\350\241\250\351\200\211\346\213\251\346\226\260\344\270\200\350\257\276\346\227\266\345\220\247\357\274\201\n                </p>\n              </div>\n            ) : (\n              userBookedClasses.map((cls) => (\n                <div key={cls.id} className=\"bg-[#13141f] border border-white/5 rounded-2xl p-4 flex justify-between items-center shadow-lg\">\n                  <div>\n                    <h4 className=\"text-xs font-black text-white leading-tight\">\n                       {cls.title}\n                    </h4>\n                    <p className=\"text-[10px] text-rose-400 font-bold font-mono mt-1.5\">\n                      {cls.date} \342\200\242 {cls.timeStart}~{cls.timeEnd}\n                    </p>\n                    <p className=\"text-[9px] text-[#8e9bb0] mt-1 font-bold\">\n                      \345\257\274\345\270\210: {cls.teacher.name} \342\200\242 {cls.classroom}\n                    </p>\n                  </div>\n\n                  <button\n                    onClick={() => handleCancelBooking(cls.id, cls.title)}\n                    className=\"px-3.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/20 text-rose-400 active:scale-95 text-[10px] font-bold rounded-full transition cursor-pointer shrink-0\"\n                  >\n                    \345\217\226\346\266\210\351\242\204\347\272\246\n                  </button>\n                </div>\n              ))\n            )\n          )}\n\n          {activeSegment === \'waiting\' && (\n            userWaitlistedClasses.length === 0 ? (\n              <div className=\"text-center bg-[#13141f] p-8 rounded-[24px] border border-white/5 flex flex-col items-center shadow-lg\">\n                <History className=\"w-8 h-8 text-zinc-650 text-zinc-600 mb-2\" />\n                <p className=\"text-xs text-zinc-500 font-bold leading-normal\">\n                  \346\202\250\345\275\223\345\211\215\345\271\266\346\262\241\346\234\211\345\244\204\344\272\216\345\220\215\351\242\235\345\267\262\346\273\241\345\200\231\350\241\245\351\230\266\346\256\265\347\232\204\345\210\206\345\206\214\351\241\271\347\233\256\343\200\202\n                </p>\n              </div>\n            ) : (\n              userWaitlistedClasses.map((cls) => (\n                <div key={cls.id} className=\"bg-[#13141f] border border-white/5 rounded-2xl p-4 flex justify-between items-center shadow-lg\">\n                  <div>\n                    <span className=\"bg-rose-500/10 border border-rose-500/20 text-rose-400 text-[8px] font-black px-2 py-0.5 rounded-full leading-none mr-1.5 inline-block mb-1.5\">\n                      \351\230\237\345\210\227\346\212\242\344\275\215\345\200\231\350\241\245\344\270\255\n                    </span>\n                    <h4 className=\"text-xs font-black text-white leading-tight\">\n                      {cls.title}\n                    </h4>\n                    <p className=\"text-[10px] text-zinc-400 font-bold font-mono mt-1\">\n                      {cls.date} \342\200\242 {cls.timeStart}~{cls.timeEnd}\n                    </p>\n                    <p className=\"text-[9px] text-zinc-500 font-bold mt-1\">\n                      \345\257\274\345\270\210: {cls.teacher.name} \342\200\242 \345\267\262\350\241\214\344\275\2771\347\202\271\345\206\273\347\273\223\351\224\201\345\256\232\346\225\260\n                    </p>\n                  </div>\n\n                  <button\n                    onClick={() => handleCancelWaitlist(cls.id, cls.title)}\n                    className=\"px-3.5 py-1.5 bg-white/5 hover:bg-white/10 border border-white/5 text-zinc-300 active:scale-95 text-[10px] font-bold rounded-full transition cursor-pointer shrink-0\"\n                  >\n                    \345\217\226\346\266\210\345\200\231\350\241\245\n                  </button>\n                </div>\n              ))\n            )\n          )}\n\n          {activeSegment === \'purchases\' && (\n            purchaseHistory.length === 0 ? (\n              <div className=\"text-center bg-[#13141f] p-8 rounded-[24px] border border-white/5 flex flex-col items-center shadow-lg\">\n                <History className=\"w-8 h-8 text-zinc-650 text-zinc-600 mb-2\" />\n                <p className=\"text-xs text-zinc-500 font-bold leading-normal\">\n                  \346\202\250\346\234\200\350\277\221\345\271\266\346\227\240\345\215\241\345\214\205\350\264\255\344\271\260\344\272\244\346\230\223\350\256\260\345\275\225\357\274\214\351\246\226\347\254\224\345\205\205\345\200\274\345\214\205\344\272\253\346\234\211\346\226\260\346\211\213\347\253\213\345\207\217\343\200\202\n                </p>\n              </div>\n            ) : (\n              purchaseHistory.map((rec) => (\n                <div key={rec.id} className=\"bg-[#13141f] border border-white/5 rounded-2xl p-4 flex justify-between items-center font-mono shadow-lg\">\n                  <div>\n                    <h4 className=\"text-xs font-black text-white leading-tight font-sans\">\n                      {rec.cardName}\n                    </h4>\n                    <p className=\"text-[9px] text-zinc-500 mt-1.5 leading-none font-bold\">\n                      \350\264\255\344\271\260\345\256\214\346\210\220: {rec.date} \342\200\242 \346\265\201\346\260\264\347\274\226\345\217\267: {rec.id}\n                    </p>\n                  </div>\n\n                  <div className=\"text-right shrink-0\">\n                    <span className=\"text-xs font-black text-rose-400 block\">\n                      + {rec.passesAdded === -1 ? \'\346\227\240\351\231\220\351\200\232\347\202\271\' : `${rec.passesAdded} \346\254\241`}\n                    </span>\n                    <span className=\"text-[9px] text-zinc-500 block mt-1\">\n                      \344\273\230\346\254\276 \302\245{rec.price}\n                    </span>\n                  </div>\n                </div>\n              ))\n            )\n          )}\n        </div>\n      </div>"
        replacement_content: "        <div className={`mt-4 pt-3.5 border-t flex items-center justify-between text-[9px] tracking-wide font-bold ${isDark ? \'border-white/5 text-zinc-500\' : \'border-slate-200 text-slate-500\'}`} id=\"streak-meter\">\n          <span className=\"flex items-center\">\n            <Flame className={`w-3.5 h-3.5 mr-1 animate-pulse ${iconColor}`} />\n            \350\277\236\347\273\255\346\211\247\347\205\247\346\211\223\345\215\241: <strong className={`ml-1 font-black ${highlightText}`}>5 \345\244\251</strong>\n          </span>\n          <span>\350\277\221\346\234\237\345\213\213\347\253\240\347\273\217\351\252\214\347\202\271: 450 / 1000 EXP</span>\n        </div>\n      </div>\n\n      {/* 3. Class Booking Monitor segments tabbed block */}\n      <div className=\"mt-5\" id=\"booking-monitor\">\n        {/* Navigation row selectors */}\n        <div className={`flex border-b font-black text-xs ${headerBorder}`}>\n          <button\n            onClick={() => setActiveSegment(\'active\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'active\' \n                ? isMint \n                  ? \'text-teal-600 font-extrabold\' \n                  : \'text-rose-500 font-extrabold\' \n                : isDark \n                ? \'text-zinc-500 hover:text-white\' \n                : \'text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            <span>\345\267\262\351\200\211\350\257\276\347\250\213 ({userBookedClasses.length})</span>\n            {activeSegment === \'active\' && (\n              <span className={`absolute bottom-[-1px] left-0 right-0 h-[2px] rounded-full ${isMint ? \'bg-teal-500\' : \'bg-rose-500\'}`}></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'waiting\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'waiting\' \n                ? isMint \n                  ? \'text-teal-600 font-extrabold\' \n                  : \'text-rose-500 font-extrabold\' \n                : isDark \n                ? \'text-zinc-500 hover:text-white\' \n                : \'text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            <span>\346\216\222\351\230\237\345\200\231\350\241\245 ({userWaitlistedClasses.length})</span>\n            {activeSegment === \'waiting\' && (\n              <span className={`absolute bottom-[-1px] left-0 right-0 h-[2px] rounded-full ${isMint ? \'bg-teal-500\' : \'bg-rose-500\'}`}></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'purchases\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'purchases\' \n                ? isMint \n                  ? \'text-teal-605 text-teal-600 font-extrabold\' \n                  : \'text-rose-500 font-extrabold\' \n                : isDark \n                ? \'text-zinc-500 hover:text-white\' \n                : \'text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            <span>\344\272\244\346\230\223\346\265\201\346\260\264 ({purchaseHistory.length})</span>\n            {activeSegment === \'purchases\' && (\n              <span className={`absolute bottom-[-1px] left-0 right-0 h-[2px] rounded-full ${isMint ? \'bg-teal-500\' : \'bg-rose-500\'}`}></span>\n            )}\n          </button>\n        </div>\n\n        {/* Display contents */}\n        <div className=\"mt-3.5 space-y-3\">\n          {activeSegment === \'active\' && (\n            userBookedClasses.length === 0 ? (\n              <div className={`text-center p-8 rounded-[24px] border flex flex-col items-center shadow-lg ${cardBgClass} ${cardBorder}`}>\n                <Ticket className={`w-8 h-8 mb-2 ${isDark ? \'text-zinc-700\' : \'text-slate-30