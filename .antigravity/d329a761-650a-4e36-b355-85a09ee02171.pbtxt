  file_change {
    absolute_path_uri: "file:///src/components/ScheduleView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { DanceClass, Teacher } from \'../types\';\nimport { TEACHERS } from \'../data\';\nimport { Calendar, Filter, ChevronLeft, ChevronRight, CheckCircle2, AlertTriangle, RefreshCw, Layers } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface ScheduleViewProps {\n  classes: DanceClass[];\n  setClasses: React.Dispatch<React.SetStateAction<DanceClass[]>>;\n  userPasses: number;\n  setUserPasses: React.Dispatch<React.SetStateAction<number>>;\n  bookedClassIds: string[];\n  setBookedClassIds: React.Dispatch<React.SetStateAction<string[]>>;\n  waitlistClassIds: string[];\n  setWaitlistClassIds: React.Dispatch<React.SetStateAction<string[]>>;\n  addToast: (msg: string, type: \'success\' | \'info\' | \'error\') => void;\n}\n\nconst WEEK_NAMES = [\'\345\221\250\346\227\245\', \'\345\221\250\344\270\200\', \'\345\221\250\344\272\214\', \'\345\221\250\344\270\211\', \'\345\221\250\345\233\233\', \'\345\221\250\344\272\224\', \'\345\221\250\345\205\255\'];\n\nexport default function ScheduleView({\n  classes,\n  setClasses,\n  userPasses,\n  setUserPasses,\n  bookedClassIds,\n  setBookedClassIds,\n  waitlistClassIds,\n  setWaitlistClassIds,\n  addToast\n}: ScheduleViewProps) {\n  // Current mode: \'day\' (\346\227\245\350\257\276\350\241\250) or \'week\' (\345\221\250\350\257\276\350\241\250)\n  const [viewMode, setViewMode] = useState<\'day\' | \'week\'>(\'day\');\n\n  // Currently selected date for Daily view (Initialized to today: 2026-05-25)\n  const [selectedDateStr, setSelectedDateStr] = useState<string>(\'2026-05-25\');\n\n  // Course type selected: \'group\' (\345\233\242\350\257\276) | \'private\' (\347\247\201\346\225\231) | \'series\' (\347\217\255\350\257\276)\n  const [activeCourseType, setActiveCourseType] = useState<\'group\' | \'private\' | \'series\'>(\'group\');\n\n  // Toggle \"\345\217\257\347\272\246\" (Bookable Only)\n  const [onlyBookable, setOnlyBookable] = useState<boolean>(false);\n\n  // States for Modals\n  const [isCalendarOpen, setIsCalendarOpen] = useState(false);\n  const [isFilterOpen, setIsFilterOpen] = useState(false);\n\n  // Filter conditions\n  const [filterRoom, setFilterRoom] = useState<string>(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n  const [filterTeacherId, setFilterTeacherId] = useState<string>(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n\n  // Temporary filter configurations in drawer\n  const [tempRoom, setTempRoom] = useState<string>(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n  const [tempTeacherId, setTempTeacherId] = useState<string>(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n\n  // Weekly view date range tracker (starts on week of May 25th)\n  // Let\'s create columns for: Mon May 25 to Sun May 31\n  const [currentWeekStart, setCurrentWeekStart] = useState<Date>(new Date(\'2026-05-25\'));\n\n  // Static options for Classrooms based on real classes\n  const classroomsList = [\'\345\205\250\351\203\250\346\225\231\345\256\244\', \'A\346\225\231\345\256\244\', \'B\346\225\231\345\256\244\', \'C\346\225\231\345\256\244\'];\n\n  // Current local simulated time context: 2026-05-25T15:14:25Z\n  const CURRENT_HOUR = 15;\n  const CURRENT_MINUTE = 14;\n\n  // Horizontal date Carousel dates (May 24 to June 2)\n  const CAROUSEL_DATES = useMemo(() => {\n    return [\n      { name: \'\345\221\250\345\205\255\', dateStr: \'2026-05-24\', displayDate: \'24\', isToday: false },\n      { name: \'\345\221\250\346\227\245\', dateStr: \'2026-05-25\', displayDate: \'\344\273\212\', isToday: true },\n      { name: \'\345\221\250\344\270\200\', dateStr: \'2026-05-26\', displayDate: \'26\', isToday: false },\n      { name: \'\345\221\250\344\272\214\', dateStr: \'2026-05-27\', displayDate: \'27\', isToday: false },\n      { name: \'\345\221\250\344\270\211\', dateStr: \'2026-05-28\', displayDate: \'28\', isToday: false },\n      { name: \'\345\221\250\345\233\233\', dateStr: \'2026-05-29\', displayDate: \'29\', isToday: false },\n      { name: \'\345\221\250\344\272\224\', dateStr: \'2026-05-30\', displayDate: \'30\', isToday: false },\n      { name: \'\345\221\250\345\205\255\', dateStr: \'2026-05-31\', displayDate: \'31\', isToday: false },\n      { name: \'\345\221\250\346\227\245\', dateStr: \'2026-06-01\', displayDate: \'01\', isToday: false },\n      { name: \'\345\221\250\344\270\200\', dateStr: \'2026-06-02\', displayDate: \'02\', isToday: false },\n    ];\n  }, []);\n\n  // Filtered classes logic for list\n  const finalFilteredClasses = useMemo(() => {\n    return classes.filter((item) => {\n      // 1. Filter by date in Daily, or search by type\n      if (item.date !== selectedDateStr) return false;\n\n      // 2. Filter by Course type (\345\233\242\350\257\276, \347\247\201\346\225\231, \347\217\255\350\257\276)\n      if (item.type !== activeCourseType) return false;\n\n      // 3. Toggle \"\345\217\257\347\272\246\" (Only Bookable)\n      if (onlyBookable) {\n        // If course is already passed, it is not bookable.\n        const isPassed = isClassPassed(item);\n        if (isPassed) return false;\n\n        // If booking not open yet\n        if (item.openBookingTime) return false;\n\n        // If fully booked & no spots and user is not already booked\n        if (item.bookedCount >= item.maxCount && !bookedClassIds.includes(item.id)) {\n          return false;\n        }\n      }\n\n      // 4. Filter by Classroom\n      if (filterRoom !== \'\345\205\250\351\203\250\346\225\231\345\256\244\' && item.classroom !== filterRoom) {\n        return false;\n      }\n\n      // 5. Filter by Teacher\n      if (filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\' && item.teacher.id !== filterTeacherId) {\n        return false;\n      }\n\n      return true;\n    });\n  }, [classes, selectedDateStr, activeCourseType, onlyBookable, filterRoom, filterTeacherId, bookedClassIds]);\n\n  // Check if a class has ended based on mock current time\n  function isClassPassed(cls: DanceClass): boolean {\n    const todayStr = \'2026-05-25\';\n    if (cls.date < todayStr) return true;\n    if (cls.date > todayStr) return false;\n\n    // Same day: 2026-05-25, check time\n    const [startH, startM] = cls.timeStart.split(\':\').map(Number);\n    if (startH < CURRENT_HOUR) return true;\n    if (startH === CURRENT_HOUR && startM < CURRENT_MINUTE) return true;\n    return false;\n  }\n\n  // Handle Booking\n  const handleBookingToggle = (clsId: string) => {\n    const cls = classes.find(c => c.id === clsId);\n    if (!cls) return;\n\n    const isAlreadyBooked = bookedClassIds.includes(clsId);\n\n    if (isAlreadyBooked) {\n      // Refund/Cancel Booking\n      setBookedClassIds(prev => prev.filter(id => id !== clsId));\n      setUserPasses(prev => prev + 1);\n      setClasses(prev => prev.map(c => {\n        if (c.id === clsId) {\n          return { ...c, bookedCount: Math.max(0, c.bookedCount - 1) };\n        }\n        return c;\n      }));\n      addToast(`\345\267\262\346\210\220\345\212\237\345\217\226\346\266\210 \343\200\212${cls.title}\343\200\213 \347\232\204\351\242\204\347\272\246\357\274\2141\350\257\276\346\254\241\345\267\262\350\242\253\351\200\200\345\233\236\357\274\201`, \'info\');\n    } else {\n      // Try to Book\n      if (cls.bookedCount >= cls.maxCount) {\n        addToast(\'\346\212\261\346\255\211\357\274\214\350\257\245\350\257\276\347\250\213\345\220\215\351\242\235\345\267\262\346\273\241\343\200\202\346\202\250\345\217\257\344\273\245\351\200\211\346\213\251\"\346\216\222\351\230\237\"\350\277\233\350\241\214\351\242\204\347\272\246\343\200\202\', \'error\');\n        return;\n      }\n\n      if (userPasses < 1) {\n        addToast(\'\350\257\276\346\254\241\344\275\231\351\242\235\344\270\215\350\266\263\357\274\214\350\257\267\345\211\215\345\276\200\345\225\206\345\237\216\345\205\205\345\200\274\350\264\255\344\271\260\357\274\201\', \'error\');\n        return;\n      }\n\n      setBookedClassIds(prev => [...prev, clsId]);\n      setUserPasses(prev => prev - 1);\n      setClasses(prev => prev.map(c => {\n        if (c.id === clsId) {\n          return { ...c, bookedCount: c.bookedCount + 1 };\n        }\n        return c;\n      }));\n      addToast(`\351\242\204\347\272\246\346\210\220\345\212\237\357\274\201\343\200\212${cls.title}\343\200\213\345\260\206\345\234\250\345\256\244\345\274\200\350\257\276\357\274\214\350\256\260\345\276\227\345\207\206\346\227\266\345\217\202\345\212\240\343\200\202`, \'success\');\n    }\n  };\n\n  // Handle Waitlist Queue Toggle\n  const handleWaitlistToggle = (clsId: string) => {\n    const cls = classes.find(c => c.id === clsId);\n    if (!cls) return;\n\n    const isWaiting = waitlistClassIds.includes(clsId);\n\n    if (isWaiting) {\n      setWaitlistClassIds(prev => prev.filter(id => id !== clsId));\n      addToast(`\345\267\262\345\217\226\346\266\210 \343\200\212${cls.title}\343\200\213 \347\232\204\346\216\222\351\230\237\345\200\231\350\241\245\357\274\201`, \'info\');\n    } else {\n      if (userPasses < 1) {\n        addToast(\'\346\216\222\351\230\237\344\271\237\351\234\200\350\246\201\345\206\273\347\273\2231\344\270\252\350\257\276\346\254\241\357\274\214\350\257\267\345\205\210\345\234\250\345\225\206\345\237\216\345\205\205\345\200\274\343\200\202\', \'error\');\n        return;\n      }\n\n      setWaitlistClassIds(prev => [...prev, clsId]);\n      addToast(`\346\202\250\345\267\262\347\273\217\345\212\240\345\205\245\343\200\212${cls.title}\343\200\213 \345\200\231\350\241\245\346\216\222\351\230\237\343\200\202\350\213\245\346\234\211\344\275\215\347\275\256\345\260\206\350\207\252\345\212\250\350\275\254\345\205\245\345\271\266\347\237\255\344\277\241\351\200\232\347\237\245\346\202\250\357\274\201`, \'success\');\n    }\n  };\n\n  // Drawer Action Triggers\n  const openFilterDrawer = () => {\n    setTempRoom(filterRoom);\n    setTempTeacherId(filterTeacherId);\n    setIsFilterOpen(true);\n  };\n\n  const applyDrawerFilters = () => {\n    setFilterRoom(tempRoom);\n    setFilterTeacherId(tempTeacherId);\n    setIsFilterOpen(false);\n    addToast(\'\347\255\233\351\200\211\346\235\241\344\273\266\345\267\262\345\220\257\347\224\250\', \'info\');\n  };\n\n  const resetDrawerFilters = () => {\n    setTempRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n    setTempTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n    setFilterRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n    setFilterTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n    setIsFilterOpen(false);\n    addToast(\'\347\255\233\351\200\211\346\235\241\344\273\266\345\267\262\351\207\215\347\275\256\', \'info\');\n  };\n\n  // Calculate full week grid list for the Weekly Scheduler view\n  const weeklyGridDates = useMemo(() => {\n    const dates = [];\n    for (let i = 0; i < 7; i++) {\n      const d = new Date(currentWeekStart);\n      d.setDate(currentWeekStart.getDate() + i);\n      const year = d.getFullYear();\n      const month = String(d.getMonth() + 1).padStart(2, \'0\');\n      const day = String(d.getDate()).padStart(2, \'0\');\n      dates.push({\n        dateStr: `${year}-${month}-${day}`,\n        dayLabel: WEEK_NAMES[d.getDay()],\n        dayNum: `${month}-${day}`\n      });\n    }\n    return dates;\n  }, [currentWeekStart]);\n\n  // Navigate week forward or backward\n  const handleWeekChange = (offset: number) => {\n    const newStart = new Date(currentWeekStart);\n    newStart.setDate(currentWeekStart.getDate() + offset * 7);\n    setCurrentWeekStart(newStart);\n  };\n\n  // Calendar click date selection handler\n  const handleCalendarPickDate = (dateStr: string) => {\n    setSelectedDateStr(dateStr);\n    setIsCalendarOpen(false);\n    addToast(`\345\267\262\350\267\263\350\275\254\350\207\263 ${dateStr} \350\257\276\350\241\250`, \'info\');\n  };\n\n  // Get difficulty stars UI\n  const renderStars = (diffVal: number) => {\n    return (\n      <span className=\"flex text-amber-500 text-xs ml-1\">\n        {Array.from({ length: 5 }).map((_, i) => (\n          <span key={i} className=\"text-sm\">\n            {i < diffVal ? \'\342\230\205\' : \'\342\230\206\'}\n          </span>\n        ))}\n      </span>\n    );\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto px-4 pb-20 pt-2 bg-slate-50\" id=\"schedule-container\">\n      {/* Header section with PLANA selection and Tab slider */}\n      <div className=\"flex items-center justify-between py-2 border-b border-slate-150\">\n        <div className=\"flex items-center space-x-1\" id=\"studio-selector\">\n          <div className=\"w-5 h-5 rounded-full bg-teal-500 flex items-center justify-center text-white text-xs font-bold\">\n            P\n          </div>\n          <span className=\"font-bold text-slate-800 text-sm\">PLANA\350\241\227\351\201\223\345\217\243\345\272\227</span>\n        </div>\n\n        {/* Day / Week scheduler toggle tabs */}\n        <div className=\"bg-slate-200/80 p-0.5 rounded-full flex text-xs font-medium\" id=\"mode-selector\">\n          <button\n            onClick={() => setViewMode(\'day\')}\n            className={`px-3 py-1 rounded-full transition-all ${\n              viewMode === \'day\'\n                ? \'bg-white text-teal-600 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-800\'\n            }`}\n          >\n            \346\227\245\350\257\276\350\241\250\n          </button>\n          <button\n            onClick={() => setViewMode(\'week\')}\n            className={`px-3 py-1 rounded-full transition-all ${\n              viewMode === \'week\'\n                ? \'bg-white text-teal-600 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-800\'\n            }`}\n          >\n            \345\221\250\350\257\276\350\241\250\n          </button>\n        </div>\n      </div>\n\n      {viewMode === \'day\' ? (\n        /* =================== DAILY VIEW INTERFACE =================== */\n        <div>\n          {/* Main Course filters: Group (\345\233\242\350\257\276) | Private (\347\247\201\346\225\231) | Series (\347\217\255\350\257\276) */}\n          <div className=\"flex items-center justify-between mt-3 mb-2\">\n            <div className=\"bg-slate-100 p-1 rounded-lg flex space-x-1 shrink-0\">\n              <button\n                onClick={() => setActiveCourseType(\'group\')}\n                className={`text-xs px-3 py-1.5 rounded-md font-semibold ${\n                  activeCourseType === \'group\'\n                    ? \'bg-teal-500 text-white shadow\'\n                    : \'text-slate-600 hover:bg-slate-200\'\n                }`}\n                id=\"btn-group-class\"\n              >\n                \345\233\242\350\257\276\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'private\')}\n                className={`text-xs px-3 py-1.5 rounded-md font-semibold ${\n                  activeCourseType === \'private\'\n                    ? \'bg-teal-500 text-white shadow\'\n                    : \'text-slate-600 hover:bg-slate-200\'\n                }`}\n                id=\"btn-private-class\"\n              >\n                \347\247\201\346\225\231\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'series\')}\n                className={`text-xs px-3 py-1.5 rounded-md font-semibold ${\n                  activeCourseType === \'series\'\n                    ? \'bg-teal-500 text-white shadow\'\n                    : \'text-slate-600 hover:bg-slate-200\'\n                }`}\n                id=\"btn-series-class\"\n              >\n                \347\217\255\350\257\276\n              </button>\n            </div>\n\n            {/* Quick action buttons: Bookable switch & Month Calendar Icon */}\n            <div className=\"flex items-center space-x-3\">\n              <label className=\"flex items-center cursor-pointer select-none\" id=\"toggle-bookable\">\n                <span className=\"text-xs text-slate-600 mr-1.5\">\345\217\257\347\272\246</span>\n                <div className=\"relative\">\n                  <input\n                    type=\"checkbox\"\n                    checked={onlyBookable}\n                    onChange={(e) => setOnlyBookable(e.target.checked)}\n                    className=\"sr-only\"\n                  />\n                  <div className={`w-8 h-4.5 rounded-full transition-colors ${onlyBookable ? \'bg-teal-500\' : \'bg-slate-300\'}`}></div>\n                  <div className={`absolute top-0.5 left-0.5 bg-white w-3.5 h-3.5 rounded-full transition-transform ${onlyBookable ? \'translate-x-3.5\' : \'translate-x-0\'}`}></div>\n                </div>\n              </label>\n\n              <button\n                onClick={() => setIsCalendarOpen(true)}\n                className=\"w-8 h-8 rounded-full border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:text-teal-600 hover:bg-slate-100 transition\"\n                title=\"\351\200\211\346\213\251\346\227\245\346\234\237\"\n                id=\"btn-open-calendar\"\n              >\n                <Calendar className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Scrolling dates carousel row */}\n          <div className=\"flex items-center space-x-1.5 overflow-x-auto pb-2 mt-2 -mx-4 px-4 scrollbar-none\" id=\"date-carousel\">\n            {CAROUSEL_DATES.map((item) => {\n              const dateObj = new Date(item.dateStr);\n              const isSelected = selectedDateStr === item.dateStr;\n              return (\n                <button\n                  key={item.dateStr}\n                  onClick={() => setSelectedDateStr(item.dateStr)}\n                  className={`flex flex-col items-center justify-center p-2 rounded-xl min-w-11 transition-all ${\n                    isSelected\n                      ? \'bg-teal-500 text-white shadow-md shadow-teal-100 scale-105\'\n                      : \'bg-white hover:bg-slate-100 text-slate-700 hover:text-slate-900 border border-slate-100\'\n                  }`}\n                >\n                  <span className={`text-[10px] ${isSelected ? \'text-teal-100\' : \'text-slate-400\'}`}>\n                    {item.name}\n                  </span>\n                  <span className=\"text-sm font-bold mt-0.5\">\n                    {item.displayDate}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Filter button and label summaries */}\n          <div className=\"flex items-center justify-between mt-3 mb-2\">\n            <div className=\"text-xs text-slate-500 font-mono\">\n              {(filterRoom !== \'\345\205\250\351\203\250\346\225\231\345\256\244\' || filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\') ? (\n                <span className=\"text-teal-600 flex items-center\">\n                  <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-teal-500 mr-1 animate-pulse\"></span>\n                  \347\255\233\351\200\211: {filterRoom} \342\200\242 {filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\' ? TEACHERS.find(t=>t.id===filterTeacherId)?.name : \'\345\205\250\351\203\250\350\200\201\345\270\210\'}\n                </span>\n              ) : (\n                <span>\345\205\250\351\203\250\350\257\276\347\250\213\350\256\241\345\210\222\345\210\227\350\241\250</span>\n              )}\n            </div>\n\n            <button\n              onClick={openFilterDrawer}\n              className=\"flex items-center text-slate-600 hover:text-teal-600 text-xs px-2.5 py-1 bg-white border border-slate-200 rounded-full transition\"\n              id=\"btn-filter-drawer\"\n            >\n              <Filter className=\"w-3.5 h-3.5 mr-1\" />\n              <span>\347\255\233\351\200\211 </span>\n            </button>\n          </div>\n\n          {/* Cards List container with Empty Stage conditions */}\n          <div className=\"space-y-3 mt-2\" id=\"daily-classes-list\">\n            {finalFilteredClasses.length === 0 ? (\n              <div className=\"bg-white rounded-2xl p-8 border border-slate-100 text-center flex flex-col items-center justify-center\" id=\"empty-state\">\n                <div className=\"w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3\">\n                  <Layers className=\"w-8 h-8\" />\n                </div>\n                <p className=\"text-slate-600 font-medium text-sm\">\346\232\202\346\227\240\350\257\276\347\250\213\344\277\241\346\201\257\357\274\214\345\205\210\347\234\213\347\234\213\345\210\253\347\232\204\345\220\247</p>\n                <p className=\"text-xs text-slate-400 mt-1 mb-4 font-mono\">\346\234\200\350\277\221\345\217\257\347\272\246\351\241\271\347\233\256\344\270\272: 2026-05-25 (\344\273\212\346\227\245)</p>\n                <button\n                  onClick={() => {\n                    setSelectedDateStr(\'2026-05-25\');\n                    setFilterRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n                    setFilterTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n                    setActiveCourseType(\'group\');\n                  }}\n                  className=\"px-4 py-2 bg-teal-500 hover:bg-teal-600 text-white rounded-xl text-xs font-semibold shadow transition\"\n                  id=\"btn-back-to-today\"\n                >\n                  \347\253\213\345\215\263\351\242\204\347\272\246 (\347\234\213\344\273\212\345\244\251\345\244\247\350\257\276)\n                </button>\n              </div>\n            ) : (\n              finalFilteredClasses.map((cls) => {\n                const ended = isClassPassed(cls);\n                const isBooked = bookedClassIds.includes(cls.id);\n                const isWaiting = waitlistClassIds.includes(cls.id);\n                const isFull = cls.bookedCount >= cls.maxCount;\n\n                return (\n                  <div\n                    key={cls.id}\n                    className={`bg-white rounded-2xl border transition-all duration-300 overflow-hidden ${\n                      isBooked\n                        ? \'border-teal-500 shadow-md shadow-teal-50/50\'\n                        : isWaiting\n                        ? \'border-rose-300 ring-1 ring-rose-100\'\n                        : \'border-slate-100 hover:border-slate-300 hover:shadow-xs\'\n                    }`}\n                  >\n                    {/* Top cyan hour panel tag */}\n                    <div className=\"bg-slate-50/80 px-4 py-1.5 border-b border-slate-50 flex items-center justify-between\">\n                      <span className=\"text-xs text-teal-600 font-bold font-mono\">\n                        {cls.timeStart} ~ {cls.timeEnd}\n                      </span>\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-wider font-mono\">\n                        {cls.genre} Style\n                      </span>\n                    </div>\n\n                    <div className=\"p-4 flex items-start space-x-3.5\">\n                      {/* Teacher Round Avatar */}\n                      <div className=\"relative shrink-0\">\n                        <img\n                          src={cls.teacher.avatar}\n                          alt={cls.teacher.name}\n                          className=\"w-13 h-13 rounded-full object-cover border-2 border-slate-100\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                        <span className=\"absolute -bottom-1 -right-1 bg-yellow-400 text-[9px] px-1 rounded-full font-bold shadow-xs\">\n                          {cls.teacher.rating.toFixed(1)}\n                        </span>\n                      </div>\n\n                      {/* Main Center specs of Class */}\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center space-x-1.5 flex-wrap\">\n                          <h3 className=\"font-bold text-slate-800 text-base tracking-tight truncate leading-tight\">\n                            {cls.title}\n                          </h3>\n                        </div>\n\n                        {/* Dance genre text styled */}\n                        <div className=\"flex items-center text-xs text-slate-500 mt-1 space-x-1 font-sans\">\n                          <span className=\"text-slate-800 font-semibold\">{cls.teacher.name}</span>\n                          <span className=\"text-slate-300\">\342\200\242</span>\n                          <span className=\"capitalize\">{cls.genre}</span>\n                          <span className=\"text-slate-300\">\342\200\242</span>\n                          <span className=\"flex items-center\">\n                            \351\232\276\345\272\246 {renderStars(cls.difficulty)}\n                          </span>\n                        </div>\n\n                        {/* Booking classroom and capacity ratios */}\n                        <div className=\"text-xs text-slate-500 mt-1 font-mono space-y-0.5\">\n                          <div>{cls.classroom} \342\200\242 \346\273\241{cls.minPeople}\344\272\272\345\274\200\350\257\276</div>\n                          <div className=\"flex items-center mt-1\">\n                            <span className=\"mr-1.5\">\345\267\262\351\242\204\347\272\246:</span>\n                            <span className={`font-semibold ${isFull ? \'text-rose-500\' : \'text-teal-600\'}`}>\n                              {cls.bookedCount}\n                            </span>\n                            <span className=\"text-slate-300 mx-0.5\">/</span>\n                            <span>{cls.maxCount}\344\272\272</span>\n\n                            {isFull && (\n                              <span className=\"ml-2 bg-amber-50 text-amber-600 text-[10px] font-medium tracking-tight px-1.5 py-0.5 rounded-sm border border-amber-100 leading-none\">\n                                \345\270\255\344\275\215\347\264\247\345\274\240\n                              </span>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* Side Actions buttons */}\n                      <div className=\"shrink-0 flex flex-col justify-center items-end h-full\">\n                        {ended ? (\n                          <div className=\"bg-slate-100 text-slate-400 text-xs px-4 py-2 rounded-full font-semibold select-none cursor-not-allowed\">\n                            \345\267\262\347\273\223\346\235\237\n                          </div>\n                        ) : cls.openBookingTime ? (\n                          <div className=\"flex flex-col items-end\">\n                            <span className=\"text-[10px] text-teal-600 font-bold mb-1 font-mono\">\n                              {cls.openBookingTime}\n                            </span>\n                            <button\n                              disabled\n                              className=\"bg-slate-100 text-slate-400 text-xs px-4.5 py-2 rounded-full font-semibold opacity-70 cursor-not-allowed\"\n                            >\n                              \346\234\252\345\274\200\345\220\257\n                            </button>\n                          </div>\n                        ) : isBooked ? (\n                          <button\n                            onClick={() => handleBookingToggle(cls.id)}\n                            className=\"bg-teal-50 hover:bg-teal-100 text-teal-600 active:scale-95 text-xs px-4 py-2 rounded-full font-bold border border-teal-200 transition flex items-center space-x-1 shadow-sm\"\n                          >\n                            <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                            <span>\345\267\262\351\242\204\347\272\246</span>\n                          </button>\n                        ) : (\n                          <div>\n                            {isFull ? (\n                              <button\n                                onClick={() => handleWaitlistToggle(cls.id)}\n                                className={`text-xs px-4 py-2 rounded-full font-bold transition duration-250 active:scale-95 flex items-center space-x-1 ${\n                                  isWaiting\n                                    ? \'bg-rose-100 text-rose-600 border border-rose-300\'\n                                    : \'bg-rose-500 text-white hover:bg-rose-600 shadow-sm\'\n                                }`}\n                              >\n                                {isWaiting ? \'\345\200\231\350\241\245\344\270\255\' : \'\346\216\222\351\230\237\'}\n                              </button>\n                            ) : (\n                              <button\n                                onClick={() => handleBookingToggle(cls.id)}\n                                className=\"bg-teal-500 text-white hover:bg-teal-600 active:scale-95 text-xs px-4.5 py-2 rounded-full font-bold transition shadow-sm\"\n                              >\n                                \351\242\204\347\272\246\n                              </button>\n                            )}\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      ) : (\n        /* =================== WEEKLY GRID SCHEDULER VIEW =================== */\n        <div className=\"mt-3\">\n          {/* Week interval navigator panel */}\n          <div className=\"flex items-center justify-between bg-white px-3 py-2 border border-slate-100 rounded-2xl mb-4\">\n            <button\n              onClick={() => handleWeekChange(-1)}\n              className=\"p-1 rounded-full text-slate-500 hover:bg-slate-100 transition\"\n              id=\"weekly-prev\"\n            >\n              <ChevronLeft className=\"w-5 h-5\" />\n            </button>\n\n            <span className=\"text-xs font-bold text-slate-700 tracking-tight font-mono\">\n              {weeklyGridDates[0].dayNum} \350\207\263 {weeklyGridDates[6].dayNum}\n            </span>\n\n            <button\n              onClick={() => handleWeekChange(1)}\n              className=\"p-1 rounded-full text-slate-500 hover:bg-slate-100 transition\"\n              id=\"weekly-next\"\n            >\n              <ChevronRight className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Grid layout panel scrollable horizontally */}\n          <div className=\"bg-white border border-slate-150 rounded-2xl overflow-hidden shadow-xs\">\n            <div className=\"overflow-x-auto\">\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-slate-100 border-b border-slate-100 bg-slate-50\">\n                {/* Time header label cell */}\n                <div className=\"p-2 py-3 text-center text-[10px] font-bold text-slate-400 font-mono\">\n                  \346\227\266\351\227\264\n                </div>\n\n                {/* 7 Columns titles of date */}\n                {weeklyGridDates.map((col, idx) => {\n                  const isDateSelected = selectedDateStr === col.dateStr;\n                  return (\n                    <button\n                      key={idx}\n                      onClick={() => {\n                        setSelectedDateStr(col.dateStr);\n                        setViewMode(\'day\'); // Slide back to daily of that picked list\n                        addToast(`\345\267\262\350\267\263\350\275\254\350\207\263 ${col.dateStr} \350\257\246\347\273\206\350\257\276\350\241\250`, \'info\');\n                      }}\n                      className={`p-2 py-3 text-center transition flex flex-col items-center justify-center hover:bg-slate-100 ${\n                        isDateSelected ? \'bg-teal-50/50 border-t-2 border-teal-500\' : \'\'\n                      }`}\n                    >\n                      <span className=\"text-[10px] text-slate-500 block font-medium\">\n                        {col.dayLabel}\n                      </span>\n                      <span className={`text-[11px] font-bold mt-0.5 ${isDateSelected ? \'text-teal-600\' : \'text-slate-800\'}`}>\n                        {col.dayNum}\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Weekly Timeline Slots Body */}\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-slate-100 font-mono\">\n                {/* Simulated time intervals rows */}\n                <div className=\"col-span-1 divide-y divide-slate-100\">\n                  {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((time) => (\n                    <div key={time} className=\"h-28 p-2 text-center flex items-center justify-center text-[11px] font-bold text-slate-400 bg-slate-50 border-b border-slate-100\">\n                      {time}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Grid cells representing dance categories slots */}\n                {weeklyGridDates.map((col, colIdx) => {\n                  const dayClasses = classes.filter(c => c.date === col.dateStr);\n\n                  return (\n                    <div key={colIdx} className=\"col-span-1 divide-y divide-slate-100 min-h-[500px]\">\n                      {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((timeSlot) => {\n                        // Find if any class matches this general time starting slot index\n                        const classMatch = dayClasses.find(c => c.timeStart === timeSlot);\n                        const isBooked = classMatch ? bookedClassIds.includes(classMatch.id) : false;\n\n                        return (\n                          <div key={timeSlot} className=\"h-28 p-1 relative flex flex-col justify-between border-b border-slate-100\">\n                            {classMatch ? (\n                              <div\n                                onClick={() => {\n                                  setSelectedDateStr(col.dateStr);\n                                  setViewMode(\'day\'); // Direct go to detail on click\n                                  addToast(`\346\202\250\347\202\271\345\207\273\344\272\206 ${classMatch.title}\357\274\214\350\277\233\345\205\245\345\215\225\346\227\245\346\250\241\345\274\217\347\256\241\347\220\206\351\242\204\347\272\246`, \'info\');\n                                }}\n                                className={`w-full h-full rounded-lg p-1.5 text-left text-white leading-tight cursor-pointer overflow-hidden transition-all hover:brightness-95 flex flex-col justify-between ${\n                                  isBooked\n                                    ? \'bg-teal-600 shadow-xs shadow-teal-500/20 ring-1 ring-white/20\'\n                                    : classMatch.genre === \'hiphop\'\n                                    ? \'bg-sky-500\'\n                                    : classMatch.genre === \'jazz\'\n                                    ? \'bg-fuchsia-500\'\n                                    : classMatch.genre === \'urban\'\n                                    ? \'bg-orange-500\'\n                                    : \'bg-indigo-500\'\n                                }`}\n                              >\n                                <div>\n                                  <div className=\"text-[9px] truncate font-extrabold tracking-tight\">\n                                    {classMatch.title}\n                                  </div>\n                                  <div className=\"text-[8px] opacity-90 truncate\">\n                                    {classMatch.timeStart}~{classMatch.timeEnd}\n                                  </div>\n                                  <div className=\"text-[8px] font-bold tracking-wider capitalize\">\n                                    {classMatch.teacher.name}\n                                  </div>\n                                </div>\n\n                                <div className=\"flex items-center justify-between mt-1\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white/35 text-[8px] font-bold px-1 rounded truncate\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/15 text-[8px] font-bold px-1 rounded truncate\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n                              <div className=\"w-full h-full text-slate-150 flex items-center justify-center text-[10px] select-none\">\n                                -\n                              </div>\n                            )}\n                          </div>\n                        );\n                      })}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <p className=\"text-[10px] text-slate-400 mt-2 text-center leading-relaxed\">\n            * \346\217\220\347\244\272: \345\221\250\350\257\276\350\241\250\351\242\234\350\211\262\344\273\243\350\241\250\344\270\215\345\220\214\350\210\236\347\247\215\351\243\216\346\240\274\345\210\206\347\261\273 (Hiphop, Jazz, Urban, Standard)\343\200\202\347\202\271\345\207\273\345\215\241\347\211\207\357\274\214\345\215\263\345\217\257\350\267\263\350\275\254\350\207\263\345\215\225\346\227\245\350\257\276\350\241\250\346\237\245\347\234\213\345\256\214\346\225\264\350\257\246\346\203\205\345\217\212\345\256\214\346\210\220\351\242\204\345\256\232\351\200\200\350\256\242\343\200\202\n          </p>\n        </div>\n      )}\n\n      {/* ==================== SCREEN DIALOG 1: CALENDAR MODAL (Image 9) ==================== */}\n      <AnimatePresence>\n        {isCalendarOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n            {/* Overlay sheet backdrop */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsCalendarOpen(false)}\n              className=\"absolute inset-0 bg-black/60 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Modal Body Container */}\n            <motion.div\n              initial={{ scale: 0.95, opacity: 0, y: 15 }}\n              animate={{ scale: 1, opacity: 1, y: 0 }}\n              exit={{ scale: 0.95, opacity: 0, y: 15 }}\n              className=\"bg-white rounded-3xl w-full max-w-sm overflow-hidden shadow-2xl relative z-10 border border-slate-100\"\n            >\n              {/* Month selector header */}\n              <div className=\"bg-slate-50 p-4 border-b border-slate-100 flex items-center justify-between\">\n                <span className=\"text-sm text-slate-400 font-bold tracking-tight\">\346\234\210\345\216\206\346\227\245\346\234\237\351\200\211\346\213\251</span>\n                <span className=\"text-base font-extrabold text-slate-800 font-mono\">2026-05</span>\n                <span className=\"text-xs bg-teal-50 text-teal-600 font-bold px-2 py-0.5 rounded-full font-mono\">\344\273\212\345\244\251: 25\346\227\245</span>\n              </div>\n\n              {/* Calendar Grid mockup elements */}\n              <div className=\"p-4\" id=\"calendar-grid-box\">\n                {/* Row day labels */}\n                <div className=\"grid grid-cols-7 text-center mb-2\">\n                  {[\'\346\227\245\', \'\344\270\200\', \'\344\272\214\', \'\344\270\211\', \'\345\233\233\', \'\344\272\224\', \'\345\205\255\'].map((day) => (\n                    <span key={day} className=\"text-[10px] text-slate-400 font-bold py-1\">\n                      {day}\n                    </span>\n                  ))}\n                </div>\n\n                <div className=\"grid grid-cols-7 text-center gap-1.5 font-mono\">\n                  {/* Empty cells for May offset (Starts on Friday, 1st) */}\n                  {Array.from({ length: 5 }).map((_, idx) => (\n                    <span key={`empty_${idx}`} className=\"text-slate-100 text-xs py-1.5\">-</span>\n                  ))}\n\n                  {/* Days grid generator from 1 to 31 */}\n                  {Array.from({ length: 31 }).map((_, idx) => {\n                    const dayNumStr = String(idx + 1).padStart(2, \'0\');\n                    const fullDateStr = `2026-05-${dayNumStr}`;\n                    const isToday = dayNumStr === \'25\';\n                    const isBookableRange = idx + 1 >= 24 && idx + 1 <= 31; // Enabled only matching dates\n                    const isCurrentSelected = selectedDateStr === fullDateStr;\n\n                    return (\n                      <button\n                        key={idx}\n                        disabled={!isBookableRange}\n                        onClick={() => handleCalendarPickDate(fullDateStr)}\n                        className={`text-xs py-1.5 font-bold rounded-lg transition relative ${\n                          isCurrentSelected\n                            ? \'bg-teal-500 text-white shadow shadow-teal-300\'\n                            : isToday\n                            ? \'border border-teal-500 text-teal-600 bg-teal-50/50\'\n                            : isBookableRange\n                            ? \'text-slate-800 hover:bg-slate-100\'\n                            : \'text-slate-200 cursor-not-allowed text-[10px]\'\n                        }`}\n                      >\n                        {idx + 1}\n                        {isToday && (\n                          <span className=\"absolute bottom-0.5 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-teal-600 rounded-full\"></span>\n                        )}\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Bottom close footer buttons */}\n              <div className=\"border-t border-slate-100 p-3 bg-slate-50 flex items-center justify-between\">\n                <button\n                  onClick={() => handleCalendarPickDate(\'2026-05-25\')}\n                  className=\"text-xs text-teal-600 font-bold hover:underline\"\n                >\n                  \345\233\236\344\273\212\345\244\251 (5-25)\n                </button>\n                <button\n                  onClick={() => setIsCalendarOpen(false)}\n                  className=\"px-4 py-1.5 bg-slate-200 text-slate-700 hover:bg-slate-300 text-xs font-bold rounded-xl transition\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== SCREEN DIALOG 2: FILTER DRAWER (Image 8) ==================== */}\n      <AnimatePresence>\n        {isFilterOpen && (\n          <div className=\"fixed inset-0 z-50 overflow-hidden\">\n            {/* Drawer Backdrop overlay */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsFilterOpen(false)}\n              className=\"absolute inset-0 bg-black/50 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Slider Content block */}\n            <div className=\"absolute inset-y-0 right-0 max-w-full flex pl-10\">\n              <motion.div\n                initial={{ x: \'100%\' }}\n                animate={{ x: 0 }}\n                exit={{ x: \'100%\' }}\n                transition={{ type: \'spring\', damping: 25, stiffness: 220 }}\n                className=\"w-screen max-w-xs bg-white border-l border-slate-100 flex flex-col shadow-2xl\"\n              >\n                {/* Header title */}\n                <div className=\"p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50\">\n                  <span className=\"font-bold text-slate-800\">\350\257\276\347\250\213\346\240\207\347\255\276\347\255\233\351\200\211</span>\n                  <button\n                    onClick={() => setIsFilterOpen(false)}\n                    className=\"text-slate-400 hover:text-slate-600 text-sm font-semibold\"\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n\n                <div className=\"flex-1 overflow-y-auto p-4 space-y-6\">\n                  {/* Classroom Selector block */}\n                  <div>\n                    <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-2.5\">\n                      \346\225\231\345\256\244 (Classroom)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                      {classroomsList.map((room) => {\n                        const isSel = tempRoom === room;\n                        return (\n                          <button\n                            key={room}\n                            onClick={() => setTempRoom(room)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition ${\n                              isSel\n                                ? \'bg-teal-50 border-teal-500 text-teal-600\'\n                                : \'bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300\'\n                            }`}\n                          >\n                            {room}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n\n                  {/* Teachers Selector block */}\n                  <div>\n                    <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider mb-2.5\">\n                      \350\200\201\345\270\210 (Instructor)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-1.5\">\n                      <button\n                        onClick={() => setTempTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\')}\n                        className={`px-3 py-1.5 rounded-full text-xs font-bold border transition ${\n                          tempTeacherId === \'\345\205\250\351\203\250\350\200\201\345\270\210\'\n                            ? \'bg-teal-50 border-teal-500 text-teal-600\'\n                            : \'bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300\'\n                        }`}\n                      >\n                        \345\205\250\351\203\250\350\200\201\345\270\210\n                      </button>\n\n                      {TEACHERS.map((teacher) => {\n                        const isSel = tempTeacherId === teacher.id;\n                        return (\n                          <button\n                            key={teacher.id}\n                            onClick={() => setTempTeacherId(teacher.id)}\n                            className={`px-3 py-1.5 rounded-full text-xs font-bold border transition ${\n                              isSel\n                                ? \'bg-teal-50 border-teal-500 text-teal-600\'\n                                : \'bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300\'\n                            }`}\n                          >\n                            {teacher.name}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Trigger controls with \"\351\207\215\347\275\256\" & \"\347\241\256\350\256\244\" */}\n                <div className=\"p-4 border-t border-slate-100 grid grid-cols-2 gap-3 bg-slate-50\">\n                  <button\n                    onClick={resetDrawerFilters}\n                    className=\"w-full py-2.5 border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer\"\n                  >\n                    \351\207\215\347\275\256\n                  </button>\n                  <button\n                    onClick={applyDrawerFilters}\n                    className=\"w-full py-2.5 bg-teal-500 hover:bg-teal-600 text-white text-xs font-bold rounded-xl shadow-sm shadow-teal-400/35 transition cursor-pointer\"\n                  >\n                    \347\241\256\350\256\244\n                  </button>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState, useMemo } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { DanceClass, Teacher } from \'../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { TEACHERS } from \'../data\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { Calendar, Filter, ChevronLeft, ChevronRight, CheckCircle2, AlertTriangle, RefreshCw, Layers } from \'lucide-react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { motion, AnimatePresence } from \'motion/react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "interface ScheduleViewProps {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  classes: DanceClass[];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  setClasses: React.Dispatch<React.SetStateAction<DanceClass[]>>;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  userPasses: number;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  setUserPasses: React.Dispatch<React.SetStateAction<number>>;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  bookedClassIds: string[];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  setBookedClassIds: React.Dispatch<React.SetStateAction<string[]>>;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  waitlistClassIds: string[];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  setWaitlistClassIds: React.Dispatch<React.SetStateAction<string[]>>;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  addToast: (msg: string, type: \'success\' | \'info\' | \'error\') => void;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
