        target_content: "          {/* Scrolling dates carousel row */}\n          <div className=\"flex items-center space-x-1.5 overflow-x-auto pb-2 mt-2 -mx-4 px-4 scrollbar-none\" id=\"date-carousel\">\n            {CAROUSEL_DATES.map((item) => {\n              const dateObj = new Date(item.dateStr);\n              const isSelected = selectedDateStr === item.dateStr;\n              return (\n                <button\n                  key={item.dateStr}\n                  onClick={() => setSelectedDateStr(item.dateStr)}\n                  className={`flex flex-col items-center justify-center p-2 rounded-xl min-w-11 transition-all ${\n                    isSelected\n                      ? \'bg-teal-500 text-white shadow-md shadow-teal-100 scale-105\'\n                      : \'bg-white hover:bg-slate-100 text-slate-700 hover:text-slate-900 border border-slate-100\'\n                  }`}\n                >\n                  <span className={`text-[10px] ${isSelected ? \'text-teal-100\' : \'text-slate-400\'}`}>\n                    {item.name}\n                  </span>\n                  <span className=\"text-sm font-bold mt-0.5\">\n                    {item.displayDate}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Filter button and label summaries */}\n          <div className=\"flex items-center justify-between mt-3 mb-2\">\n            <div className=\"text-xs text-slate-500 font-mono\">\n              {(filterRoom !== \'\345\205\250\351\203\250\346\225\231\345\256\244\' || filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\') ? (\n                <span className=\"text-teal-600 flex items-center\">\n                  <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-teal-500 mr-1 animate-pulse\"></span>\n                  \347\255\233\351\200\211: {filterRoom} \342\200\242 {filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\' ? TEACHERS.find(t=>t.id===filterTeacherId)?.name : \'\345\205\250\351\203\250\350\200\201\345\270\210\'}\n                </span>\n              ) : (\n                <span>\345\205\250\351\203\250\350\257\276\347\250\213\350\256\241\345\210\222\345\210\227\350\241\250</span>\n              )}\n            </div>\n\n            <button\n              onClick={openFilterDrawer}\n              className=\"flex items-center text-slate-600 hover:text-teal-600 text-xs px-2.5 py-1 bg-white border border-slate-200 rounded-full transition\"\n              id=\"btn-filter-drawer\"\n            >\n              <Filter className=\"w-3.5 h-3.5 mr-1\" />\n              <span>\347\255\233\351\200\211 </span>\n            </button>\n          </div>\n\n          {/* Cards List container with Empty Stage conditions */}\n          <div className=\"space-y-3 mt-2\" id=\"daily-classes-list\">\n            {finalFilteredClasses.length === 0 ? (\n              <div className=\"bg-white rounded-2xl p-8 border border-slate-100 text-center flex flex-col items-center justify-center\" id=\"empty-state\">\n                <div className=\"w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3\">\n                  <Layers className=\"w-8 h-8\" />\n                </div>\n                <p className=\"text-slate-600 font-medium text-sm\">\346\232\202\346\227\240\350\257\276\347\250\213\344\277\241\346\201\257\357\274\214\345\205\210\347\234\213\347\234\213\345\210\253\347\232\204\345\220\247</p>\n                <p className=\"text-xs text-slate-400 mt-1 mb-4 font-mono\">\346\234\200\350\277\221\345\217\257\347\272\246\351\241\271\347\233\256\344\270\272: 2026-05-25 (\344\273\212\346\227\245)</p>\n                <button\n                  onClick={() => {\n                    setSelectedDateStr(\'2026-05-25\');\n                    setFilterRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n                    setFilterTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n                    setActiveCourseType(\'group\');\n                  }}\n                  className=\"px-4 py-2 bg-teal-500 hover:bg-teal-600 text-white rounded-xl text-xs font-semibold shadow transition\"\n                  id=\"btn-back-to-today\"\n                >\n                  \347\253\213\345\215\263\351\242\204\347\272\246 (\347\234\213\344\273\212\345\244\251\345\244\247\350\257\276)\n                </button>\n              </div>\n            ) : ("
        replacement_content: "          {/* Scrolling dates carousel row */}\n          <div className=\"flex items-center space-x-1.5 overflow-x-auto pb-2 mt-2 -mx-4 px-4 scrollbar-none\" id=\"date-carousel\">\n            {CAROUSEL_DATES.map((item) => {\n              const dateObj = new Date(item.dateStr);\n              const isSelected = selectedDateStr === item.dateStr;\n              return (\n                <button\n                  key={item.dateStr}\n                  onClick={() => setSelectedDateStr(item.dateStr)}\n                  className={`flex flex-col items-center justify-center p-2 rounded-2xl min-w-11 transition-all cursor-pointer ${\n                    isSelected\n                      ? \'bg-indigo-900 text-white shadow-md border-b-4 border-yellow-400 scale-105 font-bold\'\n                      : \'bg-white hover:bg-rose-50 hover:text-rose-500 text-indigo-900 border-2 border-indigo-50 font-semibold\'\n                  }`}\n                >\n                  <span className={`text-[9px] font-bold ${isSelected ? \'text-yellow-300\' : \'text-indigo-400\'}`}>\n                    {item.name}\n                  </span>\n                  <span className=\"text-sm font-black mt-0.5\">\n                    {item.displayDate}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Filter button and label summaries */}\n          <div className=\"flex items-center justify-between mt-3 mb-2 px-0.5\">\n            <div className=\"text-[10px] text-indigo-455 font-bold text-indigo-400 font-sans tracking-wide\">\n              {(filterRoom !== \'\345\205\250\351\203\250\346\225\231\345\256\244\' || filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\') ? (\n                <span className=\"text-rose-500 flex items-center bg-rose-50 px-2 py-0.5 rounded-full border border-rose-100\">\n                  <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5 animate-ping\"></span>\n                  \347\255\233\351\200\211: {filterRoom} \342\200\242 {filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\' ? TEACHERS.find(t=>t.id===filterTeacherId)?.name : \'\345\205\250\351\203\250\350\200\201\345\270\210\'}\n                </span>\n              ) : (\n                <span>\345\205\250\351\203\250\350\257\276\347\250\213\350\256\241\345\210\222\345\210\227\350\241\250</span>\n              )}\n            </div>\n\n            <button\n              onClick={openFilterDrawer}\n              className=\"flex items-center text-indigo-900 hover:text-rose-500 hover:bg-rose-50 text-xs px-2.5 py-1 bg-white border-2 border-indigo-150 rounded-full font-black shadow-sm cursor-pointer transition-colors\"\n              id=\"btn-filter-drawer\"\n            >\n              <Filter className=\"w-3.5 h-3.5 mr-1 text-rose-500\" />\n              <span>\347\255\233\351\200\211 </span>\n            </button>\n          </div>\n\n          {/* Cards List container with Empty Stage conditions */}\n          <div className=\"space-y-3 mt-2\" id=\"daily-classes-list\">\n            {finalFilteredClasses.length === 0 ? (\n              <div className=\"bg-white rounded-[32px] p-8 border-4 border-dashed border-indigo-100 text-center flex flex-col items-center justify-center p-8 shadow-sm\" id=\"empty-state\">\n                <div className=\"w-16 h-16 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-300 mb-3 border-2 border-indigo-100\">\n                  <Layers className=\"w-8 h-8 text-indigo-400\" />\n                </div>\n                <p className=\"text-indigo-950 font-black text-sm\">\346\232\202\346\227\240\350\257\276\347\250\213\344\277\241\346\201\257\357\274\214\345\205\210\347\234\213\347\234\213\345\210\253\347\232\204\345\220\247</p>\n                <p className=\"text-xs text-indigo-400 mt-1 mb-4 font-bold font-mono\">\346\234\200\350\277\221\345\217\257\347\272\246\351\241\271\347\233\256\344\270\272: 2026-05-25 (\344\273\212\346\227\245)</p>\n                <button\n                  onClick={() => {\n                    setSelectedDateStr(\'2026-05-25\');\n                    setFilterRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n                    setFilterTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n                    setActiveCourseType(\'group\');\n                  }}\n                  className=\"px-5 py-2.5 bg-indigo-900 hover:bg-indigo-805 text-white rounded-full text-xs font-black shadow-lg cursor-pointer hover:bg-indigo-800 transition duration-200\"\n                  id=\"btn-back-to-today\"\n                >\n                  \347\253\213\345\215\263\351\242\204\347\272\246 (\347\234\213\344\273\212\345\244\251\345\244\247\350\257\276)\n                </button>\n              </div>\n            ) : ("
