    instruction: "Replace styling of lower section of HomeView.tsx to align with Vibrant Palette theme"
    replacement_infos {
      original_chunk {
        target_content: "      {/* 4. Popular Instructors Section with biography click sheet */}\n      <div className=\"mt-5\" id=\"home-teachers-list\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-sm font-extrabold text-slate-800 uppercase tracking-tight flex items-center\">\n            <Star className=\"w-4 h-4 text-yellow-500 mr-1 fill-yellow-400\" />\n            \346\230\216\346\230\237\350\210\236\350\200\205\345\257\274\345\270\210 / Teachers\n          </h3>\n          <span className=\"text-[10px] text-slate-400 font-mono\">\347\202\271\345\207\273\345\244\264\345\203\217\346\237\245\347\234\213\347\256\200\344\273\213</span>\n        </div>\n\n        {/* Horizontal rolling instructors avatars */}\n        <div className=\"flex space-x-3 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-none\">\n          {TEACHERS.map((teacher) => (\n            <button\n              key={teacher.id}\n              onClick={() => setSelectedTeacher(teacher)}\n              className=\"flex flex-col items-center shrink-0 w-16 group\"\n            >\n              <div className=\"relative\">\n                <img\n                  src={teacher.avatar}\n                  alt={teacher.name}\n                  className=\"w-12.5 h-12.5 rounded-full object-cover border-2 border-white ring-2 ring-slate-100 group-hover:ring-teal-500 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <span className=\"absolute bottom-0 right-0 bg-teal-500 text-white rounded-full p-0.5 text-[8px] leading-none text-center\">\n                  \342\234\223\n                </span>\n              </div>\n              <span className=\"text-xs font-bold text-slate-700 mt-1 pb-0.5 truncate max-w-full\">\n                {teacher.name}\n              </span>\n              <span className=\"text-[9px] text-slate-400 leading-none truncate max-w-full\">\n                {teacher.tags[0].split(\' \')[0]}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* About PLANA branding message block */}\n      <div className=\"mt-5 p-4 rounded-2xl bg-gradient-to-br from-teal-500 to-cyan-600 text-white relative overflow-hidden shadow-xs\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 opacity-15 text-white\">\n          <Award className=\"w-32 h-32\" />\n        </div>\n        <div className=\"relative z-10\">\n          <h4 className=\"font-extrabold text-sm tracking-tight text-white mb-0.5\">\344\270\272\344\273\200\344\271\210\351\200\211\346\213\251 PLANA \350\241\227\350\210\236\345\255\246\351\231\242\357\274\237</h4>\n          <p className=\"text-[10px] text-teal-50/90 leading-normal max-w-[85%] mt-1\">\n            \344\275\234\344\270\272\351\253\230\347\253\257\350\277\236\351\224\201\350\241\227\350\210\236\346\275\256\345\245\242\346\275\256\347\211\214\357\274\214PLANA\346\261\207\350\201\232\345\205\250\345\233\275\351\241\266\345\260\226\346\210\230\351\230\237\346\240\270\345\277\203\350\210\236\350\200\205\343\200\202\350\246\206\347\233\226 JAZZ (\347\210\265\345\243\253)\343\200\201HIPHOP (\350\241\227\350\210\236)\343\200\201URBAN CHOREO (\351\203\275\345\270\202\347\274\226\350\210\236)\347\255\211\347\203\255\351\227\250\351\227\250\347\261\273\343\200\202\350\277\231\351\207\214\344\270\215\344\273\205\346\230\257\346\261\227\346\260\264\346\214\245\346\264\222\345\234\260\357\274\214\346\233\264\346\230\257\346\227\266\345\260\232\350\241\227\350\210\236\346\226\207\345\214\226\347\244\276\345\214\272\343\200\202\n          </p>\n          <button\n            onClick={() => {\n              onSuggestTab(\'schedule\');\n              addToast(\'\347\216\260\345\234\250\351\242\204\350\256\242\347\254\254\344\270\200\345\240\202\345\205\215\350\264\271\344\275\223\351\252\214\350\257\276\345\220\247\357\274\201\', \'success\');\n            }}\n            className=\"mt-3.5 px-3 py-1 bg-white hover:bg-teal-50 text-teal-600 rounded-full text-[10px] font-extrabold tracking-tight transition\"\n          >\n            \345\274\200\345\220\257\344\275\223\351\252\214\350\257\276 &rarr;\n          </button>\n        </div>\n      </div>\n\n      {/* 5. Featured wraps feedback videos */}\n      <div className=\"mt-5\" id=\"home-featured-videos\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-sm font-extrabold text-slate-800 uppercase tracking-tight flex items-center\">\n            <Film className=\"w-4 h-4 text-teal-500 mr-1\" />\n            \345\211\215\346\262\277\350\257\276\345\240\202\347\265\220\350\252\262\345\217\215\351\246\210 / Video Showcase\n          </h3>\n          <span className=\"text-[10px] text-slate-400 font-mono\">\350\247\206\351\242\221\346\225\231\345\255\246</span>\n        </div>\n\n        {/* Video grids cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {MOCK_VIDEOS.map((video) => (\n            <div\n              key={video.id}\n              onClick={() => {\n                setActiveVideoId(video.id);\n                addToast(`\346\255\243\345\234\250\346\213\211\345\217\226\350\257\276\345\240\202\345\217\215\351\246\210\347\237\255\347\211\207: ${video.title}`, \'info\');\n              }}\n              className=\"bg-white border border-slate-100 rounded-xl overflow-hidden cursor-pointer group hover:shadow transition\"\n            >\n              {/* Cover cover ratio */}\n              <div className=\"relative h-24 bg-slate-900 overflow-hidden\">\n                <img\n                  src={video.cover}\n                  alt={video.title}\n                  className=\"w-full h-full object-cover opacity-85 group-hover:scale-105 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                  <span className=\"w-8 h-8 rounded-full bg-white/40 backdrop-blur-xs flex items-center justify-center text-white scale-95 group-hover:scale-105 transition\">\n                    <Play className=\"w-4.5 h-4.5 fill-white ml-0.5\" />\n                  </span>\n                </div>\n                <span className=\"absolute bottom-1 right-1.5 bg-black/60 text-white text-[9px] px-1 rounded-sm font-mono leading-relaxed\">\n                  {video.duration}\n                </span>\n              </div>\n\n              {/* Title description bar */}\n              <div className=\"p-2 leading-tight\">\n                <p className=\"text-xs font-bold text-slate-800 line-clamp-2 h-8 leading-snug\">\n                  {video.title}\n                </p>\n                <div className=\"flex items-center justify-between text-[10px] text-slate-400 mt-1 font-mono\">\n                  <span>{video.plays} \346\222\255\346\224\276</span>\n                  <span className=\"flex items-center\">\n                    <Heart className=\"w-2.5 h-2.5 text-rose-400 fill-rose-300 mr-0.5\" />\n                    {video.likes}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ==================== DIALOG POPUP 1: VIDEO SIMULATION MODAL ==================== */}\n      <AnimatePresence>\n        {activeVideoId && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs\">\n            <div className=\"bg-slate-950 rounded-2xl w-full max-w-sm overflow-hidden text-center relative p-6 border border-slate-800\">\n              <button\n                onClick={() => setActiveVideoId(null)}\n                className=\"absolute top-3 right-3 text-white/70 hover:text-white\"\n              >\n                \342\234\225\n              </button>\n\n              <p className=\"text-[10px] text-teal-400 font-bold uppercase tracking-wider font-mono\">\n                PLANA CLASS VIDEO PLAYER\n              </p>\n              <h4 className=\"text-sm font-bold text-white mt-1 mb-4 leading-snug px-3\">\n                {MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.title}\n              </h4>\n\n              {/* Dynamic video simulated display with progress bar */}\n              <div className=\"relative h-44 bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center mb-4 border border-slate-800\">\n                <img\n                  src={MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.cover}\n                  alt=\"feedback\"\n                  className=\"w-full h-full object-cover opacity-60 animate-pulse\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex flex-col justify-center items-center\">\n                  <Play className=\"w-12 h-12 text-teal-400 fill-teal-400 animate-ping opacity-75\" />\n                  <span className=\"text-white text-xs mt-3 bg-teal-500/80 px-3 py-1 rounded-full font-bold\">\n                    [ \346\255\243\345\234\250\346\274\224\347\244\272 4K \347\273\223\350\257\276\350\210\236\346\274\224\347\237\255\347\211\207 ]\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"text-xs text-slate-400 text-left bg-slate-900/60 p-3 rounded-lg border border-slate-900 space-y-1\">\n                <div>\342\200\242 \346\227\245\346\234\237: 2026-05-25 \346\225\231\345\255\246\346\262\211\346\267\200\347\247\200</div>\n                <div>\342\200\242 \351\205\215\344\271\220: High tempo bass music remix</div>\n                <div>\342\200\242 \347\274\226\346\216\222: \345\257\274\345\270\210\347\216\260\345\234\272\346\240\271\346\215\256\351\233\266\345\237\272\347\241\200\345\255\246\345\221\230\350\277\233\345\272\246\347\262\276\347\256\200\351\207\215\346\236\204</div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setActiveVideoId(null);\n                  onSuggestTab(\'schedule\');\n                  addToast(\'\345\267\262\345\274\225\345\257\274\350\277\233\345\205\245\351\200\211\350\257\276\350\241\250\357\274\201\', \'success\');\n                }}\n                className=\"mt-4 w-full py-2 bg-teal-500 hover:bg-teal-600 text-white text-xs font-bold rounded-xl shadow transition\"\n              >\n                \347\253\213\345\215\263\351\242\204\345\256\232\346\234\254\350\211\262\345\257\274\345\270\210\345\244\247\350\257\276\n              </button>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== DIALOG POPUP 2: TEACHER BIO MODAL ==================== */}\n      <AnimatePresence>\n        {selectedTeacher && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide click shut */}\n            <div\n              onClick={() => setSelectedTeacher(null)}\n              className=\"absolute inset-0 bg-black/60 backdrop-blur-xs\"\n            ></div>\n\n            {/* Slider bottom bio info */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className=\"relative bg-white rounded-t-3xl w-full max-w-sm max-h-[85vh] overflow-y-auto p-5 border-t border-slate-100 z-10 shadow-2xl\"\n            >\n              <div className=\"w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-4\"></div>\n\n              {/* Top main profile specs */}\n              <div className=\"flex items-start space-x-4\">\n                <img\n                  src={selectedTeacher.avatar}\n                  alt={selectedTeacher.name}\n                  className=\"w-16 h-16 rounded-full object-cover border-2 border-teal-500\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div>\n                  <h3 className=\"text-lg font-bold text-slate-800\">{selectedTeacher.name}</h3>\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-500 mt-0.5\">\n                    <span className=\"text-yellow-500 flex items-center font-bold\">\n                      \342\230\205 {selectedTeacher.rating.toFixed(1)}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-teal-600 font-semibold\">\351\246\226\346\216\250\345\220\215\345\270\210\345\257\274\345\270\210</span>\n                  </div>\n\n                  {/* Badges tags row */}\n                  <div className=\"flex flex-wrap gap-1 mt-1.5\">\n                    {selectedTeacher.tags.map((tag, idx) => (\n                      <span\n                        key={idx}\n                        className=\"bg-slate-50 text-slate-500 text-[9px] px-1.5 py-0.5 rounded-sm border border-slate-100 font-sans\"\n                      >\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Bio summary description paragraphs */}\n              <div className=\"mt-5 space-y-3\">\n                <div>\n                  <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\344\270\252\344\272\272\347\256\200\344\273\213 / Biography</h4>\n                  <p className=\"text-xs text-slate-600 mt-1 leading-relaxed\">\n                    {selectedTeacher.description}\n                  </p>\n                </div>\n\n                <div>\n                  <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\344\270\273\346\224\273\351\243\216\346\240\274 / Core Genres</h4>\n                  <p className=\"text-xs text-slate-600 mt-1\">\n                    Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250), Jazz Funk, Commercial Choreo (\345\260\221\345\204\277/\346\210\220\344\272\272\351\253\230\347\207\203\345\225\206\344\270\232\347\210\265\345\243\253), Lyrical isolations.\n                  </p>\n                </div>\n\n                <div className=\"bg-slate-50 rounded-xl p-3 border border-slate-100 mt-2 space-y-1.5\">\n                  <div className=\"text-xs text-slate-500 flex justify-between\">\n                    <span>\350\257\276\345\240\202\346\260\233\345\233\264\350\257\204\345\210\206:</span>\n                    <span className=\"font-bold text-slate-700\">9.9/10 Super Fun</span>\n                  </div>\n                  <div className=\"text-xs text-slate-500 flex justify-between\">\n                    <span>\346\234\200\345\217\227\345\226\234\347\210\261\351\243\216\346\240\274:</span>\n                    <span className=\"font-bold text-slate-700\">\345\237\272\347\241\200\347\210\206\345\217\221\351\232\224\347\246\273/Groove</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CTA call action booking */}\n              <div className=\"mt-5 space-y-2\">\n                <button\n                  onClick={() => {\n                    setSelectedTeacher(null);\n                    onSuggestTab(\'schedule\');\n                    addToast(`\345\267\262\344\270\272\346\202\250\347\255\233\351\200\211\345\257\274\345\270\210 ${selectedTeacher.name} \347\232\204\350\257\276\347\250\213`, \'info\');\n                  }}\n                  className=\"w-full py-2.5 bg-teal-50 hover:bg-teal-600 text-white text-xs font-bold rounded-xl transition shadow flex items-center justify-center space-x-1\"\n                >\n                  <span>\344\270\200\351\224\256\346\237\245\350\257\242\350\257\245\345\257\274\345\270\210\346\216\222\350\257\276\350\241\250</span>\n                </button>\n                <button\n                  onClick={() => setSelectedTeacher(null)}\n                  className=\"w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold rounded-xl transition\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>"
        replacement_content: "      {/* 4. Popular Instructors Section with biography click sheet */}\n      <div className=\"mt-5\" id=\"home-teachers-list\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-xs font-black text-indigo-900 uppercase tracking-tight flex items-center\">\n            <Star className=\"w-4 h-4 text-rose-500 mr-1 fill-rose-500\" />\n            \346\230\216\346\230\237\350\210\236\350\200\205\345\257\274\345\270\210 / Teachers\n          </h3>\n          <span className=\"text-[10px] text-indigo-400 font-bold font-sans\">\347\202\271\345\207\273\345\244\264\345\203\217\346\237\245\347\234\213\347\256\200\344\273\213</span>\n        </div>\n\n        {/* Horizontal rolling instructors avatars */}\n        <div className=\"flex space-x-3 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-none\">\n          {TEACHERS.map((teacher) => (\n            <button\n              key={teacher.id}\n              onClick={() => setSelectedTeacher(teacher)}\n              className=\"flex flex-col items-center shrink-0 w-16 group cursor-pointer\"\n            >\n              <div className=\"relative\">\n                <img\n                  src={teacher.avatar}\n                  alt={teacher.name}\n                  className=\"w-12.5 h-12.5 rounded-full object-cover border-2 border-white ring-2 ring-indigo-100 group-hover:ring-rose-500 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <span className=\"absolute bottom-0 right-0 bg-rose-500 text-white rounded-full p-0.5 text-[8px] leading-none text-center\">\n                  \342\234\223\n                </span>\n              </div>\n              <span className=\"text-xs font-black text-indigo-950 mt-1 pb-0.5 truncate max-w-full\">\n                {teacher.name}\n              </span>\n              <span className=\"text-[9px] text-indigo-400 font-bold leading-none truncate max-w-full\">\n                {teacher.tags[0].split(\' \')[0]}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* About PLANA branding message block with Vibrant Gradient */}\n      <div className=\"mt-5 p-5 rounded-3xl bg-gradient-to-br from-rose-500 to-orange-400 text-white relative overflow-hidden shadow-lg\">\n        <div className=\"absolute -top-10 -right-10 w-32 h-32 bg-white opacity-10 rounded-full\"></div>\n        <div className=\"absolute top-10 right-20 w-16 h-16 bg-yellow-300 opacity-20 rounded-full\"></div>\n        <div className=\"relative z-10\">\n          <span className=\"bg-yellow-400 text-indigo-900 px-3 py-1 rounded-full text-[9px] font-black uppercase mb-1.5 inline-block\">\n            FEATURED ACADEMY\n          </span>\n          <h4 className=\"font-extrabold text-base tracking-tight text-white mb-1\">\344\270\272\344\273\200\344\271\210\351\200\211\346\213\251 PLANA \350\241\227\350\210\236\345\255\246\351\231\242\357\274\237</h4>\n          <p className=\"text-[10px] text-white/90 leading-relaxed max-w-[88%] mt-1\">\n            \344\275\234\344\270\272\351\253\230\347\253\257\350\277\236\351\224\201\350\241\227\350\210\236\346\216\222\350\257\276\346\216\222\345\244\264\346\275\256\347\211\214\357\274\214PLANA\346\261\207\350\201\232\345\205\250\345\233\275\351\241\266\345\260\226\346\210\230\351\230\237\346\240\270\345\277\203\350\210\236\350\200\205\343\200\202\350\246\206\347\233\226 JAZZ (\347\210\265\345\243\253)\343\200\201HIPHOP (\350\241\227\350\210\236)\343\200\201URBAN (\351\203\275\345\270\202\347\274\226\350\210\236)\347\255\211\347\203\255\351\227\250\351\227\250\347\261\273\343\200\202\350\277\231\351\207\214\344\270\215\344\273\205\346\230\257\346\261\227\346\260\264\346\214\245\346\264\222\345\234\260\357\274\214\346\233\264\346\230\257\346\227\266\345\260\232\350\241\227\350\210\236\346\226\207\345\214\226\347\244\276\345\214\272\343\200\202\n          </p>\n          <button\n            onClick={() => {\n              onSuggestTab(\'schedule\');\n              addToast(\'\347\216\260\345\234\250\351\242\204\350\256\242\347\254\254\344\270\200\345\240\202\345\205\215\350\264\271\344\275\223\351\252\214\350\257\276\345\220\247\357\274\201\', \'success\');\n            }}\n            className=\"mt-4 px-4 py-2 bg-indigo-900 hover:bg-indigo-800 text-white rounded-full text-[10px] font-black tracking-tight transition shadow-md\"\n          >\n            \345\274\200\345\220\257\344\275\223\351\252\214\350\257\276 &rarr;\n          </button>\n        </div>\n      </div>\n\n      {/* 5. Featured wraps feedback videos */}\n      <div className=\"mt-5\" id=\"home-featured-videos\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-xs font-black text-indigo-900 uppercase tracking-tight flex items-center\">\n            <Film className=\"w-4 h-4 text-rose-500 mr-1\" />\n            \345\211\215\346\262\277\350\257\276\345\240\202\347\265\220\350\252\262\345\217\215\351\246\210 / Video Showcase\n          </h3>\n          <span className=\"text-[10px] text-indigo-400 font-bold\">\350\247\206\351\242\221\346\225\231\345\255\246</span>\n        </div>\n\n        {/* Video grids cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {MOCK_VIDEOS.map((video) => (\n            <div\n              key={video.id}\n              onClick={() => {\n                setActiveVideoId(video.id);\n                addToast(`\346\255\243\345\234\250\346\213\211\345\217\226\350\257\276\345\240\202\345\217\215\351\246\210\347\237\255\347\211\207: ${video.title}`, \'info\');\n              }}\n              className=\"bg-white border-2 border-indigo-100/50 rounded-2xl overflow-hidden cursor-pointer group hover:shadow-md transition duration-200\"\n            >\n              {/* Cover cover ratio */}\n              <div className=\"relative h-24 bg-slate-900 overflow-hidden\">\n                <img\n                  src={video.cover}\n                  alt={video.title}\n                  className=\"w-full h-full object-cover opacity-85 group-hover:scale-105 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                  <span className=\"w-8 h-8 rounded-full bg-rose-500/90 flex items-center justify-center text-white scale-95 group-hover:scale-105 transition\">\n                    <Play className=\"w-4.5 h-4.5 fill-white ml-0.5\" />\n                  </span>\n                </div>\n                <span className=\"absolute bottom-1 right-1.5 bg-indigo-900/90 text-white text-[9px] px-1.5 py-0.5 rounded-sm font-mono font-bold leading-relaxed\">\n                  {video.duration}\n                </span>\n              </div>\n\n              {/* Title description bar */}\n              <div className=\"p-2 leading-tight\">\n                <p className=\"text-xs font-black text-indigo-950 line-clamp-2 h-8 leading-snug\">\n                  {video.title}\n                </p>\n                <div className=\"flex items-center justify-between text-[10px] text-indigo-400 font-bold mt-1\">\n                  <span>{video.plays} \346\222\255\346\224\276</span>\n                  <span className=\"flex items-center text-rose-500\">\n                    <Heart className=\"w-2.5 h-2.5 text-rose-500 fill-rose-500 mr-0.5\" />\n                    {video.likes}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ==================== DIALOG POPUP 1: VIDEO SIMULATION MODAL ==================== */}\n      <AnimatePresence>\n        {activeVideoId && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-indigo-950/80 backdrop-blur-xs\">\n            <div className=\"bg-white rounded-3xl w-full max-w-sm overflow-hidden text-center relative p-6 border-4 border-yellow-400 shadow-2xl\">\n              <button\n                onClick={() => setActiveVideoId(null)}\n                className=\"absolute top-3 right-3 text-indigo-900/60 hover:text-indigo-900 font-black cursor-pointer\"\n              >\n                \342\234\225\n              </button>\n\n              <p className=\"text-[10px] text-rose-500 font-black uppercase tracking-wider font-sans\">\n                PLANA CLASS VIDEO PLAYER\n              </p>\n              <h4 className=\"text-sm font-black text-indigo-900 mt-1 mb-4 leading-snug px-3\">\n                {MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.title}\n              </h4>\n\n              {/* Dynamic video simulated display with progress bar */}\n              <div className=\"relative h-44 bg-indigo-950 rounded-2xl overflow-hidden flex items-center justify-center mb-4 border-2 border-indigo-100\">\n                <img\n                  src={MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.cover}\n                  alt=\"feedback\"\n                  className=\"w-full h-full object-cover opacity-60 animate-pulse\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex flex-col justify-center items-center\">\n                  <Play className=\"w-12 h-12 text-rose-500 fill-rose-500 animate-ping opacity-75\" />\n                  <span className=\"text-white text-[10px] mt-3 bg-indigo-900 px-3 py-1 rounded-full font-black uppercase tracking-wide\">\n                    [ \346\255\243\345\234\250\346\222\255\346\224\276 4K \347\273\223\350\257\276\350\210\236\346\274\224\347\237\255\347\211\207 ]\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"text-xs text-indigo-900 text-left bg-indigo-50/70 p-3.5 rounded-2xl border border-indigo-100/50 space-y-1 font-bold\">\n                <div>\342\200\242 \346\227\245\346\234\237: 2026-05-25 \346\225\231\345\255\246\346\262\211\346\267\200\347\247\200</div>\n                <div>\342\200\242 \351\205\215\344\271\220: High tempo bass music remix</div>\n                <div>\342\200\242 \347\274\226\346\216\222: \345\257\274\345\270\210\347\216\260\345\234\272\346\240\271\346\215\256\351\233\266\345\237\272\347\241\200\345\255\246\345\221\230\350\277\233\345\272\246\347\262\276\347\256\200\351\207\215\346\236\204</div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setActiveVideoId(null);\n                  onSuggestTab(\'schedule\');\n                  addToast(\'\345\267\262\345\274\225\345\257\274\350\277\233\345\205\245\351\200\211\350\257\276\350\241\250\357\274\201\', \'success\');\n                }}\n                className=\"mt-4 w-full py-2.5 bg-indigo-900 hover:bg-indigo-800 text-white text-xs font-black rounded-full shadow-lg transition duration-200 cursor-pointer\"\n              >\n                \347\253\213\345\215\263\351\242\204\345\256\232\346\234\254\350\211\262\345\257\274\345\270\210\345\244\247\350\257\276\n              </button>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== DIALOG POPUP 2: TEACHER BIO MODAL ==================== */}\n      <AnimatePresence>\n        {selectedTeacher && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide click shut */}\n            <div\n              onClick={() => setSelectedTeacher(null)}\n              className=\"absolute inset-0 bg-indigo-950/60 backdrop-blur-xs\"\n            ></div>\n\n            {/* Slider bottom bio info */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className=\"relative bg-white rounded-t-[32px] w-full max-w-sm max-h-[85vh] overflow-y-auto p-6 border-t-4 border-yellow-400 z-10 shadow-2xl text-indigo-950\"\n            >\n              <div className=\"w-12 h-1.5 bg-indigo-100 rounded-full mx-auto mb-4\"></div>\n\n              {/* Top main profile specs */}\n              <div className=\"flex items-start space-x-4\">\n                <img\n                  src={selectedTeacher.avatar}\n                  alt={selectedTeacher.name}\n                  className=\"w-16 h-16 rounded-full object-cover border-2 border-rose-500\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div>\n                  <h3 className=\"text-base font-black text-indigo-900\">{selectedTeacher.name}</h3>\n                  <div className=\"flex items-center space-x-1.5 text-xs text-indigo-400 mt-0.5 font-bold\">\n                    <span className=\"text-rose-500 flex items-center font-black\">\n                      \342\230\205 {selectedTeacher.rating.toFixed(1)}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-indigo-900 font-extrabold text-[11px] bg-yellow-300 px-1.5 py-0.5 rounded\">\351\246\226\346\216\250\345\220\215\345\270\210\345\257\274\345\270\210</span>\n                  </div>\n\n                  {/* Badges tags row */}\n                  <div className=\"flex flex-wrap gap-1 mt-1.5\">\n                    {selectedTeacher.tags.map((tag, idx) => (\n                      <span\n                        key={idx}\n                        className=\"bg-indigo-50 text-indigo-900 text-[9px] font-bold px-1.5 py-0.5 rounded-sm border border-indigo-100\"\n                      >\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Bio summary description paragraphs */}\n              <div className=\"mt-5 space-y-3\">\n                <div>\n                  <h4 className=\"text-[10px] font-black text-indigo-400 uppercase tracking-wider\">\344\270\252\344\272\272\347\256\200\344\273\213 / Biography</h4>\n                  <p className=\"text-xs text-indigo-950/80 mt-1 leading-relaxed font-bold\">\n                    {selectedTeacher.description}\n                  </p>\n                </div>\n\n                <div>\n                  <h4 className=\"text-[10px] font-black text-indigo-400 uppercase tracking-wider\">\344\270\273\346\224\273\351\243\216\346\240\274 / Core Genres</h4>\n                  <p className=\"text-xs text-indigo-950/85 font-bold mt-1\">\n                    Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250), Jazz Funk, Commercial Choreo (\345\260\221\345\204\277/\346\210\220\344\272\272\351\253\230\347\207\203\345\225\206\344\270\232\347\210\265\345\243\253), Lyrical isolations.\n                  </p>\n                </div>\n\n                <div className=\"bg-indigo-50/70 rounded-2xl p-4 border border-indigo-100 mt-2 space-y-1.5 font-bold text-xs\">\n                  <div className=\"text-indigo-900 flex justify-between\">\n                    <span>\350\257\276\345\240\202\346\260\233\345\233\264\350\257\204\345\210\206:</span>\n                    <span className=\"font-black text-rose-500\">9.9/10 Super Fun</span>\n                  </div>\n                  <div className=\"text-indigo-900 flex justify-between\">\n                    <span>\346\234\200\345\217\227\345\226\234\347\210\261\351\243\216\346\240\274:</span>\n                    <span className=\"font-bold text-indigo-950\">\345\237\272\347\241\200\347\210\206\345\217\221\351\232\224\347\246\273/Groove</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CTA call action booking */}\n              <div className=\"mt-5 space-y-2\">\n                <button\n                  onClick={() => {\n                    setSelectedTeacher(null);\n                    onSuggestTab(\'schedule\');\n                    addToast(`\345\267\262\344\270\272\346\202\250\347\255\233\351\200\211\345\257\274\345\270\210 ${selectedTeacher.name} \347\232\204\350\257\276\347\250\213`, \'info\');\n                  }}\n                  className=\"w-full py-2.5 bg-indigo-900 hover:bg-indigo-800 text-white text-xs font-black rounded-full transition shadow-md flex items-center justify-center space-x-1 cursor-pointer\"\n                >\n                  <span>\344\270\200\351\224\256\346\237\245\350\257\242\350\257\245\345\257\274\345\270\210\346\216\222\350\257\276\350\241\250</span>\n                </button>\n                <button\n                  onClick={() => setSelectedTeacher(null)}\n                  className=\"w-full py-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-900 text-xs font-black rounded-full transition cursor-pointer\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>"
      }
      fuzzy_match: "d mt-0.5\">\345\211\251\344\275\231\346\254\241\345\215\241\350\277\233\345\272\246</span>\n        </button>\n      </div>\n\n      {/* 4. Popular Instructors Section with biography click sheet */}\n      <div className=\"mt-5\" id=\"home-teachers-list\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-sm font-extrabold text-slate-800 uppercase tracking-tight flex items-center\">\n            <Star className=\"w-4 h-4 text-yellow-500 mr-1 fill-yellow-400\" />\n            \346\230\216\346\230\237\350\210\236\350\200\205\345\257\274\345\270\210 / Teachers\n          </h3>\n          <span className=\"text-[10px] text-slate-400 font-mono\">\347\202\271\345\207\273\345\244\264\345\203\217\346\237\245\347\234\213\347\256\200\344\273\213</span>\n        </div>\n\n        {/* Horizontal rolling instructors avatars */}\n        <div className=\"flex space-x-3 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-none\">\n          {TEACHERS.map((teacher) => (\n            <button\n              key={teacher.id}\n              onClick={() => setSelectedTeacher(teacher)}\n              className=\"flex flex-col items-center shrink-0 w-16 group\"\n            >\n              <div className=\"relative\">\n                <img\n                  src={teacher.avatar}\n                  alt={teacher.name}\n                  className=\"w-12.5 h-12.5 rounded-full object-cover border-2 border-white ring-2 ring-slate-100 group-hover:ring-teal-500 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <span className=\"absolute bottom-0 right-0 bg-teal-500 text-white rounded-full p-0.5 text-[8px] leading-none text-center\">\n                  \342\234\223\n                </span>\n              </div>\n              <span className=\"text-xs font-bold text-slate-700 mt-1 pb-0.5 truncate max-w-full\">\n                {teacher.name}\n              </span>\n              <span className=\"text-[9px] text-slate-400 leading-none truncate max-w-full\">\n                {teacher.tags[0].split(\' \')[0]}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* About PLANA branding message block */}\n      <div className=\"mt-5 p-4 rounded-2xl bg-gradient-to-br from-teal-500 to-cyan-600 text-white relative overflow-hidden shadow-xs\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 opacity-15 text-white\">\n          <Award className=\"w-32 h-32\" />\n        </div>\n        <div className=\"relative z-10\">\n          <h4 className=\"font-extrabold text-sm tracking-tight text-white mb-0.5\">\344\270\272\344\273\200\344\271\210\351\200\211\346\213\251 PLANA \350\241\227\350\210\236\345\255\246\351\231\242\357\274\237</h4>\n          <p className=\"text-[10px] text-teal-50/90 leading-normal max-w-[85%] mt-1\">\n            \344\275\234\344\270\272\351\253\230\347\253\257\350\277\236\351\224\201\350\241\227\350\210\236\346\275\256\345\245\242\346\275\256\347\211\214\357\274\214PLANA\346\261\207\350\201\232\345\205\250\345\233\275\351\241\266\345\260\226\346\210\230\351\230\237\346\240\270\345\277\203\350\210\236\350\200\205\343\200\202\350\246\206\347\233\226 JAZZ (\347\210\265\345\243\253)\343\200\201HIPHOP (\350\241\227\350\210\236)\343\200\201URBAN CHOREO (\351\203\275\345\270\202\347\274\226\350\210\236)\347\255\211\347\203\255\351\227\250\351\227\250\347\261\273\343\200\202\350\277\231\351\207\214\344\270\215\344\273\205\346\230\257\346\261\227\346\260\264\346\214\245\346\264\222\345\234\260\357\274\214\346\233\264\346\230\257\346\227\266\345\260\232\350\241\227\350\210\236\346\226\207\345\214\226\347\244\276\345\214\272\343\200\202\n          </p>\n          <button\n            onClick={() => {\n              onSuggestTab(\'schedule\');\n              addToast(\'\347\216\260\345\234\250\351\242\204\350\256\242\347\254\254\344\270\200\345\240\202\345\205\215\350\264\271\344\275\223\351\252\214\350\257\276\345\220\247\357\274\201\', \'success\');\n            }}\n            className=\"mt-3.5 px-3 py-1 bg-white hover:bg-teal-50 text-teal-600 rounded-full text-[10px] font-extrabold tracking-tight transition\"\n          >\n            \345\274\200\345\220\257\344\275\223\351\252\214\350\257\276 &rarr;\n          </button>\n        </div>\n      </div>\n\n      {/* 5. Featured wraps feedback videos */}\n      <div className=\"mt-5\" id=\"home-featured-videos\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-sm font-extrabold text-slate-800 uppercase tracking-tight flex items-center\">\n            <Film className=\"w-4 h-4 text-teal-500 mr-1\" />\n            \345\211\215\346\262\277\350\257\276\345\240\202\347\265\220\350\252\262\345\217\215\351\246\210 / Video Showcase\n          </h3>\n          <span className=\"text-[10px] text-slate-400 font-mono\">\350\247\206\351\242\221\346\225\231\345\255\246</span>\n        </div>\n\n        {/* Video grids cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {MOCK_VIDEOS.map((video) => (\n            <div\n              key={video.id}\n              onClick={() => {\n                setActiveVideoId(video.id);\n                addToast(`\346\255\243\345\234\250\346\213\211\345\217\226\350\257\276\345\240\202\345\217\215\351\246\210\347\237\255\347\211\207: ${video.title}`, \'info\');\n              }}\n              className=\"bg-white border border-slate-100 rounded-xl overflow-hidden cursor-pointer group hover:shadow transition\"\n            >\n              {/* Cover cover ratio */}\n              <div className=\"relative h-24 bg-slate-900 overflow-hidden\">\n                <img\n                  src={video.cover}\n                  alt={video.title}\n                  className=\"w-full h-full object-cover opacity-85 group-hover:scale-105 transition-all duration-200\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                  <span className=\"w-8 h-8 rounded-full bg-white/40 backdrop-blur-xs flex items-center justify-center text-white scale-95 group-hover:scale-105 transition\">\n                    <Play className=\"w-4.5 h-4.5 fill-white ml-0.5\" />\n                  </span>\n                </div>\n                <span className=\"absolute bottom-1 right-1.5 bg-black/60 text-white text-[9px] px-1 rounded-sm font-mono leading-relaxed\">\n                  {video.duration}\n                </span>\n              </div>\n\n              {/* Title description bar */}\n              <div className=\"p-2 leading-tight\">\n                <p className=\"text-xs font-bold text-slate-800 line-clamp-2 h-8 leading-snug\">\n                  {video.title}\n                </p>\n                <div className=\"flex items-center justify-between text-[10px] text-slate-400 mt-1 font-mono\">\n                  <span>{video.plays} \346\222\255\346\224\276</span>\n                  <span className=\"flex items-center\">\n                    <Heart className=\"w-2.5 h-2.5 text-rose-400 fill-rose-300 mr-0.5\" />\n                    {video.likes}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ==================== DIALOG POPUP 1: VIDEO SIMULATION MODAL ==================== */}\n      <AnimatePresence>\n        {activeVideoId && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs\">\n            <div className=\"bg-slate-950 rounded-2xl w-full max-w-sm overflow-hidden text-center relative p-6 border border-slate-800\">\n              <button\n                onClick={() => setActiveVideoId(null)}\n                className=\"absolute top-3 right-3 text-white/70 hover:text-white\"\n              >\n                \342\234\225\n              </button>\n\n              <p className=\"text-[10px] text-teal-400 font-bold uppercase tracking-wider font-mono\">\n                PLANA CLASS VIDEO PLAYER\n              </p>\n              <h4 className=\"text-sm font-bold text-white mt-1 mb-4 leading-snug px-3\">\n                {MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.title}\n              </h4>\n\n              {/* Dynamic video simulated display with progress bar */}\n              <div className=\"relative h-44 bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center mb-4 border border-slate-800\">\n                <img\n                  src={MOCK_VIDEOS.find((v) => v.id === activeVideoId)?.cover}\n                  alt=\"feedback\"\n                  className=\"w-full h-full object-cover opacity-60 animate-pulse\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 flex flex-col justify-center items-center\">\n                  <Play className=\"w-12 h-12 text-teal-400 fill-teal-400 animate-ping opacity-75\" />\n                  <span className=\"text-white text-xs mt-3 bg-teal-500/80 px-3 py-1 rounded-full font-bold\">\n                    [ \346\255\243\345\234\250\346\274\224\347\244\272 4K \347\273\223\350\257\276\350\210\236\346\274\224\347\237\255\347\211\207 ]\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"text-xs text-slate-400 text-left bg-slate-900/60 p-3 rounded-lg border border-slate-900 space-y-1\">\n                <div>\342\200\242 \346\227\245\346\234\237: 2026-05-25 \346\225\231\345\255\246\346\262\211\346\267\200\347\247\200</div>\n                <div>\342\200\242 \351\205\215\344\271\220: High tempo bass music remix</div>\n                <div>\342\200\242 \347\274\226\346\216\222: \345\257\274\345\270\210\347\216\260\345\234\272\346\240\271\346\215\256\351\233\266\345\237\272\347\241\200\345\255\246\345\221\230\350\277\233\345\272\246\347\262\276\347\256\200\351\207\215\346\236\204</div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setActiveVideoId(null);\n                  onSuggestTab(\'schedule\');\n                  addToast(\'\345\267\262\345\274\225\345\257\274\350\277\233\345\205\245\351\200\211\350\257\276\350\241\250\357\274\201\', \'success\');\n                }}\n                className=\"mt-4 w-full py-2 bg-teal-500 hover:bg-teal-600 text-white text-xs font-bold rounded-xl shadow transition\"\n              >\n                \347\253\213\345\215\263\351\242\204\345\256\232\346\234\254\350\211\262\345\257\274\345\270\210\345\244\247\350\257\276\n              </button>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== DIALOG POPUP 2: TEACHER BIO MODAL ==================== */}\n      <AnimatePresence>\n        {selectedTeacher && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide click shut */}\n            <div\n              onClick={() => setSelectedTeacher(null)}\n              className=\"absolute inset-0 bg-black/60 backdrop-blur-xs\"\n            ></div>\n\n            {/* Slider bottom bio info */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className=\"relative bg-white rounded-t-3xl w-full max-w-sm max-h-[85vh] overflow-y-auto p-5 border-t border-slate-100 z-10 shadow-2xl\"\n            >\n              <div className=\"w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-4\"></div>\n\n              {/* Top main profile specs */}\n              <div className=\"flex items-start space-x-4\">\n                <img\n                  src={selectedTeacher.avatar}\n                  alt={selectedTeacher.name}\n                  className=\"w-16 h-16 rounded-full object-cover border-2 border-teal-500\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div>\n                  <h3 className=\"text-lg font-bold text-slate-800\">{selectedTeacher.name}</h3>\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-500 mt-0.5\">\n                    <span className=\"text-yellow-500 flex items-center font-bold\">\n                      \342\230\205 {selectedTeacher.rating.toFixed(1)}\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-teal-600 font-semibold\">\351\246\226\346\216\250\345\220\215\345\270\210\345\257\274\345\270\210</span>\n                  </div>\n\n                  {/* Badges tags row */}\n                  <div className=\"flex flex-wrap gap-1 mt-1.5\">\n                    {selectedTeacher.tags.map((tag, idx) => (\n                      <span\n                        key={idx}\n                        className=\"bg-slate-50 text-slate-500 text-[9px] px-1.5 py-0.5 rounded-sm border border-slate-100 font-sans\"\n                      >\n                        {tag}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Bio summary description paragraphs */}\n              <div className=\"mt-5 space-y-3\">\n                <div>\n                  <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\344\270\252\344\272\272\347\256\200\344\273\213 / Biography</h4>\n                  <p className=\"text-xs text-slate-600 mt-1 leading-relaxed\">\n                    {selectedTeacher.description}\n                  </p>\n                </div>\n\n                <div>\n                  <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\344\270\273\346\224\273\351\243\216\346\240\274 / Core Genres</h4>\n                  <p className=\"text-xs text-slate-600 mt-1\">\n                    Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250), Jazz Funk, Commercial Choreo (\345\260\221\345\204\277/\346\210\220\344\272\272\351\253\230\347\207\203\345\225\206\344\270\232\347\210\265\345\243\253), Lyrical isolations.\n                  </p>\n                </div>\n\n                <div className=\"bg-slate-50 rounded-xl p-3 border border-slate-100 mt-2 space-y-1.5\">\n                  <div className=\"text-xs text-slate-500 flex justify-between\">\n                    <span>\350\257\276\345\240\202\346\260\233\345\233\264\350\257\204\345\210\206:</span>\n                    <span className=\"font-bold text-slate-700\">9.9/10 Super Fun</span>\n                  </div>\n                  <div className=\"text-xs text-slate-500 flex justify-between\">\n                    <span>\346\234\200\345\217\227\345\226\234\347\210\261\351\243\216\346\240\274:</span>\n                    <span className=\"font-bold text-slate-700\">\345\237\272\347\241\200\347\210\206\345\217\221\351\232\224\347\246\273/Groove</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CTA call action booking */}\n              <div className=\"mt-5 space-y-2\">\n                <button\n                  onClick={() => {\n                    setSelectedTeacher(null);\n                    onSuggestTab(\'schedule\');\n                    addToast(`\345\267\262\344\270\272\346\202\250\347\255\233\351\200\211\345\257\274\345\270\210 ${selectedTeacher.name} \347\232\204\350\257\276\347\250\213`, \'info\');\n                  }}\n                  className=\""
