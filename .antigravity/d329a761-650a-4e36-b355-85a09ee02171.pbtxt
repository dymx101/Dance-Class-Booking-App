    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"flex-1 overflow-y-auto px-4 pb-20 pt-4 bg-[#0c0d14]\" id=\"schedule-container\">\n      {/* Header section with PLANA selection and Tab slider */}\n      <div className=\"flex items-center justify-between pb-3 border-b border-white/5 mb-3\">\n        <div className=\"flex items-center space-x-2\" id=\"studio-selector\">\n          <div className=\"w-5 h-5 rounded-lg bg-gradient-to-tr from-pink-500 to-rose-600 flex items-center justify-center text-white text-[10px] font-black tracking-tighter\">\n            P\n          </div>\n          <span className=\"font-extrabold text-zinc-200 text-xs\">\346\255\246\346\261\211\350\241\227\351\201\223\345\217\243\346\227\227\350\210\260\345\272\227</span>\n        </div>\n\n        {/* Day / Week scheduler toggle tabs */}\n        <div className=\"bg-white/5 border border-white/5 p-0.5 rounded-full flex text-[10px] font-black\" id=\"mode-selector\">\n          <button\n            onClick={() => setViewMode(\'day\')}\n            className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n              viewMode === \'day\'\n                ? \'bg-rose-500 text-white shadow-md\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n          >\n            \346\227\245\350\257\276\350\241\250\n          </button>\n          <button\n            onClick={() => setViewMode(\'week\')}\n            className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n              viewMode === \'week\'\n                ? \'bg-rose-500 text-white shadow-md\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n          >\n            \345\221\250\350\257\276\350\241\250\n          </button>\n        </div>\n      </div>\n\n      {viewMode === \'day\' ? (\n        /* =================== DAILY VIEW INTERFACE =================== */\n        <div>\n          {/* Main Course filters: Group (\345\233\242\350\257\276) | Private (\347\247\201\346\225\231) | Series (\347\217\255\350\257\276) */}\n          <div className=\"flex items-center justify-between mt-2 mb-2.5\">\n            <div className=\"bg-white/5 border border-white/5 p-1 rounded-xl flex space-x-1 shrink-0\">\n              <button\n                onClick={() => setActiveCourseType(\'group\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'group\'\n                    ? \'bg-rose-500 text-white shadow\'\n                    : \'text-zinc-400 hover:text-white hover:bg-white/5\'\n                }`}\n                id=\"btn-group-class\"\n              >\n                \345\233\242\350\257\276\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'private\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'private\'\n                    ? \'bg-rose-500 text-white shadow\'\n                    : \'text-zinc-400 hover:text-white hover:bg-white/5\'\n                }`}\n                id=\"btn-private-class\"\n              >\n                \347\247\201\346\225\231\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'series\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'series\'\n                    ? \'bg-rose-500 text-white shadow\'\n                    : \'text-zinc-400 hover:text-white hover:bg-white/5\'\n                }`}\n                id=\"btn-series-class\"\n              >\n                \347\217\255\350\257\276\n              </button>\n            </div>\n\n            {/* Quick action actions: Bookable switch & Month Calendar Icon */}\n            <div className=\"flex items-center space-x-3\">\n              <label className=\"flex items-center cursor-pointer select-none\" id=\"toggle-bookable\">\n                <span className=\"text-[11px] font-extrabold text-zinc-400 mr-1.5\">\345\217\257\347\272\246</span>\n                <div className=\"relative\">\n                  <input\n                    type=\"checkbox\"\n                    checked={onlyBookable}\n                    onChange={(e) => setOnlyBookable(e.target.checked)}\n                    className=\"sr-only\"\n                  />\n                  <div className={`w-8 h-4.5 rounded-full transition-colors ${onlyBookable ? \'bg-rose-500\' : \'bg-zinc-800\'}`}></div>\n                  <div className={`absolute top-0.5 left-0.5 bg-white w-3.5 h-3.5 rounded-full transition-transform ${onlyBookable ? \'translate-x-3.5\' : \'translate-x-0\'}`}></div>\n                </div>\n              </label>\n\n              <button\n                onClick={() => setIsCalendarOpen(true)}\n                className=\"w-8 h-8 rounded-full border border-white/5 bg-white/5 flex items-center justify-center text-zinc-300 hover:text-rose-400 hover:bg-white/10 shadow-sm cursor-pointer transition-colors\"\n                title=\"\351\200\211\346\213\251\346\227\245\346\234\237\"\n                id=\"btn-open-calendar\"\n              >\n                <Calendar className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Scrolling dates carousel row */}\n          <div className=\"flex items-center space-x-1.5 overflow-x-auto pb-2 mt-2 -mx-4 px-4 scrollbar-none\" id=\"date-carousel\">\n            {CAROUSEL_DATES.map((item) => {\n              const isSelected = selectedDateStr === item.dateStr;\n              return (\n                <button\n                  key={item.dateStr}\n                  onClick={() => setSelectedDateStr(item.dateStr)}\n                  className={`flex flex-col items-center justify-center p-2 rounded-2xl min-w-11 transition-all cursor-pointer ${\n                    isSelected\n                      ? \'bg-gradient-to-tr from-pink-500 to-rose-600 text-white shadow-lg border-b-2 border-rose-400 scale-105 font-bold\'\n                      : \'bg-white/5 hover:bg-white/10 text-zinc-400 border border-white/5 font-semibold\'\n                  }`}\n                >\n                  <span className={`text-[9px] font-extrabold ${isSelected ? \'text-rose-100\' : \'text-zinc-500\'}`}>\n                    {item.name}\n                  </span>\n                  <span className=\"text-xs font-black mt-0.5\">\n                    {item.displayDate}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Filter button and label summaries */}\n          <div className=\"flex items-center justify-between mt-3 mb-2 px-0.5\">\n            <div className=\"text-[10px] text-zinc-500 font-bold tracking-wide\">\n              {(filterRoom !== \'\345\205\250\351\203\250\346\225\231\345\256\244\' || filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\') ? (\n                <span className=\"text-rose-400 flex items-center bg-rose-500/10 px-2.5 py-0.5 rounded-full border border-rose-500/20\">\n                  <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5 animate-ping\"></span>\n                  \345\267\262\347\255\233\351\200\211: {filterRoom} \342\200\242 {filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\' ? TEACHERS.find(t=>t.id===filterTeacherId)?.name : \'\345\205\250\351\203\250\350\200\201\345\270\210\'}\n                </span>\n              ) : (\n                <span>\345\205\250\351\203\250\350\257\276\347\250\213\350\256\241\345\210\222\345\210\227\350\241\250</span>\n              )}\n            </div>\n\n            <button\n              onClick={openFilterDrawer}\n              className=\"flex items-center text-zinc-300 hover:text-rose-400 hover:bg-white/10 text-[11px] px-3 py-1 bg-[#13141f] border border-white/5 rounded-full font-black shadow-sm cursor-pointer transition-colors\"\n              id=\"btn-filter-drawer\"\n            >\n              <Filter className=\"w-3 h-3 mr-1 text-rose-500\" />\n              <span>\347\255\233\351\200\211</span>\n            </button>\n          </div>\n\n          {/* Cards List container with Empty Stage conditions */}\n          <div className=\"space-y-3 mt-2\" id=\"daily-classes-list\">\n            {finalFilteredClasses.length === 0 ? (\n              <div className=\"bg-[#13141f] rounded-[32px] p-8 border border-white/5 text-center flex flex-col items-center justify-center shadow-lg\" id=\"empty-state\">\n                <div className=\"w-14 h-14 bg-white/5 rounded-2xl flex items-center justify-center text-zinc-500 mb-4 border border-white/5\">\n                  <Layers className=\"w-6 h-6 text-zinc-400\" />\n                </div>\n                <p className=\"text-white font-extrabold text-sm\">\346\232\202\346\227\240\350\257\276\347\250\213\344\277\241\346\201\257\357\274\214\345\205\210\347\234\213\347\234\213\345\210\253\347\232\204\345\220\247</p>\n                <p className=\"text-xs text-zinc-500 mt-1.5 mb-4 font-bold font-mono\">\346\234\200\350\277\221\345\217\257\347\272\246\351\241\271\347\233\256\344\270\272: 2026-05-25 (\344\273\212\346\227\245)</p>\n                <button\n                  onClick={() => {\n                    setSelectedDateStr(\'2026-05-25\');\n                    setFilterRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n                    setFilterTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n                    setActiveCourseType(\'group\');\n                  }}\n                  className=\"px-5 py-2.5 bg-rose-500 hover:bg-rose-600 text-white rounded-full text-xs font-black shadow-lg cursor-pointer transition duration-300 shadow-rose-500/10\"\n                  id=\"btn-back-to-today\"\n                >\n                  \347\253\213\345\215\263\351\242\204\347\272\246 (\347\234\213\344\273\212\345\244\251\345\244\247\350\257\276)\n                </button>\n              </div>\n            ) : (\n              finalFilteredClasses.map((cls) => {\n                const ended = isClassPassed(cls);\n                const isBooked = bookedClassIds.includes(cls.id);\n                const isWaiting = waitlistClassIds.includes(cls.id);\n                const isFull = cls.bookedCount >= cls.maxCount;\n\n                return (\n                  <div\n                    key={cls.id}\n                    className={`bg-[#13141f] rounded-[24px] border border-white/5 transition-all duration-300 overflow-hidden ${\n                      isBooked\n                        ? \'border-rose-500 shadow-md bg-rose-500/5\'\n                        : isWaiting\n                        ? \'border-violet-500 shadow-md bg-violet-500/5\'\n                        : \'hover:border-white/10 shadow-sm\'\n                    }`}\n                  >\n                    {/* Top cyan hour panel tag */}\n                    <div className=\"bg-[#181926]/90 px-4 py-1.5 border-b border-white/5 flex items-center justify-between\">\n                      <span className=\"text-xs text-rose-455 text-rose-400 font-black font-mono\">\n                        {cls.timeStart} ~ {cls.timeEnd}\n                      </span>\n                      <span className=\"text-[9px] uppercase font-black text-rose-300 tracking-widest font-mono\">\n                        {cls.genre} Style\n                      </span>\n                    </div>\n\n                    <div className=\"p-4 flex items-start space-x-3.5\">\n                      {/* Teacher Round Avatar */}\n                      <div className=\"relative shrink-0\">\n                        <img\n                          src={cls.teacher.avatar}\n                          alt={cls.teacher.name}\n                          className=\"w-12 h-12 rounded-2xl object-cover border border-white/10\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                        <span className=\"absolute -bottom-1 -right-1 bg-rose-500 text-white text-[8px] px-1 rounded font-black border border-[#13141f]\">\n                          {cls.teacher.rating.toFixed(1)}\n                        </span>\n                      </div>\n\n                      {/* Main Center specs of Class */}\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center space-x-1.5 flex-wrap\">\n                          <h3 className=\"font-extrabold text-white text-sm tracking-tight truncate leading-tight\">\n                            {cls.title}\n                          </h3>\n                        </div>\n\n                        {/* Dance genre text styled */}\n                        <div className=\"flex items-center text-xs text-zinc-400 mt-1 space-x-1 font-sans font-medium\">\n                          <span className=\"text-zinc-100 font-bold\">{cls.teacher.name}</span>\n                          <span className=\"text-zinc-500\">\342\200\242</span>\n                          <span className=\"capitalize text-zinc-300\">{cls.genre}</span>\n                          <span className=\"text-zinc-500\">\342\200\242</span>\n                          <span className=\"flex items-center\">\n                            \351\232\276\345\272\246 {renderStars(cls.difficulty)}\n                          </span>\n                        </div>\n\n                        {/* Booking classroom and capacity ratios */}\n                        <div className=\"text-[11px] text-zinc-500 mt-1 font-mono space-y-0.5 font-bold\">\n                          <div>{cls.classroom} \342\200\242 \346\273\241{cls.minPeople}\344\272\272\345\274\200\350\257\276</div>\n                          <div className=\"flex items-center mt-1\">\n                            <span className=\"mr-1.5\">\345\267\262\351\242\204\347\272\246:</span>\n                            <span className={`font-black ${isFull ? \'text-rose-455 text-rose-400\' : \'text-zinc-200\'}`}>\n                              {cls.bookedCount}\n                            </span>\n                            <span className=\"text-zinc-600 mx-0.5\">/</span>\n                            <span>{cls.maxCount}\344\272\272</span>\n\n                            {isFull && (\n                              <span className=\"ml-2 bg-rose-500/10 text-rose-400 text-[8px] font-black tracking-wider px-1.5 py-0.5 rounded border border-rose-500/20 leading-none\">\n                                \346\273\241\345\221\230\345\200\231\350\241\245\n                              </span>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* Side Actions buttons */}\n                      <div className=\"shrink-0 flex flex-col justify-center items-end h-full self-center\">\n                        {ended ? (\n                          <div className=\"bg-zinc-800 text-zinc-500 text-[11px] px-4 py-2 rounded-full font-bold select-none cursor-not-allowed border border-white/5\">\n                            \345\267\262\347\273\223\346\235\237\n                          </div>\n                        ) : cls.openBookingTime ? (\n                          <div className=\"flex flex-col items-end\">\n                            <span className=\"text-[8px] text-pink-400 font-extrabold mb-1 font-mono bg-pink-500/10 border border-pink-500/20 px-1.5 py-0.5 rounded\">\n                              {cls.openBookingTime}\n                            </span>\n                            <button\n                              disabled\n                              className=\"bg-zinc-800/50 text-zinc-600 text-xs px-4 py-2 rounded-full font-black opacity-70 cursor-not-allowed border border-white/5\"\n                            >\n                              \345\276\205\345\274\200\345\220\257\n                            </button>\n                          </div>\n                        ) : isBooked ? (\n                          <button\n                            onClick={() => handleBookingToggle(cls.id)}\n                            className=\"bg-rose-500/10 hover:bg-rose-500/25 border border-rose-500/20 text-rose-400 active:scale-95 text-xs px-3.5 py-2 rounded-full font-black transition flex items-center space-x-1 cursor-pointer\"\n                          >\n                            <CheckCircle2 className=\"w-3.5 h-3.5 text-rose-400\" />\n                            <span>\351\200\200\347\272\246</span>\n                          </button>\n                        ) : (\n                          <div>\n                            {isFull ? (\n                              <button\n                                onClick={() => handleWaitlistToggle(cls.id)}\n                                className={`text-[11px] px-4 py-2 rounded-full font-bold transition duration-250 active:scale-95 flex items-center space-x-1 cursor-pointer ${\n                                  isWaiting\n                                    ? \'bg-rose-500/10 border border-rose-500/20 text-rose-400\'\n                                    : \'bg-rose-500 hover:bg-rose-600 text-white shadow-lg shadow-rose-500/10\'\n                                }`}\n                              >\n                                {isWaiting ? \'\345\200\231\350\241\245\344\270\255\' : \'\346\216\222\351\230\237\'}\n                              </button>\n                            ) : (\n                              <button\n                                onClick={() => handleBookingToggle(cls.id)}\n                                className=\"bg-white hover:bg-zinc-100 text-[#0c0d14] active:scale-95 text-xs px-5 py-2 rounded-full font-black transition shadow-lg cursor-pointer hover:scale-103\"\n                              >\n                                \351\242\204\347\272\246\n                              </button>\n                            )}\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      ) : (\n        /* =================== WEEKLY GRID SCHEDULER VIEW =================== */\n        <div className=\"mt-3\">\n          {/* Week interval navigator panel */}\n          <div className=\"flex items-center justify-between bg-[#13141f] px-4 py-2.5 border border-white/5 rounded-[20px] mb-4 shadow-xl\">\n            <button\n              onClick={() => handleWeekChange(-1)}\n              className=\"p-1.5 rounded-full text-zinc-400 hover:bg-white/5 hover:text-white transition cursor-pointer\"\n              id=\"weekly-prev\"\n            >\n              <ChevronLeft className=\"w-5 h-5\" />\n            </button>\n\n            <span className=\"text-xs font-black text-zinc-200 tracking-tight font-mono\">\n              {weeklyGridDates[0].dayNum} \350\207\263 {weeklyGridDates[6].dayNum}\n            </span>\n\n            <button\n              onClick={() => handleWeekChange(1)}\n              className=\"p-1.5 rounded-full text-zinc-400 hover:bg-white/5 hover:text-white transition cursor-pointer\"\n              id=\"weekly-next\"\n            >\n              <ChevronRight className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Grid layout panel scrollable horizontally */}\n          <div className=\"bg-[#13141f] border border-white/5 rounded-[24px] overflow-hidden shadow-2xl\">\n            <div className=\"overflow-x-auto select-none\">\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-white/5 border-b border-white/5 bg-white/5\">\n                {/* Time header label cell */}\n                <div className=\"p-2 py-3 text-center text-[10px] font-black text-zinc-400 font-mono\">\n                  \346\227\266\351\227\264\n                </div>\n\n                {/* 7 Columns titles of date */}\n                {weeklyGridDates.map((col, idx) => {\n                  const isDateSelected = selectedDateStr === col.dateStr;\n                  return (\n                    <button\n                      key={idx}\n                      onClick={() => {\n                        setSelectedDateStr(col.dateStr);\n                        setViewMode(\'day\'); // Slide back to daily of that picked list\n                        addToast(`\345\267\262\350\267\263\350\275\254\350\207\263 ${col.dateStr} \350\257\246\347\273\206\350\257\276\350\241\250`, \'info\');\n                      }}\n                      className={`p-2 py-3 text-center transition flex flex-col items-center justify-center hover:bg-white/5 cursor-pointer ${\n                        isDateSelected ? \'bg-white/10 border-t-2 border-rose-500\' : \'\'\n                      }`}\n                    >\n                      <span className=\"text-[9px] text-zinc-500 block font-bold\">\n                        {col.dayLabel}\n                      </span>\n                      <span className={`text-[11px] font-black mt-0.5 ${isDateSelected ? \'text-rose-450 text-rose-400\' : \'text-zinc-200\'}`}>\n                        {col.dayNum}\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Weekly Timeline Slots Body */}\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-white/5 font-mono\">\n                {/* Simulated time intervals rows */}\n                <div className=\"col-span-1 divide-y divide-white/5\">\n                  {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((time) => (\n                    <div key={time} className=\"h-28 p-2 text-center flex items-center justify-center text-[10px] font-black text-zinc-500 bg-white/5 border-b border-white/5\">\n                      {time}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Grid cells representing dance categories slots */}\n                {weeklyGridDates.map((col, colIdx) => {\n                  const dayClasses = classes.filter(c => c.date === col.dateStr);\n\n                  return (\n                    <div key={colIdx} className=\"col-span-1 divide-y divide-white/5 min-h-[500px]\">\n                      {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((timeSlot) => {\n                        // Find if any class matches this general time starting slot index\n                        const classMatch = dayClasses.find(c => c.timeStart === timeSlot);\n                        const isBooked = classMatch ? bookedClassIds.includes(classMatch.id) : false;\n\n                        return (\n                          <div key={timeSlot} className=\"h-28 p-1 relative flex flex-col justify-between border-b border-white/5 bg-[#0c0d14]\">\n                            {classMatch ? (\n                              <div\n                                onClick={() => {\n                                  setSelectedDateStr(col.dateStr);\n                                  setViewMode(\'day\'); // Direct go to detail on click\n                                  addToast(`\346\202\250\347\202\271\345\207\273\344\272\206 ${classMatch.title}\357\274\214\350\277\233\345\205\245\345\215\225\346\227\245\346\250\241\345\274\217\347\256\241\347\220\206\351\242\204\347\272\246`, \'info\');\n                                }}\n                                className={`w-full h-full rounded-xl p-1.5 text-left text-white leading-none cursor-pointer overflow-hidden transition-all hover:brightness-110 hover:scale-[1.02] flex flex-col justify-between border border-white/5 ${\n                                  isBooked\n                                    ? \'bg-rose-500 shadow-md shadow-rose-500/10\'\n                                    : classMatch.genre === \'hiphop\'\n                                    ? \'bg-indigo-950/60 border border-indigo-500/20\'\n                                    : classMatch.genre === \'jazz\'\n                                    ? \'bg-violet-950/60 border border-violet-500/20\'\n                                    : classMatch.genre === \'urban\'\n                                    ? \'bg-pink-950/60 border border-pink-500/20\'\n                                    : \'bg-zinc-900\'\n                                }`}\n                              >\n                                <div>\n                                  <div className=\"text-[9px] truncate font-extrabold tracking-tight\">\n                                    {classMatch.title}\n                                  </div>\n                                  <div className=\"text-[8px] text-zinc-400 truncate leading-none mt-1\">\n                                    {classMatch.timeStart}~{classMatch.timeEnd}\n                                  </div>\n                                  <div className=\"text-[8px] font-black text-rose-300 tracking-wide truncate mt-1\">\n                                    {classMatch.teacher.name}\n                                  </div>\n                                </div>\n\n                                <div className=\"flex items-center justify-between mt-1 pt-1 border-t border-white/5\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white text-rose-500 text-[8px] font-black px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/25 text-zinc-400 text-[8px] font-bold px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n                              <div className=\"w-full h-full text-zinc-800 flex items-center justify-center text-[10px] select-none font-bold\">\n                                -\n                              </div>\n                            )}\n                          </div>\n                        );\n                      })}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <p className=\"text-[9px] text-zinc-500 mt-2 text-center leading-relaxed\">\n            * \346\217\220\347\244\272: \350\257\276\350\241\250\350\203\214\350\211\262\344\273\243\350\241\250\350\210\236\347\247\215\351\243\216\346\240\274\343\200\202\351\242\204\347\272\246\347\232\204\351\241\271\347\233\256\345\260\206\346\240\207\347\272\242\357\274\214\347\202\271\345\207\273\346\227\245\345\216\206\345\257\271\345\272\224\346\227\245\346\234\237\346\210\226\350\241\250\346\240\274\345\215\241\347\211\207\357\274\214\345\235\207\345\217\257\351\232\217\346\227\266\346\237\245\347\234\213\350\257\246\347\273\206\350\257\276\347\250\213\345\206\205\345\256\271\344\270\216\351\200\200\347\272\246\350\256\276\347\275\256\343\200\202\n          </p>\n        </div>\n      )}\n\n      {/* ==================== SCREEN DIALOG 1: CALENDAR MODAL  ==================== */}\n      <AnimatePresence>\n        {isCalendarOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n            {/* Overlay sheet backdrop */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsCalendarOpen(false)}\n              className=\"absolute inset-0 bg-black/80 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Modal Body Container */}\n            <motion.div\n              initial={{ scale: 0.95, opacity: 0, y: 15 }}\n              animate={{ scale: 1, opacity: 1, y: 0 }}\n              exit={{ scale: 0.95, opacity: 0, y: 15 }}\n              className=\"bg-[#13141f] rounded-[32px] w-full max-w-sm overflow-hidden shadow-2xl relative z-10 border border-white/10 text-white\"\n            >\n              {/* Month selector header */}\n              <div className=\"bg-[#181926] p-4 border-b border-white/5 flex items-center justify-between text-white\">\n                <span className=\"text-[10px] text-zinc-400 font-extrabold tracking-widest uppercase\">\346\234\210\345\216\206\346\227\245\346\234\237\351\200\211\346\213\251</span>\n                <span className=\"text-sm font-black text-white font-mono\">2026-05</span>\n                <span className=\"text-[9px] bg-rose-500 text-white font-black px-2 py-0.5 rounded-full font-mono uppercase\">\344\273\212\345\244\251</span>\n              </div>\n\n              {/* Calendar Grid mockup elements */}\n              <div className=\"p-4\" id=\"calendar-grid-box\">\n                {/* Row day labels */}\n                <div className=\"grid grid-cols-7 text-center mb-2\">\n                  {[\'\346\227\245\', \'\344\270\200\', \'\344\272\214\', \'\344\270\211\', \'\345\233\233\', \'\344\272\224\', \'\345\205\255\'].map((day) => (\n                    <span key={day} className=\"text-[11px] text-zinc-500 font-bold py-1\">\n                      {day}\n                    </span>\n                  ))}\n                </div>\n\n                <div className=\"grid grid-cols-7 text-center gap-1.5 font-mono\">\n                  {/* Empty cells for May offset (Starts on Friday, 1st) */}\n                  {Array.from({ length: 5 }).map((_, idx) => (\n                    <span key={`empty_${idx}`} className=\"text-zinc-800 text-xs py-1.5\">-</span>\n                  ))}\n\n                  {/* Days grid generator from 1 to 31 */}\n                  {Array.from({ length: 31 }).map((_, idx) => {\n                    const dayNumStr = String(idx + 1).padStart(2, \'0\');\n                    const fullDateStr = `2026-05-${dayNumStr}`;\n                    const isToday = dayNumStr === \'25\';\n                    const isBookableRange = idx + 1 >= 24 && idx + 1 <= 31; // Enabled only matching dates\n                    const isCurrentSelected = selectedDateStr === fullDateStr;\n\n                    return (\n                      <button\n                        key={idx}\n                        disabled={!isBookableRange}\n                        onClick={() => handleCalendarPickDate(fullDateStr)}\n                        className={`text-xs py-1.5 font-bold rounded-xl transition relative cursor-pointer ${\n                          isCurrentSelected\n                            ? \"bg-rose-500 text-white shadow shadow-rose-500/30\"\n                            : isToday\n                            ? \"border border-rose-500 text-rose-500 bg-rose-550/10\"\n                            : isBookableRange\n                            ? \"text-zinc-305 text-zinc-300 hover:bg-white/5 hover:text-white\"\n                            : \"text-zinc-800 cursor-not-allowed\"\n                        }`}\n                      >\n                        {idx + 1}\n                        {isToday && (\n                          <span className=\"absolute bottom-0.5 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-rose-500 rounded-full\"></span>\n                        )}\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Bottom close footer buttons */}\n              <div className=\"border-t border-white/5 p-4 bg-[#181926] flex items-center justify-between\">\n                <button\n                  onClick={() => handleCalendarPickDate(\'2026-05-25\')}\n                  className=\"text-xs text-rose-455 text-rose-400 font-extrabold hover:underline cursor-pointer\"\n                >\n                  \345\233\236\344\273\212\345\244\251 (5-25)\n                </button>\n                <button\n                  onClick={() => setIsCalendarOpen(false)}\n                  className=\"px-4 py-1.5 bg-white/5 border border-white/5 text-zinc-300 hover:text-white text-xs font-semibold rounded-full transition cursor-pointer\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== SCREEN DIALOG 2: FILTER DRAWER  ==================== */}\n      <AnimatePresence>\n        {isFilterOpen && (\n          <div className=\"fixed inset-0 z-50 overflow-hidden\">\n            {/* Drawer Backdrop overlay */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsFilterOpen(false)}\n              className=\"absolute inset-0 bg-black/80 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Slider Content block */}\n            <div className=\"absolute inset-y-0 right-0 max-w-full flex pl-10\">\n              <motion.div\n                initial={{ x: \'100%\' }}\n                animate={{ x: 0 }}\n                exit={{ x: \'100%\' }}\n                transition={{ type: \'spring\', damping: 25, stiffness: 220 }}\n                className=\"w-screen max-w-xs bg-[#13141f] border-l border-white/10 flex flex-col shadow-2xl text-white\"\n              >\n                {/* Header title */}\n                <div className=\"p-4 border-b border-white/5 flex items-center justify-between bg-[#181926] text-white\">\n                  <span className=\"font-extrabold text-zinc-200\">\350\257\276\347\250\213\346\235\241\344\273\266\347\255\233\351\200\211</span>\n                  <button\n                    onClick={() => setIsFilterOpen(false)}\n                    className=\"text-zinc-400 hover:text-white text-base font-black cursor-pointer\"\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n\n                <div className=\"flex-1 overflow-y-auto p-4 space-y-6\">\n                  {/* Classroom Selector block */}\n                  <div>\n                    <h4 className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-3\">\n                      \346\225\231\345\256\244 (Classroom)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                       {classroomsList.map((room) => {\n                        const isSel = tempRoom === room;\n                        return (\n                          <button\n                            key={room}\n                            onClick={() => setTempRoom(room)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? \'bg-rose-500 border-rose-550 text-white font-black hover:bg-rose-600 scale-103\'\n                                : \'bg-white/5 border-white/5 text-zinc-355 text-zinc-300 hover:bg-white/10\'\n                            }`}\n                          >\n                            {room}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n\n                  {/* Teachers Selector block */}\n                  <div>\n                    <h4 className=\"text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-3\">\n                      \350\200\201\345\270\210 (Instructor)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                      <button\n                        onClick={() => setTempTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\')}\n                        className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                          tempTeacherId === \'\345\205\250\351\203\250\350\200\201\345\270\210\'\n                            ? \'bg-rose-500 border-rose-550 text-white font-black hover:bg-rose-600 scale-103\'\n                            : \'bg-white/5 border-white/5 text-zinc-300 hover:bg-white/10\'\n                        }`}\n                      >\n                        \345\205\250\351\203\250\350\200\201\345\270\210\n                      </button>\n\n                      {TEACHERS.map((teacher) => {\n                        const isSel = tempTeacherId === teacher.id;\n                        return (\n                          <button\n                            key={teacher.id}\n                            onClick={() => setTempTeacherId(teacher.id)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? \'bg-rose-500 border-rose-550 text-white font-black hover:bg-rose-600 scale-103\'\n                                : \'bg-white/5 border-white/5 text-zinc-300 hover:bg-white/10\'\n                            }`}\n                          >\n                            {teacher.name}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Trigger controls with \"\351\207\215\347\275\256\" & \"\347\241\256\350\256\244\" */}\n                <div className=\"p-4 border-t border-white/5 grid grid-cols-2 gap-3 bg-[#181926]\">\n                  <button\n                    onClick={resetDrawerFilters}\n                    className=\"w-full py-2.5 bg-white/5 hover:bg-white/10 text-zinc-300 border border-white/5 text-xs font-bold rounded-full transition cursor-pointer\"\n                  >\n                    \351\207\215\347\275\256\n                  </button>\n                  <button\n                    onClick={applyDrawerFilters}\n                    className=\"w-full py-2.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold rounded-full shadow-lg transition cursor-pointer\"\n                  >\n                    \347\241\256\350\256\244\n                  </button>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
      replacement_content: "  return (\n    <div className={`flex-1 overflow-y-auto px-4 pb-20 pt-4 transition-colors duration-500 ${bgClass}`} id=\"schedule-container\">\n      {/* Header section with PLANA selection and Tab slider */}\n      <div className={`flex items-center justify-between pb-3 border-b ${headerBorder} mb-3`}>\n        <div className=\"flex items-center space-x-2\" id=\"studio-selector\">\n          <div className={`w-5 h-5 rounded-lg bg-gradient-to-tr ${isMint ? \'from-teal-400 to-emerald-500\' : \'from-pink-500 to-rose-600\'} flex items-center justify-center text-white text-[10px] font-black tracking-tighter`}>\n            P\n          </div>\n          <span className={`font-extrabold text-xs ${textTitleClass}`}>\346\255\246\346\261\211\350\241\227\351\201\223\345\217\243\346\227\227\350\210\260\345\272\227</span>\n        </div>\n\n        {/* Day / Week scheduler toggle tabs */}\n        <div className={`${selectBgPill} p-0.5 rounded-full flex text-[10px] font-black`} id=\"mode-selector\">\n          <button\n            onClick={() => setViewMode(\'day\')}\n            className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n              viewMode === \'day\'\n                ? activeToggleColor\n                : isDark ? \'text-zinc-405 text-zinc-400 hover:text-white\' : \'text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            \346\227\245\350\257\276\350\241\250\n          </button>\n          <button\n            onClick={() => setViewMode(\'week\')}\n            className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n              viewMode === \'week\'\n                ? activeToggleColor\n                : isDark ? \'text-zinc-405 text-zinc-400 hover:text-white\' : \'text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            \345\221\250\350\257\276\350\241\250\n          </button>\n        </div>\n      </div>\n\n      {viewMode === \'day\' ? (\n        /* =================== DAILY VIEW INTERFACE =================== */\n        <div>\n          {/* Main Course filters: Group (\345\233\242\350\257\276) | Private (\347\247\201\346\225\231) | Series (\347\217\255\350\257\276) */}\n          <div className=\"flex items-center justify-between mt-2 mb-2.5\">\n            <div className={`${selectBgPill} p-1 rounded-xl flex space-x-1 shrink-0`}>\n              <button\n                onClick={() => setActiveCourseType(\'group\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'group\'\n                    ? activeSliderBtn\n                    : inactiveSliderBtn\n                }`}\n                id=\"btn-group-class\"\n              >\n                \345\233\242\350\257\276\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'private\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'private\'\n                    ? activeSliderBtn\n                    : inactiveSliderBtn\n                }`}\n                id=\"btn-private-class\"\n              >\n                \347\247\201\346\225\231\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'series\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'series\'\n                    ? activeSliderBtn\n                    : inactiveSliderBtn\n                }`}\n                id=\"btn-series-class\"\n              >\n                \347\217\255\350\257\276\n              </button>\n            </div>\n\n            {/* Quick action actions: Bookable switch & Month Calendar Icon */}\n            <div className=\"flex items-center space-x-3\">\n              <label className=\"flex items-center cursor-pointer select-none\" id=\"toggle-bookable\">\n                <span className={`text-[11px] font-extrabold mr-1.5 ${textSecondary}`}>\345\217\257\347\272\246</span>\n                <div className=\"relative\">\n                  <input\n                    type=\"checkbox\"\n                    checked={onlyBookable}\n                    onChange={(e) => setOnlyBookable(e.target.checked)}\n                    className=\"sr-only\"\n                  />\n                  <div className={`w-8 h-4.5 rounded-full transition-colors ${\n                    onlyBookable \n                      ? (isMint ? \'bg-teal-600\' : \'bg-rose-500\') \n                      : (isDark ? \'bg-zinc-800\' : \'bg-slate-300\')\n                  }`}></div>\n                  <div className={`absolute top-0.5 left-0.5 bg-white w-3.5 h-3.5 rounded-full transition-transform ${onlyBookable ? \'translate-x-3.5\' : \'translate-x-0\'}`}></div>\n                </div>\n              </label>\n\n              <button\n                onClick={() => setIsCalendarOpen(true)}\n                className={`w-8 h-8 rounded-full border flex items-center justify-center cursor-pointer transition-colors ${\n                  isDark \n                    ? \'border-white/5 bg-white/5 text-zinc-300 hover:text-rose-455 hover:bg-white/10\' \n                    : \'border-slate-200 bg-white text-slate-750 text-slate-700 hover:text-rose-500 hover:bg-slate-50\'\n                }`}\n                title=\"\351\200\211\346\213\251\346\227\245\346\234\237\"\n                id=\"btn-open-calendar\"\n              >\n                <Calendar className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Scrolling dates carousel row */}\n          <div className=\"flex items-center space-x-1.5 overflow-x-auto pb-2 mt-2 -mx-4 px-4 scrollbar-none\" id=\"date-carousel\">\n            {CAROUSEL_DATES.map((item) => {\n              const isSelected = selectedDateStr === item.dateStr;\n              return (\n                <button\n                  key={item.dateStr}\n                  onClick={() => setSelectedDateStr(item.dateStr)}\n                  className={`flex flex-col items-center justify-center p-2 rounded-2xl min-w-11 transition-all cursor-pointer ${\n                    isSelected\n                      ? isMint \n                        ? \'bg-gradient-to-tr from-teal-500 to-emerald-600 text-white shadow-lg border-b-2 border-teal-300 scale-105 font-bold\'\n                        : \'bg-gradient-to-tr from-pink-500 to-rose-600 text-white shadow-lg border-b-2 border-rose-400 scale-105 font-bold\'\n                      : isDark\n                      ? \'bg-white/5 hover:bg-white/10 text-zinc-400 border border-white/5 font-semibold\'\n                      : \'bg-white hover:bg-slate-50 text-slate-600 border border-slate-200/60 shadow-xs font-semibold\'\n                  }`}\n                >\n                  <span className={`text-[9px] font-extrabold ${isSelected ? \'text-white/80\' : \'text-zinc-500\'}`}>\n                    {item.name}\n                  </span>\n                  <span className=\"text-xs font-black mt-0.5\">\n                    {item.displayDate}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Filter button and label summaries */}\n          <div className=\"flex items-center justify-between mt-3 mb-2 px-0.5\">\n            <div className={`text-[10px] font-bold tracking-wide ${textSecondary}`}>\n              {(filterRoom !== \'\345\205\250\351\203\250\346\225\231\345\256\244\' || filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\') ? (\n                <span className={`${badgeClass} flex items-center px-2.5 py-0.5 rounded-full`}>\n                  <span className={`inline-block w-1.5 h-1.5 rounded-full mr-1.5 animate-ping ${isMint ? \'bg-teal-550\' : \'bg-rose-500\'}`}></span>\n                  \345\267\262\347\255\233\351\200\211: {filterRoom} \342\200\242 {filterTeacherId !== \'\345\205\250\351\203\250\350\200\201\345\270\210\' ? TEACHERS.find(t=>t.id===filterTeacherId)?.name : \'\345\205\250\351\203\250\350\200\201\345\270\210\'}\n                </span>\n              ) : (\n                <span>\345\205\250\351\203\250\350\257\276\347\250\213\350\256\241\345\210\222\345\210\227\350\241\250</span>\n              )}\n            </div>\n\n            <button\n              onClick={openFilterDrawer}\n              className={`flex items-center text-[11px] px-3 py-1 border rounded-full font-black shadow-sm cursor-pointer transition-colors ${\n                isDark \n                  ? \'text-zinc-300 hover:text-rose-455 hover:bg-white/10 bg-[#13141f] border-white/5\' \n                  : isMint \n                  ? \'text-teal-700 bg-teal-50 hover:bg-teal-100/55 border-teal-200/50\' \n                  : \'text-slate-700 bg-white hover:bg-slate-50 border-slate-200\'\n              }`}\n              id=\"btn-filter-drawer\"\n            >\n              <Filter className={`w-3 h-3 mr-1 ${highlightText}`} />\n              <span>\347\255\233\351\200\211</span>\n            </button>\n          </div>\n\n          {/* Cards List container with Empty Stage conditions */}\n          <div className=\"space-y-3 mt-2\" id=\"daily-classes-list\">\n            {finalFilteredClasses.length === 0 ? (\n              <div className={`${cardBgClass} rounded-[32px] p-8 border text-center flex flex-col items-center justify-center shadow-lg`} id=\"empty-state\">\n                <div className={`w-14 h-14 rounded-2xl flex items-center justify-center mb-4 border ${isDark ? \'bg-white/5 border-white/5\' : \'bg-slate-100 border-slate-200\'}`}>\n                  <Layers className={`w-6 h-6 ${isDark ? \'text-zinc-400\' : \'text-slate-500\'}`} />\n                </div>\n                <p className={`font-extrabold text-sm ${textWhite}`}>\346\232\202\346\227\240\350\257\276\347\250\213\344\277\241\346\201\257\357\274\214\345\205\210\347\234\213\347\234\213\345\210\253\347\232\204\345\220\247</p>\n                <p className={`text-xs mt-1.5 mb-4 font-bold font-mono ${textSecondary}`}>\346\234\200\350\277\221\345\217\257\347\272\246\351\241\271\347\233\256\344\270\272: 2026-05-25 (\344\273\212\346\227\245)</p>\n                <button\n                  onClick={() => {\n                    setSelectedDateStr(\'2026-05-25\');\n                    setFilterRoom(\'\345\205\250\351\203\250\346\225\231\345\256\244\');\n                    setFilterTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\');\n                    setActiveCourseType(\'group\');\n                  }}\n                  className={`px-5 py-2.5 text-white rounded-full text-xs font-black shadow-lg cursor-pointer transition duration-300 ${defaultButtonClass}`}\n                  id=\"btn-back-to-today\"\n                >\n                  \347\253\213\345\215\263\351\242\204\347\272\246 (\347\234\213\344\273\212\345\244\251\345\244\247\350\257\276)\n                </button>\n              </div>\n            ) : (\n              finalFilteredClasses.map((cls) => {\n                const ended = isClassPassed(cls);\n                const isBooked = bookedClassIds.includes(cls.id);\n                const isWaiting = waitlistClassIds.includes(cls.id);\n                const isFull = cls.bookedCount >= cls.maxCount;\n\n                return (\n                  <div\n                    key={cls.id}\n                    className={`rounded-[24px] border transition-all duration-300 overflow-hidden ${cardBgClass} ${\n                      isBooked\n                        ? isMint \n                          ? \'border-teal-500 shadow-md bg-teal-500/5\' \n                          : \'border-rose-500 shadow-md bg-rose-500/5\'\n                        : isWaiting\n                        ? \'border-violet-500 shadow-md bg-violet-500/5\'\n                        : `shadow-sm ${headerBorder}`\n                    }`}\n                  >\n                    {/* Top cyan hour panel tag */}\n                    <div className={`px-4 py-1.5 border-b flex items-center justify-between ${isDark ? \'bg-[#181926]/90 border-white/5\' : \'bg-slate-100/70 border-slate-200/55\'}`}>\n                      <span className={`text-xs font-black font-mono ${highlightText}`}>\n                        {cls.timeStart} ~ {cls.timeEnd}\n                      </span>\n                      <span className={`text-[9px] uppercase font-black tracking-widest font-mono ${isDark ? \'text-rose-300\' : \'text-slate-650 text-slate-500\'}`}>\n                        {cls.genre} Style\n                      </span>\n                    </div>\n\n                    <div className=\"p-4 flex items-start space-x-3.5\">\n                      {/* Teacher Round Avatar */}\n                      <div className=\"relative shrink-0\">\n                        <img\n                          src={cls.teacher.avatar}\n                          alt={cls.teacher.name}\n                          className={`w-12 h-12 rounded-2xl object-cover border ${isDark ? \'border-white/10\' : \'border-slate-200\'}`}\n                          referrerPolicy=\"no-referrer\"\n                        />\n                        <span className={`absolute -bottom-1 -right-1 text-white text-[8px] px-1 rounded font-black border ${activeToggleColor} ${isDark ? \'border-[#13141f]\' : \'border-white\'}`}>\n                          {cls.teacher.rating.toFixed(1)}\n                        </span>\n                      </div>\n\n                      {/* Main Center specs of Class */}\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center space-x-1.5 flex-wrap\">\n                          <h3 className={`font-extrabold text-sm tracking-tight truncate leading-tight ${textWhite}`}>\n                            {cls.title}\n                          </h3>\n                        </div>\n\n                        {/* Dance genre text styled */}\n                        <div className=\"flex items-center text-xs mt-1 space-x-1 font-sans font-medium\">\n                          <span className={`font-bold ${isDark ? \'text-zinc-100\' : \'text-slate-800\'}`}>{cls.teacher.name}</span>\n                          <span className={isDark ? \'text-zinc-500\' : \'text-slate-400\'}>\342\200\242</span>\n                          <span className={`capitalize ${isDark ? \'text-zinc-300\' : \'text-slate-600\'}`}>{cls.genre}</span>\n                          <span className={isDark ? \'text-zinc-500\' : \'text-slate-400\'}>\342\200\242</span>\n                          <span className=\"flex items-center\">\n                            \351\232\276\345\272\246 {renderStars(cls.difficulty)}\n                          </span>\n                        </div>\n\n                        {/* Booking classroom and capacity ratios */}\n                        <div className={`text-[11px] mt-1 font-mono space-y-0.5 font-bold ${textSecondary}`}>\n                          <div>{cls.classroom} \342\200\242 \346\273\241{cls.minPeople}\344\272\272\345\274\200\350\257\276</div>\n                          <div className=\"flex items-center mt-1\">\n                            <span className=\"mr-1.5\">\345\267\262\351\242\204\347\272\246:</span>\n                            <span className={`font-black ${isFull ? highlightText : (isDark ? \'text-zinc-200\' : \'text-slate-800\')}`}>\n                              {cls.bookedCount}\n                            </span>\n                            <span className={`${isDark ? \'text-zinc-650 text-zinc-600\' : \'text-slate-400\'} mx-0.5`}>/</span>\n                            <span>{cls.maxCount}\344\272\272</span>\n\n                            {isFull && (\n                              <span className={`ml-2 text-[8px] font-black tracking-wider px-1.5 py-0.5 rounded leading-none ${badgeClass}`}>\n                                \346\273\241\345\221\230\345\200\231\350\241\245\n                              </span>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* Side Actions buttons */}\n                      <div className=\"shrink-0 flex flex-col justify-center items-end h-full self-center\">\n                        {ended ? (\n                          <div className={`text-[11px] px-4 py-2 rounded-full font-bold select-none cursor-not-allowed border ${\n                            isDark ? \'bg-zinc-800 text-zinc-500 border-white/5\' : \'bg-slate-205 bg-slate-200 text-slate-400 border-slate-300/30\'\n                          }`}>\n                            \345\267\262\347\273\223\346\235\237\n                          </div>\n                        ) : cls.openBookingTime ? (\n                          <div className=\"flex flex-col items-end\">\n                            <span className={`text-[8px] font-extrabold mb-1 font-mono px-1.5 py-0.5 rounded ${\n                              isMint ? \'bg-teal-500/10 text-teal-605 text-teal-500 border border-teal-500/20\' : \'bg-pink-500/10 text-pink-400 border border-pink-500/20\'\n                            }`}>\n                              {cls.openBookingTime}\n                            </span>\n                            <button\n                              disabled\n                              className={`text-xs px-4 py-2 rounded-full font-black opacity-70 cursor-not-allowed border ${\n                                isDark ? \'bg-zinc-800/50 text-zinc-600 border-white/5\' : \'bg-slate-100 text-slate-400 border-slate-205 border-slate-200\'\n                              }`}\n                            >\n                              \345\276\205\345\274\200\345\220\257\n                            </button>\n                          </div>\n                        ) : isBooked ? (\n                          <button\n                            onClick={() => handleBookingToggle(cls.id)}\n                            className={`border active:scale-95 text-xs px-3.5 py-2 rounded-full font-black transition flex items-center space-x-1 cursor-pointer ${\n                              isMint \n                                ? \'bg-teal-500/10 hover:bg-teal-500/25 border-teal-500/20 text-teal-600\' \n                                : \'bg-rose-500/10 hover:bg-rose-500/25 border-rose-500/20 text-rose-500 text-rose-400\'\n                            }`}\n                          >\n                            <CheckCircle2 className={`w-3.5 h-3.5 ${isMint ? \'text-teal-600\' : \'text-rose-455 text-rose-400\'}`} />\n                            <span>\351\200\200\347\272\246</span>\n                          </button>\n                        ) : (\n                          <div>\n                            {isFull ? (\n                              <button\n                                onClick={() => handleWaitlistToggle(cls.id)}\n                                className={`text-[11px] px-4 py-2 rounded-full font-bold transition duration-250 active:scale-95 flex items-center space-x-1 cursor-pointer ${\n                                  isWaiting\n                                    ? isMint \n                                      ? \'bg-teal-500/10 border border-teal-500/20 text-teal-600\' \n                                      : \'bg-rose-500/10 border border-rose-500/20 text-rose-500 text-rose-405\'\n                                    : defaultButtonClass\n                                }`}\n                              >\n                                {isWaiting ? \'\345\200\231\350\241\245\344\270\255\' : \'\346\216\222\351\230\237\'}\n                              </button>\n                            ) : (\n                              <button\n                                onClick={() => handleBookingToggle(cls.id)}\n                                className={`active:scale-95 text-xs px-5 py-2 rounded-full font-black transition shadow-lg cursor-pointer hover:scale-103 ${\n                                  isDark \n                                    ? \'bg-white hover:bg-zinc-100 text-[#0c0d14]\' \n                                    : \'bg-slate-900 hover:bg-black text-white\'\n                                }`}\n                              >\n                                \351\242\204\347\272\246\n                              </button>\n                            )}\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      ) : (\n        /* =================== WEEKLY GRID SCHEDULER VIEW =================== */\n        <div className=\"mt-3\">\n          {/* Week interval navigator panel */}\n          <div className={`${cardBgClass} px-4 py-2.5 border rounded-[20px] mb-4 shadow-xl flex items-center justify-between`}>\n            <button\n              onClick={() => handleWeekChange(-1)}\n              className={`p-1.5 rounded-full transition cursor-pointer ${isDark ? \'text-zinc-400 hover:bg-white/5 hover:text-white\' : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'}`}\n              id=\"weekly-prev\"\n            >\n              <ChevronLeft className=\"w-5 h-5\" />\n            </button>\n\n            <span className={`text-xs font-black tracking-tight font-mono ${isDark ? \'text-zinc-200\' : \'text-slate-900\'}`}>\n              {weeklyGridDates[0].dayNum} \350\207\263 {weeklyGridDates[6].dayNum}\n            </span>\n\n            <button\n              onClick={() => handleWeekChange(1)}\n              className={`p-1.5 rounded-full transition cursor-pointer ${isDark ? \'text-zinc-400 hover:bg-white/5 hover:text-white\' : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900\'}`}\n              id=\"weekly-next\"\n            >\n              <ChevronRight className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Grid layout panel scrollable horizontally */}\n          <div className={`${isDark ? \'bg-[#13141f] border-white/5\' : \'bg-white border-slate-200\'} border rounded-[24px] overflow-hidden shadow-2xl`}>\n            <div className=\"overflow-x-auto select-none\">\n              <div className={`min-w-[640px] grid grid-cols-8 border-b ${isDark ? \'divide-white/5 border-white/5 bg-white/5\' : \'divide-slate-250 border-slate-200 bg-slate-50\'}`}>\n                {/* Time header label cell */}\n                <div className={`p-2 py-3 text-center text-[10px] font-black font-mono ${isDark ? \'text-zinc-400\' : \'text-slate-500\'}`}>\n                  \346\227\266\351\227\264\n                </div>\n\n                {/* 7 Columns titles of date */}\n                {weeklyGridDates.map((col, idx) => {\n                  const isDateSelected = selectedDateStr === col.dateStr;\n                  return (\n                    <button\n                      key={idx}\n                      onClick={() => {\n                        setSelectedDateStr(col.dateStr);\n                        setViewMode(\'day\'); // Slide back to daily of that picked list\n                        addToast(`\345\267\262\350\267\263\350\275\254\350\207\263 ${col.dateStr} \350\257\246\347\273\206\350\257\276\350\241\250`, \'info\');\n                      }}\n                      className={`p-2 py-3 text-center transition flex flex-col items-center justify-center hover:bg-black/5 cursor-pointer ${\n                        isDateSelected \n                          ? isMint \n                            ? \'bg-teal-500/15 border-t-2 border-teal-500\' \n                            : \'bg-rose-500/15 border-t-2 border-rose-500\' \n                          : \'\'\n                      }`}\n                    >\n                      <span className=\"text-[9px] text-zinc-500 block font-bold\">\n                        {col.dayLabel}\n                      </span>\n                      <span className={`text-[11px] font-black mt-0.5 ${isDateSelected ? highlightText : (isDark ? \'text-zinc-200\' : \'text-slate-800\')}`}>\n                        {col.dayNum}\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Weekly Timeline Slots Body */}\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-white/5 font-mono\">\n                {/* Simulated time intervals rows */}\n                <div className=\"col-span-1 divide-y divide-white/5\">\n                  {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((time) => (\n                    <div key={time} className={`h-28 p-2 text-center flex items-center justify-center text-[10px] font-black border-b ${\n                      isDark ? \'text-zinc-500 bg-white/5 border-white/5\' : \'text-slate-505 text-slate-500 bg-slate-100/50 border-slate-200/50\'\n                    }`}>\n                      {time}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Grid cells representing dance categories slots */}\n                {weeklyGridDates.map((col, colIdx) => {\n                  const dayClasses = classes.filter(c => c.date === col.dateStr);\n\n                  return (\n                    <div key={colIdx} className={`col-span-1 divide-y min-h-[500px] ${isDark ? \'divide-white/5\' : \'divide-slate-200\'}`}>\n                      {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((timeSlot) => {\n                        // Find if any class matches this general time starting slot index\n                        const classMatch = dayClasses.find(c => c.timeStart === timeSlot);\n                        const isBooked = classMatch ? bookedClassIds.includes(classMatch.id) : false;\n\n                        return (\n                          <div key={timeSlot} className={`h-28 p-1 relative flex flex-col justify-between border-b ${\n                            isDark ? \'border-white/5 bg-[#0c0d14]\' : \'border-slate-200 bg-white\'\n                          }`}>\n                            {classMatch ? (\n                              <div\n                                onClick={() => {\n                                  setSelectedDateStr(col.dateStr);\n                                  setViewMode(\'day\'); // Direct go to detail on click\n                                  addToast(`\346\202\250\347\202\271\345\207\273\344\272\206 ${classMatch.title}\357\274\214\350\277\233\345\205\245\345\215\225\346\227\245\346\250\241\345\274\217\347\256\241\347\220\206\351\242\204\347\272\246`, \'info\');\n                                }}\n                                className={`w-full h-full rounded-xl p-1.5 text-left text-white leading-none cursor-pointer overflow-hidden transition-all hover:brightness-110 hover:scale-[1.02] flex flex-col justify-between border border-white/5 ${\n                                  isBooked\n                                    ? isMint \n                                      ? \'bg-teal-550 bg-teal-605 bg-teal-600 shadow-md shadow-teal-500/10 text-white\' \n                                      : \'bg-rose-500 shadow-md shadow-rose-500/10 text-white\'\n                                    : classMatch.genre === \'hiphop\'\n                                    ? \'bg-indigo-950/90 border border-indigo-500/30 text-white\'\n                                    : classMatch.genre === \'jazz\'\n                                    ? \'bg-violet-950/90 border border-violet-500/30 text-white\'\n                                    : classMatch.genre === \'urban\'\n                                    ? \'bg-pink-950/95 border border-pink-500/30 text-white\'\n                                    : \'bg-zinc-900 border border-zinc-700 text-white\'\n                                }`}\n                              >\n                                <div>\n                                  <div className=\"text-[9px] truncate font-extrabold tracking-tight\">\n                                    {classMatch.title}\n                                  </div>\n                                  <div className=\"text-[8px] text-zinc-350 text-zinc-300 truncate leading-none mt-1\">\n                                    {classMatch.timeStart}~{classMatch.timeEnd}\n                                  </div>\n                                  <div className=\"text-[8px] font-black text-rose-300 tracking-wide truncate mt-1\">\n                                    {classMatch.teacher.name}\n                                  </div>\n                                </div>\n\n                                <div className=\"flex items-center justify-between mt-1 pt-1 border-t border-white/5\">\n                                  {isBooked ? (\n                                    <span className={`bg-white text-[8px] font-black px-1 rounded truncate leading-none scale-[0.9] origin-left ${isMint ? \'text-teal-600\' : \'text-rose-550 text-rose-500\'}`}>\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/25 text-zinc-350 text-zinc-300 text-[8px] font-bold px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n                              <div className={`w-full h-full flex items-center justify-center text-[10px] select-none font-bold ${isDark ? \'text-zinc-800\' : \'text-slate-300\'}`}>\n                                -\n                              </div>\n                            )}\n                          </div>\n                        );\n                      })}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <p className={`text-[9px] mt-2 text-center leading-relaxed ${textSecondary}`}>\n            * \346\217\220\347\244\272: \350\257\276\350\241\250\350\203\214\350\211\262\344\273\243\350\241\250\350\210\236\347\247\215\351\243\216\346\240\274\343\200\202\351\242\204\347\272\246\347\232\204\351\241\271\347\233\256\345\260\206\346\240\207\351\253\230\344\272\256\357\274\214\347\202\271\345\207\273\346\227\245\345\216\206\345\257\271\345\272\224\346\227\245\346\234\237\346\210\226\350\241\250\346\240\274\345\215\241\347\211\207\357\274\214\345\235\207\345\217\257\351\232\217\346\227\266\346\237\245\347\234\213\350\257\246\347\273\206\350\257\276\347\250\213\345\206\205\345\256\271\344\270\216\351\200\200\347\272\246\350\256\276\347\275\256\343\200\202\n          </p>\n        </div>\n      )}\n\n      {/* ==================== SCREEN DIALOG 1: CALENDAR MODAL  ==================== */}\n      <AnimatePresence>\n        {isCalendarOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n            {/* Overlay sheet backdrop */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsCalendarOpen(false)}\n              className=\"absolute inset-0 bg-black/80 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Modal Body Container */}\n            <motion.div\n              initial={{ scale: 0.95, opacity: 0, y: 15 }}\n              animate={{ scale: 1, opacity: 1, y: 0 }}\n              exit={{ scale: 0.95, opacity: 0, y: 15 }}\n              className={`rounded-[32px] w-full max-w-sm overflow-hidden shadow-2xl relative z-10 border text-white ${\n                isDark ? \'bg-[#13141f] border-white/10 text-white\' : \'bg-white border-slate-205 border-slate-200 text-slate-800\'\n              }`}\n            >\n              {/* Month selector header */}\n              <div className={`p-4 border-b flex items-center justify-between ${isDark ? \'bg-[#181926] border-white/5\' : \'bg-slate-50 border-slate-200\'}`}>\n                <span className={`text-[10px] font-extrabold tracking-widest uppercase ${textSecondary}`}>\346\234\210\345\216\206\346\227\245\346\234\237\351\200\211\346\213\251</span>\n                <span className={`text-sm font-black font-mono ${isDark ? \'text-white\' : \'text-slate-900\'}`}>2026-05</span>\n                <span className={`text-[9px] text-white font-black px-2 py-0.5 rounded-full font-mono uppercase ${ctaBtnColor}`}>\344\273\212\345\244\251</span>\n              </div>\n\n              {/* Calendar Grid mockup elements */}\n              <div className=\"p-4\" id=\"calendar-grid-box\">\n                {/* Row day labels */}\n                <div className=\"grid grid-cols-7 text-center mb-2\">\n                  {[\'\346\227\245\', \'\344\270\200\', \'\344\272\214\', \'\344\270\211\', \'\345\233\233\', \'\344\272\224\', \'\345\205\255\'].map((day) => (\n                    <span key={day} className={`text-[11px] font-bold py-1 ${isDark ? \'text-zinc-500\' : \'text-slate-400\'}`}>\n                      {day}\n                    </span>\n                  ))}\n                </div>\n\n                <div className=\"grid grid-cols-7 text-center gap-1.5 font-mono\">\n                  {/* Empty cells for May offset (Starts on Friday, 1st) */}\n                  {Array.from({ length: 5 }).map((_, idx) => (\n                    <span key={`empty_${idx}`} className={`text-xs py-1.5 ${isDark ? \'text-zinc-800\' : \'text-slate-300\'}`}>-</span>\n                  ))}\n\n                  {/* Days grid generator from 1 to 31 */}\n                  {Array.from({ length: 31 }).map((_, idx) => {\n                    const dayNumStr = String(idx + 1).padStart(2, \'0\');\n                    const fullDateStr = `2026-05-${dayNumStr}`;\n                    const isToday = dayNumStr === \'25\';\n                    const isBookableRange = idx + 1 >= 24 && idx + 1 <= 31; // Enabled only matching dates\n                    const isCurrentSelected = selectedDateStr === fullDateStr;\n\n                    return (\n                      <button\n                        key={idx}\n                        disabled={!isBookableRange}\n                        onClick={() => handleCalendarPickDate(fullDateStr)}\n                        className={`text-xs py-1.5 font-bold rounded-xl transition relative cursor-pointer ${\n                          isCurrentSelected\n                            ? isMint \n                              ? \'bg-teal-550 bg-teal-600 text-white shadow shadow-teal-500/30\'\n                              : \'bg-rose-500 text-white shadow shadow-rose-500/30\'\n                            : isToday\n                            ? isMint\n                              ? \'border border-teal-555 border-teal-500 text-teal-600 bg-teal-50\'\n                              : \'border border-rose-500 text-rose-500 bg-rose-50\'\n                            : isBookableRange\n                            ? isDark\n                              ? \'text-zinc-305 text-zinc-300 hover:bg-white/5 hover:text-white\'\n                              : \'text-slate-700 hover:bg-slate-100 hover:text-slate-900\'\n                            : isDark \n                            ? \'text-zinc-800 cursor-not-allowed\'\n                            : \'text-slate-300 cursor-not-allowed\'\n                        }`}\n                      >\n                        {idx + 1}\n                        {isToday && (\n                          <span className={`absolute bottom-0.5 left-1/2 transform -translate-x-1/2 w-1 h-1 rounded-full ${isMint ? \'bg-teal-500\' : \'bg-rose-500\'}`}></span>\n                        )}\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Bottom close footer buttons */}\n              <div className={`p-4 flex items-center justify-between border-t ${isDark ? \'bg-[#181926] border-white/5\' : \'bg-slate-50 border-slate-200\'}`}>\n                <button\n                  onClick={() => handleCalendarPickDate(\'2026-05-25\')}\n                  className={`text-xs font-extrabold hover:underline cursor-pointer ${highlightText}`}\n                >\n                  \345\233\236\344\273\212\345\244\251 (5-25)\n                </button>\n                <button\n                  onClick={() => setIsCalendarOpen(false)}\n                  className={`px-4 py-1.5 border text-xs font-semibold rounded-full transition cursor-pointer ${\n                    isDark ? \'bg-white/5 border-white/5 text-zinc-350 text-zinc-300 hover:text-white\' : \'bg-white hover:bg-slate-100/55 border-slate-205 border-slate-200 text-slate-700\'\n                  }`}\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== SCREEN DIALOG 2: FILTER DRAWER  ==================== */}\n      <AnimatePresence>\n        {isFilterOpen && (\n          <div className=\"fixed inset-0 z-50 overflow-hidden\">\n            {/* Drawer Backdrop overlay */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsFilterOpen(false)}\n              className=\"absolute inset-0 bg-black/80 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Slider Content block */}\n            <div className=\"absolute inset-y-0 right-0 max-w-full flex pl-10\">\n              <motion.div\n                initial={{ x: \'100%\' }}\n                animate={{ x: 0 }}\n                exit={{ x: \'100%\' }}\n                transition={{ type: \'spring\', damping: 25, stiffness: 220 }}\n                className={`w-screen max-w-xs border-l flex flex-col shadow-2xl ${\n                  isDark ? \'bg-[#13141f] border-white/10 text-white\' : \'bg-white border-slate-200 text-slate-800\'\n                }`}\n              >\n                {/* Header title */}\n                <div className={`p-4 border-b flex items-center justify-between ${isDark ? \'bg-[#181926] border-white/5 text-white\' : \'bg-slate-50 border-slate-200\'}`}>\n                  <span className={`font-extrabold ${isDark ? \'text-zinc-200\' : \'text-slate-900\'}`}>\350\257\276\347\250\213\346\235\241\344\273\266\347\255\233\351\200\211</span>\n                  <button\n                    onClick={() => setIsFilterOpen(false)}\n                    className={`text-base font-black cursor-pointer ${isDark ? \'text-zinc-400 hover:text-white\' : \'text-slate-500 hover:text-slate-850 hover:text-slate-800\'}`}\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n\n                <div className=\"flex-1 overflow-y-auto p-4 space-y-6\">\n                  {/* Classroom Selector block */}\n                  <div>\n                    <h4 className=\"text-[10px] font-black text-zinc-400 uppercase tracking-widest mb-3\">\n                      \346\225\231\345\256\244 (Classroom)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                       {classroomsList.map((room) => {\n                        const isSel = tempRoom === room;\n                        return (\n                          <button\n                            key={room}\n                            onClick={() => setTempRoom(room)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? isMint \n                                  ? \'bg-teal-605 bg-teal-600 border-teal-500 text-white font-black hover:bg-teal-700 scale-103 shadow-md shadow-teal-500/10\'\n                                  : \'bg-rose-500 border-rose-550 text-white font-black hover:bg-rose-600 scale-103 shadow-md shadow-rose-500/10\'\n                                : isDark\n                                ? \'bg-white/5 border-white/5 text-zinc-350 text-zinc-300 hover:bg-white/10\'\n                                : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 shadow-xs\'\n                            }`}\n                          >\n                            {room}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n\n                  {/* Teachers Selector block */}\n                  <div>\n                    <h4 className=\"text-[10px] font-black text-zinc-400 uppercase tracking-widest mb-3\">\n                      \350\200\201\345\270\210 (Instructor)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                      <button\n                        onClick={() => setTempTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\')}\n                        className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                          tempTeacherId === \'\345\205\250\351\203\250\350\200\201\345\270\210\'\n                            ? isMint \n                              ? \'bg-teal-605 bg-teal-600 border-teal-500 text-white font-black hover:bg-teal-700 scale-103\'\n                              : \'bg-rose-500 border-rose-550 text-white font-black hover:bg-rose-600 scale-103\'\n                            : isDark\n                            ? \'bg-white/5 border-white/5 text-zinc-300 hover:bg-white/10\'\n                            : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 shadow-xs\'\n                        }`}\n                      >\n                        \345\205\250\351\203\250\350\200\201\345\270\210\n                      </button>\n\n                      {TEACHERS.map((teacher) => {\n                        const isSel = tempTeacherId === teacher.id;\n                        return (\n                          <button\n                            key={teacher.id}\n                            onClick={() => setTempTeacherId(teacher.id)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? isMint \n                                  ? \'bg-teal-650 bg-teal-600 border-teal-555 text-white font-black hover:bg-teal-750 scale-103\'\n                                  : \'bg-rose-500 border-rose-550 text-white font-black hover:bg-rose-600 scale-103\'\n                                : isDark\n                                ? \'bg-white/5 border-white/5 text-zinc-300 hover:bg-white/10\'\n                                : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 shadow-xs\'\n                            }`}\n                          >\n                            {teacher.name}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Trigger controls with \"\351\207\215\347\275\256\" & \"\347\241\256\350\256\244\" */}\n                <div className={`p-4 border-t grid grid-cols-2 gap-3 ${isDark ? \'border-white/5 bg-[#181926]\' : \'border-slate-200 bg-slate-50/80\'}`}>\n                  <button\n                    onClick={resetDrawerFilters}\n                    className={`w-full py-2.5 text-xs font-bold rounded-full transition cursor-pointer border ${\n                      isDark \n                        ? \'bg-white/5 hover:bg-white/10 text-zinc-300 border-white/5\' \n                        : \'bg-white hover:bg-slate-100 text-slate-700 border-slate-200 shadow-xs\'\n                    }`}\n                  >\n                    \351\207\215\347\275\256\n                  </button>\n                  <button\n                    onClick={applyDrawerFilters}\n                    className={`w-full py-2.5 text-white text-xs font-bold rounded-full shadow-lg transition cursor-pointer ${ctaBtnColor}`}\n                  >\n                    \347\241\256\350\256\244\n                  </button>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
