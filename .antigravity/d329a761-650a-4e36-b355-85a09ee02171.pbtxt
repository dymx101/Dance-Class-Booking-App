space-x-3\">\n              <label className=\"flex items-center cursor-pointer select-none\" id=\"toggle-bookable\">\n                <span className=\"text-[11px] font-black text-indigo-900 mr-1.5\">\345\217\257\347\272\246</span>\n                <div className=\"relative\">\n                  <input\n                    type=\"checkbox\"\n                    checked={onlyBookable}\n                    onChange={(e) => setOnlyBookable(e.target.checked)}\n                    className=\"sr-only\"\n                  />\n                  <div className={`w-8 h-4.5 rounded-full transition-colors ${onlyBookable ? \'bg-rose-500\' : \'bg-indigo-200\'}`}></div>\n                  <div className={`absolute top-0.5 left-0.5 bg-white w-3.5 h-3.5 rounded-full transition-transform ${onlyBookable ? \'translate-x-3.5\' : \'translate-x-0\'}`}></div>\n                </div>\n              </label>\n\n              <button\n                onClick={() => setIsCalendarOpen(true)}\n                className=\"w-8 h-8 rounded-full border border-indigo-100 bg-white flex items-center justify-center text-indigo-900 hover:text-rose-500 hover:bg-rose-50 shadow-sm cursor-pointer transition-colors\"\n                title=\"\351\200\211\346\213\251\346\227\245\346\234\237\"\n                id=\"btn-open-calendar\"\n              >\n                <Calendar className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>"
