      replacement_content: "      {/* Safety notes details */}\n      <div className={`mt-6 p-4 rounded-[24px] border flex items-start space-x-3.5 shadow-lg ${cardBgClass} ${cardBorder}`} id=\"store-faq\">\n        <ShieldCheck className={`w-5 h-5 shrink-0 mt-0.5 ${highlightText}`} />\n        <div className=\"text-[10px] leading-relaxed space-y-1\">\n          <p className={`font-extrabold text-xs ${textWhite}`}>PLANA \350\264\255\350\257\276\345\256\211\345\205\250\344\277\235\351\232\234\347\273\206\345\210\231</p>\n          <p className={`${textSecondary} font-medium`}>\342\200\242 7\345\244\251\351\200\200\345\214\205\344\277\235\351\232\234: \346\226\260\345\215\241\350\207\252\350\264\255\345\214\205\350\265\2677\345\244\251\345\206\205\357\274\214\350\213\245\346\234\252\350\277\233\350\241\214\344\273\273\344\275\225\345\244\247\350\257\276\351\242\204\350\256\242\346\266\210\350\257\276\357\274\214\345\235\207\345\217\257\346\227\240\345\201\277\345\220\221\345\256\242\346\234\215\347\224\263\350\257\267\347\247\222\347\272\247\351\200\200\346\254\276\346\254\276\351\241\271\343\200\202</p>\n          <p className={`${textSecondary} font-medium`}>\342\200\242 \350\207\252\345\212\250\345\206\273\347\273\223\345\273\266\346\234\237: \347\224\250\346\210\267\350\213\245\351\201\207\347\252\201\345\217\221\347\224\237\347\227\205\343\200\201\345\207\272\345\267\256\357\274\214\345\217\257\345\234\250\344\270\212\350\257\276\345\211\215\345\257\271\345\215\241\345\214\205\347\224\263\350\257\267\344\270\272\346\234\23714\345\244\251\347\232\204\344\270\264\346\227\266\345\206\273\347\273\223\357\274\214\344\277\235\350\257\201\350\257\276\346\254\241\345\244\251\346\225\260\345\273\266\346\234\237\344\270\215\350\242\253\346\211\243\350\200\227\343\200\202</p>\n        </div>\n      </div>\n\n      {/* ==================== SCREEN DIALOG 3: CHECKOUT MODAL ==================== */}\n      <AnimatePresence>\n        {selectedCard && (\n          <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n            {/* Backdrop slide hide */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setSelectedCard(null)}\n              className=\"absolute inset-0 bg-black/80 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Content Drawer Box */}\n            <motion.div\n              initial={{ y: \'100%\' }}\n              animate={{ y: 0 }}\n              exit={{ y: \'100%\' }}\n              className={`relative rounded-t-[36px] w-[375px] mx-auto overflow-hidden p-6 border-t z-10 shadow-2xl transition-colors duration-500 ${cardBgClass} ${\n                isDark ? \'border-white/10 text-white\' : \'border-slate-200 text-slate-800 animate-fade-in\'\n              }`}\n            >\n              <div className={`w-12 h-1 rounded-full mx-auto mb-4 ${isDark ? \'bg-white/10\' : \'bg-slate-500/20\'}`}></div>\n\n              {/* Checkout header specs */}\n              <div className={`text-center pb-3 border-b ${isDark ? \'border-white/5\' : \'border-slate-200\'}`}>\n                <span className={`text-[8px] font-extrabold tracking-widest font-mono uppercase ${highlightText}`}>PLANA SECURE CHECKOUT</span>\n                <h4 className={`font-black text-sm mt-1 ${textWhite}`}>\347\241\256\350\256\244\350\264\255\345\215\241\351\241\271\347\233\256</h4>\n                <p className=\"text-[8px] text-zinc-500 font-mono mt-1 font-bold\">\350\256\242\345\215\225ID: CHK_0260525_{selectedCard.id}</p>\n              </div>\n\n              {/* Card descriptions listing details */}\n              <div className={`mt-4 rounded-2xl p-4.5 space-y-3.5 border ${isDark ? \'bg-[#181926] border-white/5\' : \'bg-slate-50 border-slate-200\'}`}>\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <span className={`font-sans font-extrabold text-xs block ${textWhite}`}>{selectedCard.title}</span>\n                    <span className={`text-[9px] mt-1.5 block font-bold font-mono ${isDark ? \'text-zinc-400\' : \'text-slate-500\'}`}>\n                      \350\257\276\347\202\271\345\242\236\345\212\240: {selectedCard.passes === -1 ? \'\346\227\240\351\231\220\346\254\241\351\200\232\345\215\241\' : `${selectedCard.passes} \346\254\241`} \342\200\242 \346\225\210\346\234\237 {selectedCard.validDays} \345\244\251\n                    </span>\n                  </div>\n                  <span className={`font-mono font-black text-base ${textWhite}`}>\302\245{selectedCard.price}</span>\n                </div>\n\n                {/* Simulated Coupon Picker list */}\n                <div className={`pt-3.5 border-t border-dashed ${isDark ? \'border-white/5\' : \'border-slate-200\'}`}>\n                  <label className={`text-[10px] font-black flex items-center mb-2.5 uppercase tracking-wider ${isDark ? \'text-zinc-400\' : \'text-slate-600\'}`}>\n                    <Ticket className={`w-3 h-3 mr-1.5 ${highlightText}`} />\n                    \345\234\250\347\272\277\345\217\257\347\224\250\345\215\241\345\210\270\351\200\211\346\213\251 (Coupons)\n                  </label>\n\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <button\n                      onClick={() => setSelectedCouponCode(\'NEW\')}\n                      className={`p-2 rounded-xl border text-[10px] font-bold flex flex-col items-center justify-center transition-all cursor-pointer ${\n                        selectedCouponCode === \'NEW\'\n                          ? isMint\n                            ? \'border-teal-500 bg-teal-500/10 text-teal-600 scale-102 font-black shadow-xs\'\n                            : \'border-rose-500 bg-rose-500/10 text-rose-500 scale-102 font-black shadow-xs\'\n                          : isDark\n                          ? \'border-white/5 bg-white/5 text-zinc-400 hov