    replacement_chunks {
      target_content: "      ) : (\n        /* =================== WEEKLY GRID SCHEDULER VIEW =================== */\n        <div className=\"mt-3\">\n          {/* Week interval navigator panel */}\n          <div className=\"flex items-center justify-between bg-white px-3 py-2 border border-slate-100 rounded-2xl mb-4\">\n            <button\n              onClick={() => handleWeekChange(-1)}\n              className=\"p-1 rounded-full text-slate-500 hover:bg-slate-100 transition\"\n              id=\"weekly-prev\"\n            >\n              <ChevronLeft className=\"w-5 h-5\" />\n            </button>\n\n            <span className=\"text-xs font-bold text-slate-700 tracking-tight font-mono\">\n              {weeklyGridDates[0].dayNum} \350\207\263 {weeklyGridDates[6].dayNum}\n            </span>\n\n            <button\n              onClick={() => handleWeekChange(1)}\n              className=\"p-1 rounded-full text-slate-500 hover:bg-slate-100 transition\"\n              id=\"weekly-next\"\n            >\n              <ChevronRight className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Grid layout panel scrollable horizontally */}\n          <div className=\"bg-white border border-slate-150 rounded-2xl overflow-hidden shadow-xs\">\n            <div className=\"overflow-x-auto\">\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-slate-100 border-b border-slate-100 bg-slate-50\">\n                {/* Time header label cell */}\n                <div className=\"p-2 py-3 text-center text-[10px] font-bold text-slate-400 font-mono\">\n                  \346\227\266\351\227\264\n                </div>\n\n                {/* 7 Columns titles of date */}\n                {weeklyGridDates.map((col, idx) => {\n                  const isDateSelected = selectedDateStr === col.dateStr;\n                  return (\n                    <button\n                      key={idx}\n                      onClick={() => {\n                        setSelectedDateStr(col.dateStr);\n                        setViewMode(\'day\'); // Slide back to daily of that picked list\n                        addToast(`\345\267\262\350\267\263\350\275\254\350\207\263 ${col.dateStr} \350\257\246\347\273\206\350\257\276\350\241\250`, \'info\');\n                      }}\n                      className={`p-2 py-3 text-center transition flex flex-col items-center justify-center hover:bg-slate-100 ${\n                        isDateSelected ? \'bg-teal-50/50 border-t-2 border-teal-500\' : \'\'\n                      }`}\n                    >\n                      <span className=\"text-[10px] text-slate-500 block font-medium\">\n                        {col.dayLabel}\n                      </span>\n                      <span className={`text-[11px] font-bold mt-0.5 ${isDateSelected ? \'text-teal-600\' : \'text-slate-800\'}`}>\n                        {col.dayNum}\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Weekly Timeline Slots Body */}\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-slate-100 font-mono\">\n                {/* Simulated time intervals rows */}\n                <div className=\"col-span-1 divide-y divide-slate-100\">\n                  {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((time) => (\n                    <div key={time} className=\"h-28 p-2 text-center flex items-center justify-center text-[11px] font-bold text-slate-400 bg-slate-50 border-b border-slate-100\">\n                      {time}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Grid cells representing dance categories slots */}\n                {weeklyGridDates.map((col, colIdx) => {\n                  const dayClasses = classes.filter(c => c.date === col.dateStr);\n\n                  return (\n                    <div key={colIdx} className=\"col-span-1 divide-y divide-slate-100 min-h-[500px]\">\n                      {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((timeSlot) => {\n                        // Find if any class matches this general time starting slot index\n                        const classMatch = dayClasses.find(c => c.timeStart === timeSlot);\n                        const isBooked = classMatch ? bookedClassIds.includes(classMatch.id) : false;\n\n                        return (\n                          <div key={timeSlot} className=\"h-28 p-1 relative flex flex-col justify-between border-b border-slate-100\">\n                            {classMatch ? (\n                              <div\n                                onClick={() => {\n                                  setSelectedDateStr(col.dateStr);\n                                  setViewMode(\'day\'); // Direct go to detail on click\n                                  addToast(`\346\202\250\347\202\271\345\207\273\344\272\206 ${classMatch.title}\357\274\214\350\277\233\345\205\245\345\215\225\346\227\245\346\250\241\345\274\217\347\256\241\347\220\206\351\242\204\347\272\246`, \'info\');\n                                }}\n                                className={`w-full h-full rounded-lg p-1.5 text-left text-white leading-tight cursor-pointer overflow-hidden transition-all hover:brightness-95 flex flex-col justify-between ${\n                                  isBooked\n                                    ? \'bg-teal-600 shadow-xs shadow-teal-500/20 ring-1 ring-white/20\'\n                                    : classMatch.genre === \'hiphop\'\n                                    ? \'bg-sky-500\'\n                                    : classMatch.genre === \'jazz\'\n                                    ? \'bg-fuchsia-500\'\n                                    : classMatch.genre === \'urban\'\n                                    ? \'bg-orange-500\'\n                                    : \'bg-indigo-500\'\n                                }`}\n                              >\n                                <div>\n                                  <div className=\"text-[9px] truncate font-extrabold tracking-tight\">\n                                    {classMatch.title}\n                                  </div>\n                                  <div className=\"text-[8px] opacity-90 truncate\">\n                                    {classMatch.timeStart}~{classMatch.timeEnd}\n                                  </div>\n                                  <div className=\"text-[8px] font-bold tracking-wider capitalize\">\n                                    {classMatch.teacher.name}\n                                  </div>\n                                </div>\n\n                                <div className=\"flex items-center justify-between mt-1\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white/35 text-[8px] font-bold px-1 rounded truncate\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/15 text-[8px] font-bold px-1 rounded truncate\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n                              <div className=\"w-full h-full text-slate-150 flex items-center justify-center text-[10px] select-none\">\n                                -\n                              </div>\n                            )}\n                          </div>\n                        );\n                      })}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <p className=\"text-[10px] text-slate-400 mt-2 text-center leading-relaxed\">\n            * \346\217\220\347\244\272: \345\221\250\350\257\276\350\241\250\351\242\234\350\211\262\344\273\243\350\241\250\344\270\215\345\220\214\350\210\236\347\247\215\351\243\216\346\240\274\345\210\206\347\261\273 (Hiphop, Jazz, Urban, Standard)\343\200\202\347\202\271\345\207\273\345\215\241\347\211\207\357\274\214\345\215\263\345\217\257\350\267\263\350\275\254\350\207\263\345\215\225\346\227\245\350\257\276\350\241\250\346\237\245\347\234\213\345\256\214\346\225\264\350\257\246\346\203\205\345\217\212\345\256\214\346\210\220\351\242\204\345\256\232\351\200\200\350\256\242\343\200\202\n          </p>\n        </div>\n      )}"
      replacement_content: "      ) : (\n        /* =================== WEEKLY GRID SCHEDULER VIEW =================== */\n        <div className=\"mt-3\">\n          {/* Week interval navigator panel */}\n          <div className=\"flex items-center justify-between bg-white px-3 py-2 border-2 border-indigo-950 rounded-[20px] mb-4 shadow-xs\">\n            <button\n              onClick={() => handleWeekChange(-1)}\n              className=\"p-1.5 rounded-full text-indigo-900 hover:bg-rose-50 hover:text-rose-500 transition cursor-pointer\"\n              id=\"weekly-prev\"\n            >\n              <ChevronLeft className=\"w-5 h-5\" />\n            </button>\n\n            <span className=\"text-xs font-black text-indigo-950 tracking-tight font-mono\">\n              {weeklyGridDates[0].dayNum} \350\207\263 {weeklyGridDates[6].dayNum}\n            </span>\n\n            <button\n              onClick={() => handleWeekChange(1)}\n              className=\"p-1.5 rounded-full text-indigo-900 hover:bg-rose-50 hover:text-rose-500 transition cursor-pointer\"\n              id=\"weekly-next\"\n            >\n              <ChevronRight className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* Grid layout panel scrollable horizontally */}\n          <div className=\"bg-white border-2 border-indigo-955 border-indigo-900 rounded-[20px] overflow-hidden shadow-sm\">\n            <div className=\"overflow-x-auto select-none\">\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x-2 divide-indigo-50 border-b-2 border-indigo-100 bg-indigo-50/30\">\n                {/* Time header label cell */}\n                <div className=\"p-2 py-3 text-center text-[10px] font-black text-indigo-400 font-mono\">\n                  \346\227\266\351\227\264\n                </div>\n\n                {/* 7 Columns titles of date */}\n                {weeklyGridDates.map((col, idx) => {\n                  const isDateSelected = selectedDateStr === col.dateStr;\n                  return (\n                    <button\n                      key={idx}\n                      onClick={() => {\n                        setSelectedDateStr(col.dateStr);\n                        setViewMode(\'day\'); // Slide back to daily of that picked list\n                        addToast(`\345\267\262\350\267\263\350\275\254\350\207\263 ${col.dateStr} \350\257\246\347\273\206\350\257\276\350\241\250`, \'info\');\n                      }}\n                      className={`p-2 py-3 text-center transition flex flex-col items-center justify-center hover:bg-rose-50 cursor-pointer ${\n                        isDateSelected ? \'bg-indigo-100/50 border-t-4 border-rose-500\' : \'\'\n                      }`}\n                    >\n                      <span className=\"text-[9px] text-indigo-405 text-indigo-400 block font-bold\">\n                        {col.dayLabel}\n                      </span>\n                      <span className={`text-[11px] font-black mt-0.5 ${isDateSelected ? \'text-rose-600\' : \'text-indigo-950\'}`}>\n                        {col.dayNum}\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Weekly Timeline Slots Body */}\n              <div className=\"min-w-[640px] grid grid-cols-8 divide-x divide-indigo-50 font-mono\">\n                {/* Simulated time intervals rows */}\n                <div className=\"col-span-1 divide-y divide-indigo-50\">\n                  {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((time) => (\n                    <div key={time} className=\"h-28 p-2 text-center flex items-center justify-center text-[10px] font-black text-indigo-400 bg-indigo-50/20 border-b border-indigo-50\">\n                      {time}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Grid cells representing dance categories slots */}\n                {weeklyGridDates.map((col, colIdx) => {\n                  const dayClasses = classes.filter(c => c.date === col.dateStr);\n\n                  return (\n                    <div key={colIdx} className=\"col-span-1 divide-y divide-indigo-50 min-h-[500px]\">\n                      {[\'10:30\', \'13:00\', \'14:00\', \'15:00\', \'16:30\', \'18:30\'].map((timeSlot) => {\n                        // Find if any class matches this general time starting slot index\n                        const classMatch = dayClasses.find(c => c.timeStart === timeSlot);\n                        const isBooked = classMatch ? bookedClassIds.includes(classMatch.id) : false;\n\n                        return (\n                          <div key={timeSlot} className=\"h-28 p-1 relative flex flex-col justify-between border-b border-indigo-50 bg-white\">\n                            {classMatch ? (\n                              <div\n                                onClick={() => {\n                                  setSelectedDateStr(col.dateStr);\n                                  setViewMode(\'day\'); // Direct go to detail on click\n                                  addToast(`\346\202\250\347\202\271\345\207\273\344\272\206 ${classMatch.title}\357\274\214\350\277\233\345\205\245\345\215\225\346\227\245\346\250\241\345\274\217\347\256\241\347\220\206\351\242\204\347\272\246`, \'info\');\n                                }}\n                                className={`w-full h-full rounded-xl p-1.5 text-left text-white leading-none cursor-pointer overflow-hidden transition-all hover:brightness-95 flex flex-col justify-between border border-black/10 ${\n                                  isBooked\n                                    ? \'bg-rose-500 shadow-sm shadow-rose-200/50\'\n                                    : classMatch.genre === \'hiphop\'\n                                    ? \'bg-indigo-900 border-indigo-950\'\n                                    : classMatch.genre === \'jazz\'\n                                    ? \'bg-indigo-600\'\n                                    : classMatch.genre === \'urban\'\n                                    ? \'bg-amber-500\'\n                                    : \'bg-indigo-500\'\n                                }`}\n                              >\n                                <div>\n                                  <div className=\"text-[9px] truncate font-extrabold tracking-tight\">\n                                    {classMatch.title}\n                                  </div>\n                                  <div className=\"text-[8px] opacity-90 truncate leading-none mt-0.5\">\n                                    {classMatch.timeStart}~{classMatch.timeEnd}\n                                  </div>\n                                  <div className=\"text-[8px] font-black tracking-wide truncate mt-0.5\">\n                                    {classMatch.teacher.name}\n                                  </div>\n                                </div>\n\n                                <div className=\"flex items-center justify-between mt-1 pt-0.5 border-t border-white/10\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white text-rose-500 text-[8px] font-black px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/15 text-white text-[8px] font-bold px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n                              <div className=\"w-full h-full text-indigo-100 flex items-center justify-center text-[10px] select-none font-bold\">\n                                -\n                              </div>\n                            )}\n                          </div>\n                        );\n                      })}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <p className=\"text-[9px] text-indigo-400 mt-2 text-center leading-relaxed font-bold\">\n            * \346\217\220\347\244\272: \350\210\236\344\274\264\346\216\222\346\234\237\351\242\234\350\211\262\344\273\243\350\241\250\350\210\236\347\247\215\351\243\216\346\240\274\345\210\206\347\261\273\343\200\202\351\242\204\347\272\246\350\257\276\347\250\213\345\260\206\350\207\252\345\212\250\346\240\207\347\272\242\357\274\214\347\202\271\345\207\273\345\215\241\347\211\207\347\233\264\346\216\245\350\267\263\350\275\254\343\200\202\n          </p>\n        </div>\n      )}"
