    replacement_chunks {
      target_content: "                                <div className=\"flex items-center justify-between mt-1 pt-0.5 border-t border-white/10\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white text-rose-500 text-[8px] font-black px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/15 text-white text-[8px] font-bold px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      {classMatch.bookedCount}/{classMatc      {/* ==================== SCREEN DIALOG 1: CALENDAR MODAL (Image 9) ==================== */}\n      <AnimatePresence>\n        {isCalendarOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n            {/* Overlay sheet backdrop */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsCalendarOpen(false)}\n              className=\"absolute inset-0 bg-indigo-950/75 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Modal Body Container */}\n            <motion.div\n              initial={{ scale: 0.95, opacity: 0, y: 15 }}\n              animate={{ scale: 1, opacity: 1, y: 0 }}\n              exit={{ scale: 0.95, opacity: 0, y: 15 }}\n              className=\"bg-white rounded-[32px] w-full max-w-sm overflow-hidden shadow-2xl relative z-10 border-4 border-yellow-400\"\n            >\n              {/* Month selector header */}\n              <div className=\"bg-indigo-955 bg-indigo-900 p-4 border-b-2 border-indigo-950 flex items-center justify-between text-white\">\n                <span className=\"text-xs text-rose-300 font-black tracking-tight uppercase\">\346\234\210\345\216\206\346\227\245\346\234\237\351\200\211\346\213\251</span>\n                <span className=\"text-base font-black text-yellow-300 font-mono\">2026-05</span>\n                <span className=\"text-[10px] bg-rose-500 text-white font-black px-2.5 py-0.5 rounded-full font-mono uppercase\">\344\273\212\345\244\251: 25\346\227\245</span>\n              </div>\n\n              {/* Calendar Grid mockup elements */}\n              <div className=\"p-4\" id=\"calendar-grid-box\">\n                {/* Row day labels */}\n                <div className=\"grid grid-cols-7 text-center mb-2\">\n                  {[\'\346\227\245\', \'\344\270\200\', \'\344\272\214\', \'\344\270\211\', \'\345\233\233\', \'\344\272\224\', \'\345\205\255\'].map((day) => (\n                    <span key={day} className=\"text-[11px] text-indigo-455 text-indigo-400 font-black py-1\">\n                      {day}\n                    </span>\n                  ))}\n                </div>\n\n                <div className=\"grid grid-cols-7 text-center gap-1.5 font-mono\">\n                  {/* Empty cells for May offset (Starts on Friday, 1st) */}\n                  {Array.from({ length: 5 }).map((_, idx) => (\n                    <span key={`empty_${idx}`} className=\"text-indigo-150 text-xs py-1.5\">-</span>\n                  ))}\n\n                  {/* Days grid generator from 1 to 31 */}\n                  {Array.from({ length: 31 }).map((_, idx) => {\n                    const dayNumStr = String(idx + 1).padStart(2, \'0\');\n                    const fullDateStr = `2026-05-${dayNumStr}`;\n                    const isToday = dayNumStr === \'25\';\n                    const isBookableRange = idx + 1 >= 24 && idx + 1 <= 31; // Enabled only matching dates\n                    const isCurrentSelected = selectedDateStr === fullDateStr;\n\n                    return (\n                      <button\n                        key={idx}\n                        disabled={!isBookableRange}\n                        onClick={() => handleCalendarPickDate(fullDateStr)}\n                        className={`text-xs py-1.5 font-black rounded-xl transition relative cursor-pointer ${\n                          isCurrentSelected\n                            ? \'bg-indigo-900 text-white shadow shadow-yellow-250 border-b-2 border-yellow-400\'\n                            : isToday\n                            ? \'border-2 border-rose-500 text-rose-500 bg-rose-50/20\'\n                            : isBookableRange\n                            ? \'text-indigo-950 hover:bg-rose-50 hover:text-rose-505\'\n                            : \'text-indigo-155 cursor-not-allowed text-[10px]\'\n                        }`}\n                      >\n                        {idx + 1}\n                        {isToday && (\n                          <span className=\"absolute bottom-0.5 left-1/2 transform -translate-x-1/2 w-1.5 h-1.5 bg-rose-500 rounded-full\"></span>\n                        )}\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Bottom close footer buttons */}\n              <div className=\"border-t border-indigo-100 p-3 bg-indigo-50/40 flex items-center justify-between\">\n                <button\n                  onClick={() => handleCalendarPickDate(\'2026-05-25\')}\n                  className=\"text-xs text-rose-550 text-rose-550 text-rose-600 font-black hover:underline cursor-pointer\"\n                >\n                  \345\233\236\344\273\212\345\244\251 (5-25)\n                </button>\n                <button\n                  onClick={() => setIsCalendarOpen(false)}\n                  className=\"px-4 py-1.5 bg-white border border-indigo-150 text-indigo-950 hover:bg-yellow-50 hover:border-yellow-450 text-xs font-black rounded-full transition cursor-pointer\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== SCREEN DIALOG 2: FILTER DRAWER (Image 8) ==================== */}\n      <AnimatePresence>\n        {isFilterOpen && (\n          <div className=\"fixed inset-0 z-50 overflow-hidden\">\n            {/* Drawer Backdrop overlay */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsFilterOpen(false)}\n              className=\"absolute inset-0 bg-indigo-950/70 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Slider Content block */}\n            <div className=\"absolute inset-y-0 right-0 max-w-full flex pl-10\">\n              <motion.div\n                initial={{ x: \'100%\' }}\n                animate={{ x: 0 }}\n                exit={{ x: \'100%\' }}\n                transition={{ type: \'spring\', damping: 25, stiffness: 220 }}\n                className=\"w-screen max-w-xs bg-white border-l-4 border-indigo-950 flex flex-col shadow-2xl\"\n              >\n                {/* Header title */}\n                <div className=\"p-4 border-b border-indigo-10s border-indigo-100 flex items-center justify-between bg-indigo-950 text-white\">\n                  <span className=\"font-black text-yellow-300\">\350\257\276\347\250\213\346\240\207\347\255\276\347\255\233\351\200\211</span>\n                  <button\n                    onClick={() => setIsFilterOpen(false)}\n                    className=\"text-white hover:text-rose-350 text-base font-black cursor-pointer\"\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n\n                <div className=\"flex-1 overflow-y-auto p-4 space-y-6\">\n                  {/* Classroom Selector block */}\n                  <div>\n                    <h4 className=\"text-[11px] font-black text-indigo-900 uppercase tracking-wider mb-2.5\">\n                      \346\225\231\345\256\244 (Classroom)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                       {classroomsList.map((room) => {\n                        const isSel = tempRoom === room;\n                        return (\n                          <button\n                            key={room}\n                            onClick={() => setTempRoom(room)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? \'bg-rose-500 border-rose-500 text-white shadow font-black scale-105\'\n                                : \'bg-indigo-50 border-2 border-indigo-100 text-indigo-900 hover:border-indigo-305 font-bold\'\n                            }`}\n                          >\n                            {room}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n\n                  {/* Teachers Selector block */}\n                  <div>\n                    <h4 className=\"text-[11px] font-black text-indigo-900 uppercase tracking-wider mb-2.5\">\n                      \350\200\201\345\270\210 (Instructor)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-1.5\">\n                      <button\n                        onClick={() => setTempTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\')}\n                        className={`px-3 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                          tempTeacherId === \'\345\205\250\351\203\250\350\200\201\345\270\210\'\n                            ? \'bg-rose-500 border-rose-505 text-white shadow font-black scale-105\'\n                            : \'bg-indigo-50 border-2 border-indigo-100 text-indigo-900 hover:border-indigo-305 font-bold\'\n                        }`}\n                      >\n                        \345\205\250\351\203\250\350\200\201\345\270\210\n                      </button>\n\n                      {TEACHERS.map((teacher) => {\n                        const isSel = tempTeacherId === teacher.id;\n                        return (\n                          <button\n                            key={teacher.id}\n                            onClick={() => setTempTeacherId(teacher.id)}\n                            className={`px-3 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? \'bg-rose-505 border-rose-505 text-white shadow font-black scale-105\'\n                                : \'bg-indigo-50 border-2 border-indigo-100 text-indigo-900 hover:border-indigo-305 font-bold\'\n                            }`}\n                          >\n                            {teacher.name}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Trigger controls with \"\351\207\215\347\275\256\" & \"\347\241\256\350\256\244\" */}\n                <div className=\"p-4 border-t border-indigo-100 grid grid-cols-2 gap-3 bg-indigo-50/30\">\n                  <button\n                    onClick={resetDrawerFilters}\n                    className=\"w-full py-2.5 border-2 border-indigo-200 hover:bg-rose-55 hover:border-rose-300 text-indigo-905 text-indigo-900 text-xs font-black rounded-full transition cursor-pointer bg-white\"\n                  >\n                    \351\207\215\347\275\256\n                  </button>\n                  <button\n                    onClick={applyDrawerFilters}\n                    className=\"w-full py-2.5 bg-indigo-900 hover:bg-indigo-805 text-white hover:bg-indigo-800 text-xs font-black rounded-[24px] shadow-md transition cursor-pointer\"\n                  >\n                    \347\241\256\350\256\244\n                  </button>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        )}\n      </AnimatePresence> );\n                      })}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Trigger controls with \"\351\207\215\347\275\256\" & \"\347\241\256\350\256\244\" */}\n                <div className=\"p-4 border-t border-slate-100 grid grid-cols-2 gap-3 bg-slate-50\">\n                  <button\n                    onClick={resetDrawerFilters}\n                    className=\"w-full py-2.5 border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer\"\n                  >\n                    \351\207\215\347\275\256\n                  </button>\n                  <button\n                    onClick={applyDrawerFilters}\n                    className=\"w-full py-2.5 bg-teal-500 hover:bg-teal-600 text-white text-xs font-bold rounded-xl shadow-sm shadow-teal-400/35 transition cursor-pointer\"\n                  >\n                    \347\241\256\350\256\244\n                  </button>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
      replacement_content: "                                <div className=\"flex items-center justify-between mt-1 pt-0.5 border-t border-white/10\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white text-rose-500 text-[8px] font-black px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/15 text-white text-[8px] font-bold px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n                              <div className=\"w-full h-full text-indigo-100 flex items-center justify-center text-[10px] select-none font-bold\">\n                                -\n                              </div>\n                            )}\n                          </div>\n                        );\n                      })}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <p className=\"text-[9px] text-indigo-400 mt-2 text-center leading-relaxed font-bold\">\n            * \346\217\220\347\244\272: \350\210\236\344\274\264\346\216\222\346\234\237\351\242\234\350\211\262\344\273\243\350\241\250\350\210\236\347\247\215\351\243\216\346\240\274\345\210\206\347\261\273\343\200\202\351\242\204\347\272\246\350\257\276\347\250\213\345\260\206\350\207\252\345\212\250\346\240\207\347\272\242\357\274\214\347\202\271\345\207\273\345\215\241\347\211\207\347\233\264\346\216\245\350\267\263\350\275\254\343\200\202\n          </p>\n        </div>\n      )}\n\n      {/* ==================== SCREEN DIALOG 1: CALENDAR MODAL (Image 9) ==================== */}\n      <AnimatePresence>\n        {isCalendarOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n            {/* Overlay sheet backdrop */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsCalendarOpen(false)}\n              className=\"absolute inset-0 bg-indigo-950/75 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Modal Body Container */}\n            <motion.div\n              initial={{ scale: 0.95, opacity: 0, y: 15 }}\n              animate={{ scale: 1, opacity: 1, y: 0 }}\n              exit={{ scale: 0.95, opacity: 0, y: 15 }}\n              className=\"bg-white rounded-[32px] w-full max-w-sm overflow-hidden shadow-2xl relative z-10 border-4 border-yellow-400\"\n            >\n              {/* Month selector header */}\n              <div className=\"bg-indigo-955 bg-indigo-900 p-4 border-b-2 border-indigo-950 flex items-center justify-between text-white\">\n                <span className=\"text-xs text-rose-300 font-black tracking-tight uppercase\">\346\234\210\345\216\206\346\227\245\346\234\237\351\200\211\346\213\251</span>\n                <span className=\"text-base font-black text-yellow-300 font-mono\">2026-05</span>\n                <span className=\"text-[10px] bg-rose-500 text-white font-black px-2.5 py-0.5 rounded-full font-mono uppercase\">\344\273\212\345\244\251: 25\346\227\245</span>\n              </div>\n\n              {/* Calendar Grid mockup elements */}\n              <div className=\"p-4\" id=\"calendar-grid-box\">\n                {/* Row day labels */}\n                <div className=\"grid grid-cols-7 text-center mb-2\">\n                  {[\'\346\227\245\', \'\344\270\200\', \'\344\272\214\', \'\344\270\211\', \'\345\233\233\', \'\344\272\224\', \'\345\205\255\'].map((day) => (\n                    <span key={day} className=\"text-[11px] text-indigo-400 font-black py-1\">\n                      {day}\n                    </span>\n                  ))}\n                </div>\n\n                <div className=\"grid grid-cols-7 text-center gap-1.5 font-mono\">\n                  {/* Empty cells for May offset (Starts on Friday, 1st) */}\n                  {Array.from({ length: 5 }).map((_, idx) => (\n                    <span key={`empty_${idx}`} className=\"text-indigo-100 text-xs py-1.5\">-</span>\n                  ))}\n\n                  {/* Days grid generator from 1 to 31 */}\n                  {Array.from({ length: 31 }).map((_, idx) => {\n                    const dayNumStr = String(idx + 1).padStart(2, \'0\');\n                    const fullDateStr = `2026-05-${dayNumStr}`;\n                    const isToday = dayNumStr === \'25\';\n                    const isBookableRange = idx + 1 >= 24 && idx + 1 <= 31; // Enabled only matching dates\n                    const isCurrentSelected = selectedDateStr === fullDateStr;\n\n                    return (\n                      <button\n                        key={idx}\n                        disabled={!isBookableRange}\n                        onClick={() => handleCalendarPickDate(fullDateStr)}\n                        className={`text-xs py-1.5 font-black rounded-xl transition relative cursor-pointer ${\n                          isCurrentSelected\n                            ? \'bg-indigo-900 text-white shadow shadow-yellow-250 border-b-2 border-yellow-400\'\n                            : isToday\n                            ? \'border-2 border-rose-500 text-rose-500 bg-rose-50/20\'\n                            : isBookableRange\n                            ? \'text-indigo-950 hover:bg-rose-50 hover:text-rose-500\'\n                            : \'text-indigo-150 cursor-not-allowed text-[10px]\'\n                        }`}\n                      >\n                        {idx + 1}\n                        {isToday && (\n                          <span className=\"absolute bottom-0.5 left-1/2 transform -translate-x-1/2 w-1.5 h-1.5 bg-rose-500 rounded-full\"></span>\n                        )}\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Bottom close footer buttons */}\n              <div className=\"border-t border-indigo-100 p-3 bg-indigo-50/40 flex items-center justify-between\">\n                <button\n                  onClick={() => handleCalendarPickDate(\'2026-05-25\')}\n                  className=\"text-xs text-rose-550 text-rose-600 font-black hover:underline cursor-pointer\"\n                >\n                  \345\233\236\344\273\212\345\244\251 (5-25)\n                </button>\n                <button\n                  onClick={() => setIsCalendarOpen(false)}\n                  className=\"px-4 py-1.5 bg-white border border-indigo-150 text-indigo-950 hover:bg-yellow-50 hover:border-yellow-400 text-xs font-black rounded-full transition cursor-pointer\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n\n      {/* ==================== SCREEN DIALOG 2: FILTER DRAWER (Image 8) ==================== */}\n      <AnimatePresence>\n        {isFilterOpen && (\n          <div className=\"fixed inset-0 z-50 overflow-hidden\">\n            {/* Drawer Backdrop overlay */}\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              onClick={() => setIsFilterOpen(false)}\n              className=\"absolute inset-0 bg-indigo-950/70 backdrop-blur-xs\"\n            ></motion.div>\n\n            {/* Slider Content block */}\n            <div className=\"absolute inset-y-0 right-0 max-w-full flex pl-10\">\n              <motion.div\n                initial={{ x: \'100%\' }}\n                animate={{ x: 0 }}\n                exit={{ x: \'100%\' }}\n                transition={{ type: \'spring\', damping: 25, stiffness: 220 }}\n                className=\"w-screen max-w-xs bg-white border-l-4 border-indigo-950 flex flex-col shadow-2xl\"\n              >\n                {/* Header title */}\n                <div className=\"p-4 border-b border-indigo-105 border-indigo-100 flex items-center justify-between bg-indigo-950 text-white\">\n                  <span className=\"font-black text-yellow-300\">\350\257\276\347\250\213\346\240\207\347\255\276\347\255\233\351\200\211</span>\n                  <button\n                    onClick={() => setIsFilterOpen(false)}\n                    className=\"text-white hover:text-rose-350 text-base font-black cursor-pointer\"\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n\n                <div className=\"flex-1 overflow-y-auto p-4 space-y-6\">\n                  {/* Classroom Selector block */}\n                  <div>\n                    <h4 className=\"text-[11px] font-black text-indigo-900 uppercase tracking-wider mb-2.5\">\n                      \346\225\231\345\256\244 (Classroom)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                       {classroomsList.map((room) => {\n                        const isSel = tempRoom === room;\n                        return (\n                          <button\n                            key={room}\n                            onClick={() => setTempRoom(room)}\n                            className={`px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? \'bg-rose-500 border-rose-500 text-white shadow font-black scale-105\'\n                                : \'bg-indigo-50 border-2 border-indigo-100 text-indigo-900 hover:border-indigo-300 font-bold\'\n                            }`}\n                          >\n                            {room}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n\n                  {/* Teachers Selector block */}\n                  <div>\n                    <h4 className=\"text-[11px] font-black text-indigo-900 uppercase tracking-wider mb-2.5\">\n                      \350\200\201\345\270\210 (Instructor)\n                    </h4>\n                    <div className=\"flex flex-wrap gap-1.5\">\n                      <button\n                        onClick={() => setTempTeacherId(\'\345\205\250\351\203\250\350\200\201\345\270\210\')}\n                        className={`px-3 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                          tempTeacherId === \'\345\205\250\351\203\250\350\200\201\345\270\210\'\n                            ? \'bg-rose-500 border-rose-500 text-white shadow font-black scale-105\'\n                            : \'bg-indigo-50 border-2 border-indigo-100 text-indigo-900 hover:border-indigo-300 font-bold\'\n                        }`}\n                      >\n                        \345\205\250\351\203\250\350\200\201\345\270\210\n                      </button>\n\n                      {TEACHERS.map((teacher) => {\n                        const isSel = tempTeacherId === teacher.id;\n                        return (\n                          <button\n                            key={teacher.id}\n                            onClick={() => setTempTeacherId(teacher.id)}\n                            className={`px-3 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer ${\n                              isSel\n                                ? \'bg-rose-500 border-rose-500 text-white shadow font-black scale-105\'\n                                : \'bg-indigo-50 border-2 border-indigo-100 text-indigo-900 hover:border-indigo-300 font-bold\'\n                            }`}\n                          >\n                            {teacher.name}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Trigger controls with \"\351\207\215\347\275\256\" & \"\347\241\256\350\256\244\" */}\n                <div className=\"p-4 border-t border-indigo-100 grid grid-cols-2 gap-3 bg-indigo-50/30\">\n                  <button\n                    onClick={resetDrawerFilters}\n                    className=\"w-full py-2.5 border-2 border-indigo-200 hover:bg-rose-50 hover:border-rose-300 text-indigo-900 text-xs font-black rounded-full transition cursor-pointer bg-white\"\n                  >\n                    \351\207\215\347\275\256\n                  </button>\n                  <button\n                    onClick={applyDrawerFilters}\n                    className=\"w-full py-2.5 bg-indigo-900 hover:bg-indigo-805 text-white hover:bg-indigo-800 text-xs font-black rounded-full shadow-md transition cursor-pointer\"\n                  >\n                    \347\241\256\350\256\244\n                  </button>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
    }
    instruction: "Surgically clean and rebuild ScheduleView from weekly grid cells to the end of file"
  }
}
