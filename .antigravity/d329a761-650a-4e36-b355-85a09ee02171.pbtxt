zz\'\n                                    ? \'bg-indigo-600\'\n                                    : classMatch.genre === \'urban\'\n                                    ? \'bg-amber-500\'\n                                    : \'bg-indigo-500\'\n                                }`}\n                              >\n                                <div>\n                                  <div className=\"text-[9px] truncate font-extrabold tracking-tight\">\n                                    {classMatch.title}\n                                  </div>\n                                  <div className=\"text-[8px] opacity-90 truncate leading-none mt-0.5\">\n                                    {classMatch.timeStart}~{classMatch.timeEnd}\n                                  </div>\n                                  <div className=\"text-[8px] font-black tracking-wide truncate mt-0.5\">\n                                    {classMatch.teacher.name}\n                                  </div>\n                                </div>\n\n                                <div className=\"flex items-center justify-between mt-1 pt-0.5 border-t border-white/10\">\n                                  {isBooked ? (\n                                    <span className=\"bg-white text-rose-500 text-[8px] font-black px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      \345\267\262\351\242\204\347\272\246\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-black/15 text-white text-[8px] font-bold px-1 rounded truncate leading-none scale-[0.9] origin-left\">\n                                      {classMatch.bookedCount}/{classMatch.maxCount}\344\272\272\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n                            ) : (\n       