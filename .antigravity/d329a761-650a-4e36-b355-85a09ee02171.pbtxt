5\233\242\350\257\276) | Private (\347\247\201\346\225\231) | Series (\347\217\255\350\257\276) */}\n          <div className=\"flex items-center justify-between mt-2 mb-2.5\">\n            <div className=\"bg-indigo-50 border border-indigo-100/60 p-1 rounded-xl flex space-x-1 shrink-0\">\n              <button\n                onClick={() => setActiveCourseType(\'group\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'group\'\n                    ? \'bg-rose-500 text-white shadow-md\'\n                    : \'text-indigo-900 hover:bg-indigo-100/50\'\n                }`}\n                id=\"btn-group-class\"\n              >\n                \345\233\242\350\257\276\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'private\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'private\'\n                    ? \'bg-rose-500 text-white shadow-md\'\n                    : \'text-indigo-900 hover:bg-indigo-100/50\'\n                }`}\n                id=\"btn-private-class\"\n              >\n                \347\247\201\346\225\231\n              </button>\n              <button\n                onClick={() => setActiveCourseType(\'series\')}\n                className={`text-[11px] px-3.5 py-1 rounded-lg font-black transition-all cursor-pointer ${\n                  activeCourseType === \'series\'\n                    ? \'bg-rose-500 text-white shadow-md\'\n                    : \'text-indigo-900 hover:bg-indigo-100/50\'\n                }`}\n                id=\"btn-series-class\"\n              >\n                \347\217\255\350\257\276\n              </button>\n            </div>\n\n            {/* Quick action buttons: Bookable switch & Month Calendar Icon */}\n            <div className=\"flex items-center sp