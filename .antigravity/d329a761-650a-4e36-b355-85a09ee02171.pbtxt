ass */}\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center space-x-1.5 flex-wrap\">\n                          <h3 className=\"font-extrabold text-indigo-950 text-sm tracking-tight truncate leading-tight\">\n                            {cls.title}\n                          </h3>\n                        </div>\n\n                        {/* Dance genre text styled */}\n                        <div className=\"flex items-center text-xs text-indigo-400 mt-1 space-x-1 font-sans font-bold\">\n                          <span className=\"text-indigo-900 font-black\">{cls.teacher.name}</span>\n                          <span className=\"text-indigo-200 font-normal\">\342\200\242</span>\n                          <span className=\"capitalize\">{cls.genre}</span>\n                          <span className=\"text-indigo-200 font-normal\">\342\200\242</span>\n                          <span className=\"flex items-center\">\n                            \351\232\276\345\272\246 {renderStars(cls.difficulty)}\n                          </span>\n                        </div>\n\n                        {/* Booking classroom and capacity ratios */}\n                        <div className=\"text-[11px] text-indigo-500 mt-1 font-mono space-y-0.5 font-bold\">\n                          <div>{cls.classroom} \342\200\242 \346\273\241{cls.minPeople}\344\272\272\345\274\200\350\257\276</div>\n                          <div className=\"flex items-center mt-1\">\n                            <span className=\"mr-1.5\">\345\267\262\351\242\204\347\272\246:</span>\n                            <span className={`font-black ${isFull ? \'text-rose-500\' : \'text-indigo-950\'}`}>\n                              {cls.bookedCount}\n                            </span>\n                            <span className=\"text-indigo-200 mx-0.5\">/</span>\n                            <span>{cls.maxCount}\344\272\272</span>\n\n                  