=\"mt-6 p-4 rounded-[24px] bg-[#181926] text-[#cbd5e1] border border-white/5 flex items-start space-x-3.5 shadow-lg\" id=\"store-faq\">\n        <ShieldCheck className=\"w-5 h-5 text-rose-455 text-rose-400 shrink-0 mt-0.5\" />\n        <div className=\"text-[10px] leading-relaxed space-y-1\">\n          <p className=\"font-extrabold text-xs text-white\">PLANA \350\264\255\350\257\276\345\256\211\345\205\250\344\277\235\351\232\234\347\273\206\345\210\231</p>\n          <p className=\"text-zinc-400 font-medium\">\342\200\242 7\345\244\251\351\200\200\345\214\205\344\277\235\351\232\234: \346\226\260\345\215\241\350\207\252\350\264\255\345\214\205\350\265\2677\345\244\251\345\206\205\357\274\214\350\213\245\346\234\252\350\277\233\350\241\214\344\273\273\344\275\225\345\244\247\350\257\276\351\242\204\350\256\242\346\266\210\350\257\276\357\274\214\345\235\207\345\217\257\346\227\240\345\201\277\345\220\221\345\256\242\346\234\215\347\224\263\350\257\267\347\247\222\347\272\247\351\200\200\346\254\276\346\254\276\351\241\271\343\200\202</p>\n          <p className=\"text-zinc-400 font-medium\">\342\200\242 \350\207\252\345\212\250\345\206\273\347\273\223\345\273\266\346\234\237: \347\224\250\346\210\267\350\213\245\351\201\207\347\252\201\345\217\221\347\224\237\347\227\205\343\200\201\345\207\272\345\267\256\357\274\214\345\217\257\345\234\250\344\270\212\350\257\276\345\211\215\345\257\271\345\215\241\345\214\205\347\224\263\350\257\267\344\270\272\346\234\23714\345\244\251\347\232\204\344\270\264\346\227\266\345\206\273\347\273\223\357\274\214\344\277\235\350\257\201\350\257\276\346\254\241\345\244\251\346\225\260\345\273\266\346\234\237\344\270\215\350\242\253\346\211\243\350\200\227\343\200\202</p>\n        </div>\n      </div>"
      replacement_content: "  return (\n    <div className={`flex-1 overflow-y-auto px-4 pb-20 pt-4 transition-colors duration-500 ${bgClass}`} id=\"store-view-container\">\n      {/* Studio Banner section */}\n      <div className={`flex items-center justify-between pb-3 border-b ${headerBorder} mb-3`}>\n        <div>\n          <h2 className={`text-sm font-black uppercase tracking-wider ${textWhite}`}>\345\205\205\345\200\274\350\264\255\345\215\241</h2>\n          <p className=\"text-[8px] text-zinc-500 font-bold tracking-widest mt-1\">PLANA DANCE PASSES CENTER</p>\n        </div>\n        <div className=\"text-right flex flex-col items-end\">\n          <span className={`text-[9px] font-black ${isDark ? \'text-zinc-400\' : \'text-slate-500\'}`}>\345\217\257\347\224\250\350\257\276\345\205\205\347\202\271</span>\n          <span className={`text-xs font-mono font-black px-2.5 py-1 rounded-lg leading-none border mt-1 shadow-sm ${\n            isMint \n              ? \'text-teal-600 bg-teal-500/10 border-teal-555 border-teal-500/20\' \n              : \'text-rose-500 border border-rose-500/20 bg-rose-500/10\'\n          }`}>\n            {userPasses} \346\254\241\n          </span>\n        </div>\n      </div>\n\n      {/* Promotional Notice box */}\n      <div className={`mt-3 border p-4 rounded-2xl flex items-start space-x-2.5 shadow-md bg-gradient-to-r ${\n        isMint \n          ? \'from-teal-500/5 to-emerald-500/10 border-teal-500/20\' \n          : \'from-pink-500/5 to-rose-550/10 border-rose-500/20\'\n      }`}>\n        <Sparkles className={`w-5 h-5 shrink-0 mt-0.5 ${isMint ? \'text-teal-500\' : \'text-rose-455 text-rose-400\'}`} />\n        <div className=\"text-[11px] leading-relaxed font-sans\">\n          <p className={`font-extrabold text-xs ${textWhite}`}>\346\226\260\344\274\232\345\221\230\347\211\271\346\203\240\347\246\217\345\210\251\345\244\247\346\224\276\351\200\201 \360\237\216\201</p>\n          <p className={`mt-1 font-medium text-xs leading-relaxed ${textSecondary}`}>\n            \351\246\226\346\254\241\346\263\250\345\206\214\345\215\263\345\217\257\345\234\250\347\273\223\350\264\246\351\241\265\344\272\253\345\217\227\351\246\226\345\215\225 <strong className={isMint ? \'text-teal-600\' : \'text-rose-500 text-rose-405\'}>\302\24515 OFF</strong> \347\216\260\351\207\221\347\253\213\345\207\217\346\211\243\345\207\217\343\200\202\345\215\241\345\210\270\345\217\257\344\270\216\345\205\266\344\273\226\344\274\230\346\203\240\347\264\257\345\212\240\357\274\214\346\234\252\347\224\250\345\256\214\345\214\205\346\215\242\345\214\205\351\200\200\357\274\214\346\224\257\346\214\201\351\232\217\346\227\266\345\206\273\347\273\223\343\200\202\n          </p>\n        </div>\n      </div>\n\n      {/* Main cards lists Grid */}\n      <div className=\"mt-5 space-y-4\" id=\"passes-catalog\">\n        <h3 className={`text-[10px] font-black uppercase tracking-widest pl-2 border-l-2 ${highlightText} ${isDark ? \'text-zinc-400\' : \'text-slate-600\'}`}>\n          \350\207\252\344\277\256\345\233\242\350\257\276\346\254\241\345\215\241/\344\274\232\345\221\230\351\200\232\345\215\241 / Memberships Package\n        </h3>\n\n        {PAYMENT_CARDS.map((card) => {\n          const discountLabel = card.originalPrice\n            ? `\347\234\201 \302\245${card.originalPrice - card.price}`\n            : null;\n\n          return (\n            <div\n              key={card.id}\n              className={`rounded-[24px] border p-4.5 relative overflow-hidden flex flex-col justify-between shadow-lg transition-all duration-300 ${cardBgClass} ${cardBorder}`}\n            >\n              {/* Badge upper-right */}\n              {card.badge && (\n                <span className={`absolute top-0 right-0 text-white font-black text-[8px] px-3.5 py-1 rounded-bl-xl tracking-wider uppercase border-l border-b ${\n                  isMint ? \'bg-teal-600 border-teal-500/10\' : \'bg-rose-500 border-rose-550 border-rose-500/10\'\n                }`}>\n                  {card.badge}\n                </span>\n              )}\n\n              {/* Card specs top row */}\n              <div>\n                <h4 className={`font-extrabold text-sm pr-14 leading-tight ${textWhite}`}>\n                  {card.title}\n                </h4>\n                <p className={`text-[9px] font-mono font-bold mt-1 tracking-tight ${isDark ? \'text-zinc-500\' : \'text-slate-500\'}`}>\n                  \346\234\211\346\225\210\346\234\237: {card.validDays} \345\244\251 \342\200\242 {\' \'}\n                  {card.passes === -1 ? \'\344\270\215\351\231\220\346\234\237/\344\270\212\350\257\276\346\254\241\346\225\260\351\231\220\345\210\266\' : `\345\244\247\350\257\276\345\205\261 ${card.passes} \350\257\276\346\227\266`}\n                </p>\n                <p className={`text-[11px] mt-2 leading-relaxed font-sans font-medium ${isDark ? \'text-zinc-400\' : \'text-slate-600\'}`}>\n                  {card.description}\n                </p>\n              </div>\n\n              {/* Price elements & Purchase trigger controls */}\n              <div className={`mt-4 pt-3.5 border-t border-dashed flex items-center justify-between ${isDark ? \'border-white/5\' : \'border-slate-200\'}`}>\n                <div className=\"flex items-baseline space-x-1 font-mono\">\n                  <span className={`text-[10px] font-black ${isDark ? \'text-zinc-500\' : \'text-slate-400\'}`}>\302\245</span>\n                  <span className={`text-xl font-black leading-none ${textWhite}`}>\n                    {card.price}\n                  </span>\n\n                  {card.originalPrice && (\n                    <span className={`text-xs font-bold line-through ml-1.5 ${isDark ? \'text-zinc-600\' : \'text-slate-400\'}`}>\n                      \302\245{card.originalPrice}\n                    </span>\n                  )}\n\n                  {discountLabel && (\n                    <span className={`text-[8px] font-black px-1.5 py-0.5 rounded ml-2.5 leading-none ${badgeClass}`}>\n                      {discountLabel}\n                    </span>\n                  )}\n                </div>\n\n                <button\n                  onClick={() => setSelectedCard(card)}\n                  className={`font-black text-xs px-5 py-2.5 rounded-full cursor-pointer hover:scale-103 active:scale-95 transition-all shadow-lg ${\n                    isDark \n                      ? \'bg-white hover:bg-zinc-100 text-[#0c0d14]\'\n                      : \'bg-slate-900 hover:bg-black text-white\'\n                  }`}\n                >\n                  \345\216\273\345\205\205\345\200\274\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Safety notes details */}\n      <div className={`mt-6 p-4 rounded-[24px] border flex items-start space-x-3.5 shadow-lg ${cardBgClass} ${cardBorder}`} id=\"store-faq\">\n        <ShieldCheck className={`w-5 h-5 shrink-0 mt-0.5 ${highlightText}`} />\n        <div className=\"text-[10px] leading-relaxed space-y-1\">\n          <p className={`font-extrabold text-xs ${textWhite}`}>PLANA \350\264\255\350\257\276\345\256\211\345\205\250\344\277\235\351\232\234\347\273\206\345\210\231</p>\n          <p className={`${textSecondary} font-medium`}>\342\200\242 7\345\244\251\351\200\200\345\214\205\344\277\235\351\232\234: \346\226\260\345\215\241\350\207\252\350\264\255\345\214\205\350\265\2677\345\244\251\345\206\205\357\274\214\350\213\245\346\234\252\350\277\233\350\241\214\344\273\273\344\275\225\345\244\247\350\257\276\351\242\204\350\256\242\346\266\210\350\257\276\357\274\214\345\235\207\345\217\257\346\227\240\345\201\277\345\220\221\345\256\242\346\234\215\347\224\263\350\257\267\347\247\222\347\272\247\351\200\200\346\254\276\346\254\276\351\241\271\343\200\202</p>\n          <p className={`${textSecondary} font-medium`}>\342\200\242 \350\207\252\345\212\250\345\206\273\347\273\223\345\273\266\346\234\237: \347\224\250\346\210\267\350\213\245\351\201\207\347\252\201\345\217\221\347\224\237\347\227\205\343\200\201\345\207\272\345\267\256\357\274\214\345\217\257\345\234\250\344\270\212\350\257\276\345\211\215\345\257\271\345\215\241\345\214\205\347\224\263\350\257\267\344\270\272\346\234\23714\345\244\251\347\232\204\344\270\264\346\227\266\345\206\273\347\273\223\357\274\214\344\277\235\350\257\201\350\257\276\346\254\241\345\244\251\346\225\260\345\273\266\346\234\237\344\270\215\350\242\253\346\211\243\350\200\227\343\200\202</p>\n        </div>\n      </div>"
