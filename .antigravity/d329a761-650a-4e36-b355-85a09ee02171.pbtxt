  file_change {
    absolute_path_uri: "file:///src/components/ProfileView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { DanceClass, PurchaseRecord } from \'../types\';\nimport { Award, Clock, History, Ban, User, Layers, ShieldCheck, Ticket, BarChart3, HelpCircle, Flame } from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\ninterface ProfileViewProps {\n  userPasses: number;\n  setUserPasses: React.Dispatch<React.SetStateAction<number>>;\n  bookedClassIds: string[];\n  setBookedClassIds: React.Dispatch<React.SetStateAction<string[]>>;\n  waitlistClassIds: string[];\n  setWaitlistClassIds: React.Dispatch<React.SetStateAction<string[]>>;\n  classes: DanceClass[];\n  setClasses: React.Dispatch<React.SetStateAction<DanceClass[]>>;\n  purchaseHistory: PurchaseRecord[];\n  addToast: (msg: string, type: \'success\' | \'info\' | \'error\') => void;\n}\n\nexport default function ProfileView({\n  userPasses,\n  setUserPasses,\n  bookedClassIds,\n  setBookedClassIds,\n  waitlistClassIds,\n  setWaitlistClassIds,\n  classes,\n  setClasses,\n  purchaseHistory,\n  addToast\n}: ProfileViewProps) {\n  // Navigation tabs for lower monitoring details: \'active\' | \'waiting\' | \'purchases\'\n  const [activeSegment, setActiveSegment] = useState<\'active\' | \'waiting\' | \'purchases\'>(\'active\');\n\n  // Active future booked class entities\n  const userBookedClasses = classes.filter((item) => bookedClassIds.includes(item.id));\n\n  // Active waitlisted class entities\n  const userWaitlistedClasses = classes.filter((item) => waitlistClassIds.includes(item.id));\n\n  // Handle Cancellation\n  const handleCancelBooking = (clsId: string, title: string) => {\n    setBookedClassIds((prev) => prev.filter((id) => id !== clsId));\n    setUserPasses((prev) => prev + 1);\n    setClasses((prev) =>\n      prev.map((c) => {\n        if (c.id === clsId) {\n          return { ...c, bookedCount: Math.max(0, c.bookedCount - 1) };\n        }\n        return c;\n      })\n    );\n    addToast(`\345\267\262\346\210\220\345\212\237\345\217\226\346\266\210 \343\200\212${title}\343\200\213 \347\232\204\345\244\247\350\257\276\351\242\204\347\272\246\357\274\2141\350\257\276\347\202\271\351\200\200\345\233\236\351\222\261\345\214\205\343\200\202`, \'info\');\n  };\n\n  // Handle Waitlist dequeue\n  const handleCancelWaitlist = (clsId: string, title: string) => {\n    setWaitlistClassIds((prev) => prev.filter((id) => id !== clsId));\n    addToast(`\345\267\262\346\210\220\345\212\237\351\200\200\345\207\272 \343\200\212${title}\343\200\213 \347\232\204\345\200\231\350\241\245\346\216\222\351\230\237\343\200\202`, \'info\');\n  };\n\n  // Styled Distribution bar helper\n  const DANCE_STREAKS = [\n    { genre: \'Jazz (\347\210\265\345\243\253\347\203\255\350\210\236\351\243\216\346\240\274)\', percent: 55, color: \'bg-gradient-to-r from-pink-500 to-rose-500\' },\n    { genre: \'Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250\346\216\222\347\273\203)\', percent: 30, color: \'bg-gradient-to-r from-indigo-500 to-indigo-600\' },\n    { genre: \'Urban Choreography\', percent: 15, color: \'bg-gradient-to-r from-violet-500 to-purple-600\' }\n  ];\n\n  return (\n    <div className=\"flex-1 overflow-y-auto px-4 pb-20 pt-4 bg-[#0c0d14]\" id=\"profile-view-container\">\n      {/* Upper header */}\n      <div className=\"flex items-center justify-between pb-3 border-b border-white/5 mb-3\">\n        <div>\n          <h2 className=\"text-sm font-black text-white uppercase tracking-wider\">\344\274\232\345\221\230\344\270\255\345\277\203</h2>\n          <p className=\"text-[8px] text-zinc-500 font-bold tracking-widest mt-1\">PLANA SPECIAL STUDENT</p>\n        </div>\n        <div className=\"w-8 h-8 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-455 text-rose-400 flex items-center justify-center shadow-sm\">\n          <User className=\"w-4 h-4\" />\n        </div>\n      </div>\n\n      {/* 1. Student Member Card Dashboard */}\n      <div className=\"mt-4 bg-[#13141f] rounded-[32px] p-5 text-white relative overflow-hidden shadow-lg border border-white/10\">\n        {/* Shiny graphics */}\n        <div className=\"absolute right-0 top-0 translate-x-8 -translate-y-8 w-32 h-32 bg-rose-500 rounded-full opacity-10 blur-2xl\"></div>\n        <div className=\"absolute left-1/3 bottom-0 w-24 h-24 bg-pink-500 rounded-full opacity-5 blur-2xl\"></div>\n\n        <div className=\"relative z-10 flex items-center space-x-4\">\n          <img\n            src=\"https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80\"\n            alt=\"User Avatar\"\n            className=\"w-13 h-13 rounded-full object-cover border-2 border-rose-500\"\n            referrerPolicy=\"no-referrer\"\n          />\n          <div>\n            <div className=\"flex items-center space-x-2 flex-wrap\">\n              <span className=\"font-extrabold text-white text-sm block\">PLANA_51421</span>\n              <span className=\"bg-rose-500/10 text-rose-400 text-[8px] font-black tracking-widest px-1.5 py-0.5 rounded border border-rose-500/20 leading-none\">LEAGUE LV.2</span>\n            </div>\n            <span className=\"text-[9px] text-zinc-550 text-zinc-500 font-mono block mt-1 tracking-tight\">\347\273\221\345\256\232\350\264\246\346\210\267: mihw001@gmail.com</span>\n          </div>\n        </div>\n\n        {/* Numeric stats row */}\n        <div className=\"grid grid-cols-3 gap-2 mt-5 pt-4 border-t border-white/5 text-center font-mono relative z-10\">\n          <div>\n            <span className=\"text-[9px] text-zinc-500 block font-bold font-sans\">\345\217\257\347\224\250\350\257\276\345\205\205\347\202\271</span>\n            <span className=\"text-base font-extrabold text-rose-400 block mt-0.5\">\n              {userPasses} \346\254\241\n            </span>\n          </div>\n          <div>\n            <span className=\"text-[9px] text-zinc-500 block font-bold font-sans\">\347\264\257\350\256\241\346\227\266\351\225\277</span>\n            <span className=\"text-base font-extrabold text-white block mt-0.5 font-sans\">\n              42 \345\260\217\346\227\266\n            </span>\n          </div>\n          <div>\n            <span className=\"text-[9px] text-zinc-500 block font-bold font-sans\">\351\246\226\351\200\211\350\210\236\345\234\210</span>\n            <span className=\"text-[10px] font-black text-rose-300 block mt-1.5 px-1 py-0.5 bg-rose-500/5 border border-rose-500/10 rounded font-sans scale-[0.95] truncate\">\n              Jazz\347\210\265\345\243\253\345\234\210\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Visual Progress Distribution bars */}\n      <div className=\"mt-4 bg-[#13141f] p-4.5 rounded-[24px] border border-white/5 shadow-lg\" id=\"progress-statistics\">\n        <h3 className=\"text-[10px] font-black text-zinc-400 uppercase tracking-widest flex items-center mb-3\">\n          <BarChart3 className=\"w-4 h-4 text-rose-500 mr-2\" />\n          \350\210\236\345\234\210\345\201\217\345\220\221\345\233\276\350\260\261 / Style Analysis\n        </h3>\n\n        <div className=\"space-y-3.5\">\n          {DANCE_STREAKS.map((style) => (\n            <div key={style.genre}>\n              <div className=\"flex justify-between text-[11px] text-zinc-400 font-sans mb-1 font-bold\">\n                <span>{style.genre}</span>\n                <span className=\"font-mono text-rose-400\">{style.percent}%</span>\n              </div>\n              <div className=\"h-2 w-full bg-zinc-950/80 border border-white/5 rounded-full overflow-hidden p-0.5\">\n                <div className={`${style.color} h-full rounded-full`} style={{ width: `${style.percent}%` }}></div>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        <div className=\"mt-4 pt-3.5 border-t border-white/5 flex items-center justify-between text-[9px] text-zinc-500 tracking-wide font-bold\" id=\"streak-meter\">\n          <span className=\"flex items-center\">\n            <Flame className=\"w-3.5 h-3.5 text-rose-455 text-rose-400 mr-1 animate-pulse\" />\n            \350\277\236\347\273\255\346\211\247\347\205\247\346\211\223\345\215\241: <strong className=\"text-rose-400 ml-1 font-black\">5 \345\244\251</strong>\n          </span>\n          <span>\350\277\221\346\234\237\345\213\213\347\253\240\347\273\217\351\252\214\347\202\271: 450 / 1000 EXP</span>\n        </div>\n      </div>\n\n      {/* 3. Class Booking Monitor segments tabbed block */}\n      <div className=\"mt-5\" id=\"booking-monitor\">\n        {/* Navigation row selectors */}\n        <div className=\"flex border-b border-white/5 font-black text-xs\">\n          <button\n            onClick={() => setActiveSegment(\'active\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'active\' ? \'text-rose-400 font-black\' : \'text-zinc-500 hover:text-white\'\n            }`}\n          >\n            <span>\345\267\262\351\200\211\350\257\276\347\250\213 ({userBookedClasses.length})</span>\n            {activeSegment === \'active\' && (\n              <span className=\"absolute bottom-[-1px] left-0 right-0 h-[2px] bg-rose-500 rounded-full\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'waiting\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'waiting\' ? \'text-rose-400 font-black\' : \'text-zinc-500 hover:text-white\'\n            }`}\n          >\n            <span>\346\216\222\351\230\237\345\200\231\350\241\245 ({userWaitlistedClasses.length})</span>\n            {activeSegment === \'waiting\' && (\n              <span className=\"absolute bottom-[-1px] left-0 right-0 h-[2px] bg-rose-500 rounded-full\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'purchases\')}\n            className={`flex-1 py-2.5 text-center transition-all relative cursor-pointer ${\n              activeSegment === \'purchases\' ? \'text-rose-400 font-black\' : \'text-zinc-500 hover:text-white\'\n            }`}\n          >\n            <span>\344\272\244\346\230\223\346\265\201\346\260\264 ({purchaseHistory.length})</span>\n            {activeSegment === \'purchases\' && (\n              <span className=\"absolute bottom-[-1px] left-0 right-0 h-[2px] bg-rose-500 rounded-full\"></span>\n            )}\n          </button>\n        </div>\n\n        {/* Display contents */}\n        <div className=\"mt-3.5 space-y-3\">\n          {activeSegment === \'active\' && (\n            userBookedClasses.length === 0 ? (\n              <div className=\"text-center bg-[#13141f] p-8 rounded-[24px] border border-white/5 flex flex-col items-center shadow-lg\">\n                <Ticket className=\"w-8 h-8 text-zinc-650 text-zinc-600 mb-2\" />\n                <p className=\"text-xs text-zinc-500 font-bold leading-normal\">\n                  \346\202\250\345\275\223\345\211\215\346\232\202\346\227\240\345\267\262\347\231\273\350\256\260\347\232\204\345\244\247\350\257\276\346\264\273\345\212\250\343\200\202\350\265\266\347\264\247\345\211\215\345\276\200\351\246\226\351\241\265\346\210\226\350\257\276\350\241\250\351\200\211\346\213\251\346\226\260\344\270\200\350\257\276\346\227\266\345\220\247\357\274\201\n                </p>\n              </div>\n            ) : (\n              userBookedClasses.map((cls) => (\n                <div key={cls.id} className=\"bg-[#13141f] border border-white/5 rounded-2xl p-4 flex justify-between items-center shadow-lg\">\n                  <div>\n                    <h4 className=\"text-xs font-black text-white leading-tight\">\n                      {cls.title}\n                    </h4>\n                    <p className=\"text-[10px] text-rose-400 font-bold font-mono mt-1.5\">\n                      {cls.date} \342\200\242 {cls.timeStart}~{cls.timeEnd}\n                    </p>\n                    <p className=\"text-[9px] text-[#8e9bb0] mt-1 font-bold\">\n                      \345\257\274\345\270\210: {cls.teacher.name} \342\200\242 {cls.classroom}\n                    </p>\n                  </div>\n\n                  <button\n                    onClick={() => handleCancelBooking(cls.id, cls.title)}\n                    className=\"px-3.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/20 text-rose-400 active:scale-95 text-[10px] font-bold rounded-full transition cursor-pointer shrink-0\"\n                  >\n                    \345\217\226\346\266\210\351\242\204\347\272\246\n                  </button>\n                </div>\n              ))\n            )\n          )}\n\n          {activeSegment === \'waiting\' && (\n            userWaitlistedClasses.length === 0 ? (\n              <div className=\"text-center bg-[#13141f] p-8 rounded-[24px] border border-white/5 flex flex-col items-center shadow-lg\">\n                <History className=\"w-8 h-8 text-zinc-650 text-zinc-600 mb-2\" />\n                <p className=\"text-xs text-zinc-500 font-bold leading-normal\">\n                  \346\202\250\345\275\223\345\211\215\345\271\266\346\262\241\346\234\211\345\244\204\344\272\216\345\220\215\351\242\235\345\267\262\346\273\241\345\200\231\350\241\245\351\230\266\346\256\265\347\232\204\345\210\206\345\206\214\351\241\271\347\233\256\343\200\202\n                </p>\n              </div>\n            ) : (\n              userWaitlistedClasses.map((cls) => (\n                <div key={cls.id} className=\"bg-[#13141f] border border-white/5 rounded-2xl p-4 flex justify-between items-center shadow-lg\">\n                  <div>\n                    <span className=\"bg-rose-500/10 border border-rose-500/20 text-rose-400 text-[8px] font-black px-2 py-0.5 rounded-full leading-none mr-1.5 inline-block mb-1.5\">\n                      \351\230\237\345\210\227\346\212\242\344\275\215\345\200\231\350\241\245\344\270\255\n                    </span>\n                    <h4 className=\"text-xs font-black text-white leading-tight\">\n                      {cls.title}\n                    </h4>\n                    <p className=\"text-[10px] text-zinc-400 font-bold font-mono mt-1\">\n                      {cls.date} \342\200\242 {cls.timeStart}~{cls.timeEnd}\n                    </p>\n                    <p className=\"text-[9px] text-zinc-500 font-bold mt-1\">\n                      \345\257\274\345\270\210: {cls.teacher.name} \342\200\242 \345\267\262\350\241\214\344\275\2771\347\202\271\345\206\273\347\273\223\351\224\201\345\256\232\346\225\260\n                    </p>\n                  </div>\n\n                  <button\n                    onClick={() => handleCancelWaitlist(cls.id, cls.title)}\n                    className=\"px-3.5 py-1.5 bg-white/5 hover:bg-white/10 border border-white/5 text-zinc-300 active:scale-95 text-[10px] font-bold rounded-full transition cursor-pointer shrink-0\"\n                  >\n                    \345\217\226\346\266\210\345\200\231\350\241\245\n                  </button>\n                </div>\n              ))\n            )\n          )}\n\n          {activeSegment === \'purchases\' && (\n            purchaseHistory.length === 0 ? (\n              <div className=\"text-center bg-[#13141f] p-8 rounded-[24px] border border-white/5 flex flex-col items-center shadow-lg\">\n                <History className=\"w-8 h-8 text-zinc-650 text-zinc-600 mb-2\" />\n                <p className=\"text-xs text-zinc-500 font-bold leading-normal\">\n                  \346\202\250\346\234\200\350\277\221\345\271\266\346\227\240\345\215\241\345\214\205\350\264\255\344\271\260\344\272\244\346\230\223\350\256\260\345\275\225\357\274\214\351\246\226\347\254\224\345\205\205\345\200\274\345\214\205\344\272\253\346\234\211\346\226\260\346\211\213\347\253\213\345\207\217\343\200\202\n                </p>\n              </div>\n            ) : (\n              purchaseHistory.map((rec) => (\n                <div key={rec.id} className=\"bg-[#13141f] border border-white/5 rounded-2xl p-4 flex justify-between items-center font-mono shadow-lg\">\n                  <div>\n                    <h4 className=\"text-xs font-black text-white leading-tight font-sans\">\n                      {rec.cardName}\n                    </h4>\n                    <p className=\"text-[9px] text-zinc-500 mt-1.5 leading-none font-bold\">\n                      \350\264\255\344\271\260\345\256\214\346\210\220: {rec.date} \342\200\242 \346\265\201\346\260\264\347\274\226\345\217\267: {rec.id}\n                    </p>\n                  </div>\n\n                  <div className=\"text-right shrink-0\">\n                    <span className=\"text-xs font-black text-rose-400 block\">\n                      + {rec.passesAdded === -1 ? \'\346\227\240\351\231\220\351\200\232\347\202\271\' : `${rec.passesAdded} \346\254\241`}\n                    </span>\n                    <span className=\"text-[9px] text-zinc-500 block mt-1\">\n                      \344\273\230\346\254\276 \302\245{rec.price}\n                    </span>\n                  </div>\n                </div>\n              ))\n            )\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
