      replacement_content: "import React, { useState } from \'react\';\nimport { DanceClass, PurchaseRecord } from \'../types\';\nimport { Award, Clock, History, Ban, User, Layers, ShieldCheck, Ticket, BarChart3, HelpCircle, Flame } from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\ninterface ProfileViewProps {\n  userPasses: number;\n  setUserPasses: React.Dispatch<React.SetStateAction<number>>;\n  bookedClassIds: string[];\n  setBookedClassIds: React.Dispatch<React.SetStateAction<string[]>>;\n  waitlistClassIds: string[];\n  setWaitlistClassIds: React.Dispatch<React.SetStateAction<string[]>>;\n  classes: DanceClass[];\n  setClasses: React.Dispatch<React.SetStateAction<DanceClass[]>>;\n  purchaseHistory: PurchaseRecord[];\n  addToast: (msg: string, type: \'success\' | \'info\' | \'error\') => void;\n}\n\nexport default function ProfileView({\n  userPasses,\n  setUserPasses,\n  bookedClassIds,\n  setBookedClassIds,\n  waitlistClassIds,\n  setWaitlistClassIds,\n  classes,\n  setClasses,\n  purchaseHistory,\n  addToast\n}: ProfileViewProps) {\n  // Navigation tabs for lower monitoring details: \'active\' | \'waiting\' | \'purchases\'\n  const [activeSegment, setActiveSegment] = useState<\'active\' | \'waiting\' | \'purchases\'>(\'active\');\n\n  // Active future booked class entities\n  const userBookedClasses = classes.filter((item) => bookedClassIds.includes(item.id));\n\n  // Active waitlisted class entities\n  const userWaitlistedClasses = classes.filter((item) => waitlistClassIds.includes(item.id));\n\n  // Handle Cancellation\n  const handleCancelBooking = (clsId: string, title: string) => {\n    setBookedClassIds((prev) => prev.filter((id) => id !== clsId));\n    setUserPasses((prev) => prev + 1);\n    setClasses((prev) =>\n      prev.map((c) => {\n        if (c.id === clsId) {\n          return { ...c, bookedCount: Math.max(0, c.bookedCount - 1) };\n        }\n        return c;\n      })\n    );\n    addToast(`\345\267\262\346\210\220\345\212\237\345\217\226\346\266\210 \343\200\212${title}\343\200\213 \347\232\204\345\244\247\350\257\276\351\242\204\347\272\246\357\274\2141\350\257\276\347\202\271\351\200\200\345\233\236\351\222\261\345\214\205\343\200\202`, \'info\');\n  };\n\n  // Handle Waitlist dequeue\n  const handleCancelWaitlist = (clsId: string, title: string) => {\n    setWaitlistClassIds((prev) => prev.filter((id) => id !== clsId));\n    addToast(`\345\267\262\346\210\220\345\212\237\351\200\200\345\207\272 \343\200\212${title}\343\200\213 \347\232\204\345\200\231\350\241\245\346\216\222\351\230\237\343\200\202`, \'info\');\n  };\n\n  // Styled Distribution bar helper\n  const DANCE_STREAKS = [\n    { genre: \'Jazz (\347\210\265\345\243\253\351\243\216\346\240\274)\', percent: 55, color: \'bg-fuchsia-500\' },\n    { genre: \'Hiphop (\350\241\227\350\210\236\345\276\213\345\212\250)\', percent: 30, color: \'bg-sky-500\' },\n    { genre: \'Urban Choreography\', percent: 15, color: \'bg-orange-500\' }\n  ];\n\n  return (\n    <div className=\"flex-1 overflow-y-auto px-4 pb-20 pt-2 bg-slate-50\" id=\"profile-view-container\">\n      {/* Upper header */}\n      <div className=\"flex items-center justify-between py-1 border-b border-slate-100\">\n        <div>\n          <h2 className=\"text-xl font-extrabold text-slate-800 tracking-tight\">\344\274\232\345\221\230\344\270\255\345\277\203</h2>\n          <p className=\"text-[10px] text-slate-400 font-mono\">PLANA SPECIAL STUDENT</p>\n        </div>\n        <div className=\"w-8 h-8 rounded-full bg-teal-500 flex items-center justify-center text-white\">\n          <User className=\"w-4.5 h-4.5\" />\n        </div>\n      </div>\n\n      {/* 1. Student Member Card Dashboard */}\n      <div className=\"mt-4 bg-slate-900 rounded-3xl p-5 text-white relative overflow-hidden shadow-lg shadow-slate-900/10\">\n        {/* Shiny graphics */}\n        <div className=\"absolute right-0 top-0 translate-x-8 -translate-y-8 w-32 h-32 bg-teal-500 rounded-full opacity-20 blur-xl\"></div>\n        <div className=\"absolute left-1/3 bottom-0 w-24 h-24 bg-cyan-500 rounded-full opacity-10 blur-xl\"></div>\n\n        <div className=\"relative z-10 flex items-center space-x-4\">\n          <img\n            src=\"https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80\"\n            alt=\"User Avatar\"\n            className=\"w-14 h-14 rounded-full object-cover border-2 border-teal-400\"\n            referrerPolicy=\"referrer\"\n          />\n          <div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"font-extrabold text-base tracking-tight text-white block\">PLANA_51421</span>\n              <span className=\"bg-teal-500 text-[8px] font-bold tracking-wider px-1.5 py-0.5 rounded-sm\">LEAGUE LV.2</span>\n            </div>\n            <span className=\"text-[10px] text-slate-400 font-mono block\">\347\273\221\345\256\232\350\264\246\346\210\267: mihw001@gmail.com</span>\n          </div>\n        </div>\n\n        {/* Numeric stats row */}\n        <div className=\"grid grid-cols-3 gap-2.5 mt-5 pt-4 border-t border-white/10 text-center font-mono relative z-10\">\n          <div>\n            <span className=\"text-[9px] text-slate-400 block font-sans\">\350\264\246\346\210\267\345\211\251\344\275\231\350\257\276\346\254\241</span>\n            <span className=\"text-base font-extrabold text-teal-400 block mt-0.5\">\n              {userPasses}\346\254\241\n            </span>\n          </div>\n          <div>\n            <span className=\"text-[9px] text-slate-400 block font-sans\">\347\264\257\350\256\241\344\270\212\350\257\276\346\227\266\351\225\277</span>\n            <span className=\"text-base font-extrabold text-slate-100 block mt-0.5\">\n              42 \345\260\217\346\227\266\n            </span>\n          </div>\n          <div>\n            <span className=\"text-[9px] text-slate-400 block font-sans\">\351\246\226\351\200\211\347\203\255\346\210\230\350\210\236\347\247\215</span>\n            <span className=\"text-xs font-bold text-slate-100 block mt-1.5 font-sans\">\n              Jazz (\347\262\276\350\277\233)\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Visual Progress Distribution bars */}\n      <div className=\"mt-4 bg-white p-4 rounded-2xl border border-slate-100\" id=\"progress-statistics\">\n        <h3 className=\"text-xs font-extrabold text-slate-400 uppercase tracking-widest flex items-center mb-3\">\n          <BarChart3 className=\"w-3.5 h-3.5 text-teal-500 mr-1.5\" />\n          \350\210\236\347\247\215\345\255\246\344\271\240\345\221\250\346\234\237\345\215\240\346\257\224 / Style Analysis\n        </h3>\n\n        <div className=\"space-y-2.5\">\n          {DANCE_STREAKS.map((style) => (\n            <div key={style.genre}>\n              <div className=\"flex justify-between text-[11px] text-slate-500 font-sans mb-1.5\">\n                <span className=\"font-medium text-slate-700\">{style.genre}</span>\n                <span className=\"font-mono font-bold text-teal-600\">{style.percent}%</span>\n              </div>\n              <div className=\"h-1.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n                <div className={`${style.color} h-full rounded-full`} style={{ width: `${style.percent}%` }}></div>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        <div className=\"mt-4 pt-3 border-t border-slate-50 flex items-center justify-between text-[10px] text-slate-400 leading-normal\" id=\"streak-meter\">\n          <span className=\"flex items-center\">\n            <Flame className=\"w-3.5 h-3.5 text-rose-500 fill-rose-400 mr-1 animate-pulse\" />\n            \350\277\236\347\273\255\350\267\237\350\257\273\350\256\255\347\273\203: <strong className=\"text-slate-700 ml-0.5\">5 \345\244\251</strong>\n          </span>\n          <span>\347\255\211\347\272\247\347\273\217\351\252\214: 450 / 1000 EXP</span>\n        </div>\n      </div>\n\n      {/* 3. Class Booking Monitor segments tabbed block */}\n      <div className=\"mt-5\" id=\"booking-monitor\">\n        {/* Navigation row selectors */}\n        <div className=\"flex border-b border-slate-200\">\n          <button\n            onClick={() => setActiveSegment(\'active\')}\n            className={`flex-1 py-2.5 text-center text-xs font-bold transition-all relative ${\n              activeSegment === \'active\' ? \'text-teal-600\' : \'text-slate-500 hover:text-slate-700\'\n            }`}\n          >\n            <span>\345\267\262\351\242\204\347\272\246\345\244\247\350\257\276 ({userBookedClasses.length})</span>\n            {activeSegment === \'active\' && (\n              <span className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-teal-500\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'waiting\')}\n            className={`flex-1 py-2.5 text-center text-xs font-bold transition-all relative ${\n              activeSegment === \'waiting\' ? \'text-teal-600\' : \'text-slate-500 hover:text-slate-700\'\n            }`}\n          >\n            <span>\345\200\231\350\241\245\346\216\222\351\230\237\344\270\255 ({userWaitlistedClasses.length})</span>\n            {activeSegment === \'waiting\' && (\n              <span className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-teal-500\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveSegment(\'purchases\')}\n            className={`flex-1 py-2.5 text-center text-xs font-bold transition-all relative ${\n              activeSegment === \'purchases\' ? \'text-teal-600\' : \'text-slate-500 hover:text-slate-700\'\n            }`}\n          >\n            <span>\345\205\205\345\200\274\346\230\216\347\273\206 ({purchaseHistory.length})</span>\n            {activeSegment === \'purchases\' && (\n              <span className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-teal-500\"></span>\n            )}\n          </button>\n        </div>\n\n        {/* Display contents */}\n        <div className=\"mt-3.5 space-y-3\">\n          {activeSegment === \'active\' && (\n            userBookedClasses.length === 0 ? (\n              <div className=\"text-center bg-white p-8 rounded-2xl border border-slate-100 flex flex-col items-center\">\n                <Ticket className=\"w-8 h-8 text-slate-300 mb-2\" />\n                <p className=\"text-xs text-slate-500\">\n                  \345\275\223\345\211\215\346\232\202\346\227\240\345\267\262\351\242\204\347\272\246\347\232\204\345\244\247\350\257\276\343\200\202\350\265\266\347\264\247\345\216\273\351\242\204\347\272\246\344\270\200\350\212\202\345\244\247\350\257\276\345\212\250\350\265\267\346\235\245\345\220\247\357\274\201\n                </p>\n              </div>\n            ) : (\n              userBookedClasses.map((cls) => (\n                <div key={cls.id} className=\"bg-white border border-slate-100 rounded-xl p-3 flex justify-between items-center\">\n                  <div>\n                    <h4 className=\"text-xs font-extrabold text-slate-800 leading-tight\">\n                      {cls.title}\n                    </h4>\n                    <p className=\"text-[10px] text-teal-600 font-semibold font-mono mt-0.5\">\n                      {cls.date} \342\200\242 {cls.timeStart}~{cls.timeEnd}\n                    </p>\n                    <p className=\"text-[9px] text-slate-400 mt-0.5 font-sans leading-none\">\n                      \345\257\274\345\270\210: {cls.teacher.name} \342\200\242 {cls.classroom}\n                    </p>\n                  </div>\n\n                  <button\n                    onClick={() => handleCancelBooking(cls.id, cls.title)}\n                    className=\"px-3 py-1.5 bg-rose-550/10 text-rose-600 hover:bg-rose-550/20 active:scale-95 text-[10px] font-bold rounded-lg transition\"\n                  >\n                    \345\217\226\346\266\210\351\242\204\347\272\246\n                  </button>\n                </div>\n              ))\n            )\n          )}\n\n          {activeSegment === \'waiting\' && (\n            userWaitlistedClasses.length === 0 ? (\n              <div className=\"text-center bg-white p-8 rounded-2xl border border-slate-100 flex flex-col items-center\">\n                <History className=\"w-8 h-8 text-slate-300 mb-2\" />\n                <p className=\"text-xs text-slate-500\">\n                  \345\275\223\345\211\215\346\232\202\346\227\240\346\255\243\345\234\250\345\200\231\350\241\245\346\216\222\351\230\237\347\232\204\345\244\247\350\257\276\343\200\202\n                </p>\n              </div>\n            ) : (\n              userWaitlistedClasses.map((cls) => (\n                <div key={cls.id} className=\"bg-white border border-slate-100 rounded-xl p-3 flex justify-between items-center\">\n                  <div>\n                    <span className=\"bg-amber-50 text-amber-600 border border-amber-100 text-[8px] font-bold px-1.5 py-0.5 rounded leading-none mr-1.5 inline-block mb-1 font-mono\">\n                      \345\200\231\350\241\245\346\216\222\351\230\237\344\270\255\n                    </span>\n                    <h4 className=\"text-xs font-extrabold text-slate-800 leading-tight\">\n                      {cls.title}\n                    </h4>\n                    <p className=\"text-[10px] text-slate-400 font-mono mt-0.5\">\n                      {cls.date} \342\200\242 {cls.timeStart}~{cls.timeEnd}\n                    </p>\n                    <p className=\"text-[9px] text-slate-400 mt-0.5\">\n                      \345\257\274\345\270\210: {cls.teacher.name} \342\200\242 \345\267\262\345\206\273\347\273\2231\346\254\241\345\215\241\n                    </p>\n                  </div>\n\n                  <button\n                    onClick={() => handleCancelWaitlist(cls.id, cls.title)}\n                    className=\"px-3 py-1.5 bg-slate-200 text-slate-700 hover:bg-slate-300 active:scale-95 text-[10px] font-bold rounded-lg transition\"\n                  >\n                    \345\217\226\346\266\210\345\200\231\350\241\245\n                  </button>\n                </div>\n              ))\n            )\n          )}\n\n          {activeSegment === \'purchases\' && (\n            purchaseHistory.length === 0 ? (\n              <div className=\"text-center bg-white p-8 rounded-2xl border border-slate-100 flex flex-col items-center\">\n                <History className=\"w-8 h-8 text-slate-300 mb-2\" />\n                <p className=\"text-xs text-slate-500\">\n                  \346\232\202\346\227\240\345\205\205\345\200\274\350\256\260\345\275\225\357\274\214\345\217\257\345\234\250\350\264\255\345\214\205\345\205\205\346\254\241\351\241\265\351\235\242\351\200\211\345\217\226\344\275\223\351\252\214\345\214\205\350\264\255\345\205\245\357\274\201\n                </p>\n              </div>\n            ) : (\n              purchaseHistory.map((rec) => (\n                <div key={rec.id} className=\"bg-white border border-slate-100 rounded-xl p-3 flex justify-between items-center font-mono\">\n                  <div>\n                    <h4 className=\"text-xs font-bold text-slate-800 leading-tight\">\n                      {rec.cardName}\n                    </h4>\n                    <p className=\"text-[9px] text-slate-400 mt-0.5 leading-none\">\n                      \344\272\244\346\230\223\346\227\266\351\227\264: {rec.date} \342\200\242 \344\272\244\346\230\223\345\215\225ID: {rec.id}\n                    </p>\n                  </div>\n\n                  <div className=\"text-right shrink-0\">\n                    <span className=\"text-xs font-extrabold text-teal-600 block\">\n                      + {rec.passesAdded === -1 ? \'\346\227\240\351\231\220\' : rec.passesAdded} \346\254\241\n                    </span>\n                    <span className=\"text-[9px] text-slate-400 block mt-0.5\">\n                      \347\273\223\344\273\230 \302\245{rec.price}\n                    </span>\n                  </div>\n                </div>\n              ))\n            )\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
